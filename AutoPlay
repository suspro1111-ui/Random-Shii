----------------------------------------------------------------------
-- RUN LENGTH TIME FORMATTER & RUN SECONDS CALCULATOR
----------------------------------------------------------------------
local function getRunTime(): string
    local ok, text = pcall(function()
        local lbl = DungeonGui:FindFirstChild("TotalTimeCountLabel")
        return lbl and lbl.Text
    end)
    if ok and type(text) == "string" and text ~= "" then
        local match = text:match("(%d+:%d+:%d+)") or text:match("(%d+:%d+)")
        if match then return match end
    end
    return os.date("%H:%M:%S")
end

local function getRunTimeInSeconds(): number
    local ok, text = pcall(function()
        local lbl = DungeonGui:FindFirstChild("TotalTimeCountLabel")
        return lbl and lbl.Text
    end)
    if ok and type(text) == "string" and text ~= "" then
        local h, m, s = text:match("(%d+):(%d+):(%d+)")
        if h and m and s then
            return tonumber(h) * 3600 + tonumber(m) * 60 + tonumber(s)
        end
        local m2, s2 = text:match("(%d+):(%d+)")
        if m2 and s2 then
            return tonumber(m2) * 60 + tonumber(s2)
        end
    end
    return 0
end

