        ConsoleFrame.Visible = visible
        setDotState(ConsoleDot, visible and Config.THEME.Accent or Config.THEME.SubMuted, visible)
        ConsoleLbl.TextColor3 = visible and Config.THEME.Text or Config.THEME.Muted
        Acrylic.SetEnabled(visible or ToolBar.Visible)
    end

    CloseBtn.MouseButton1Click:Connect(function() setConsoleVisibility(false) end)
    ConsoleToggleBtn.MouseButton1Click:Connect(function() setConsoleVisibility(not ConsoleFrame.Visible) end)

    local function updateCombatButton()
        if State.CombatMode == 1 then
            setDotState(ModeDot, Config.THEME.Good, true)
            ModeLbl.Text = "Combat: SAFE"
        elseif State.CombatMode == 2 then
            setDotState(ModeDot, Config.THEME.Warn, true)
            ModeLbl.Text = "Combat: AGGRO"
        else
            setDotState(ModeDot, Config.THEME.Bad, false)
            ModeLbl.Text = "Combat: OFF"
        end
    end

    ModeBtn.MouseButton1Click:Connect(function()
        if not State.IsBotRunning then
            State.IsBotRunning = true
            State.CombatMode = 1
            updateCombatButton()
            UI.Log("MODE", "SAFE MODE active (Stochastic clash analysis active).", "#2ECC71")
        elseif State.CombatMode == 1 then
            State.CombatMode = 2
            updateCombatButton()
            UI.Log("MODE", "AGGRESSIVE active (Focus Fire active).", "#F19A26")
        else
            State.IsBotRunning = false
            State.CombatMode = 0
            updateCombatButton()
            UI.Log("MODE", "Auto-combat paused.", "#EB4D4B")
        end
    end)

    local function updateNodeButton()
        setDotState(NodeDot, State.IsAutoNodeRunning and Config.THEME.Good or Config.THEME.SubMuted, State.IsAutoNodeRunning)
        NodeLbl.Text = State.IsAutoNodeRunning and "Auto-Node: ON" or "Auto-Node: OFF"
    end

    NodeBtn.MouseButton1Click:Connect(function()
        State.IsAutoNodeRunning = not State.IsAutoNodeRunning
        updateNodeButton()
        UI.Log("MAP", "Auto-Node Embark " .. (State.IsAutoNodeRunning and "ENABLED." or "DISABLED."),
            State.IsAutoNodeRunning and "#2ECC71" or "#EB4D4B")
    end)

    updateCombatButton()
    updateNodeButton()
    updateCounterBadge()
    setConsoleVisibility(Config.UI_LAYOUT.ConsoleVisibleOnStart)

    UI.Log("INIT", "Auto-Play v1.7 Loaded.", "#8A5CFF")
end

