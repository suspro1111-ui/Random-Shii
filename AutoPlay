-- [Worker 1: Combat Execution Loop]
task.spawn(function()
    while true do
        task.wait(0.15)
        if State.IsBotRunning and State.CombatMode > 0 and not Utils.isPlayerDead() then
            local ok, err = pcall(Combat.processTurn)
            if not ok then
                UI.Log("ERROR", tostring(err), "#EB4D4B")
                task.wait(1)
            end
        end
    end
end)

-- [Worker 2: Dungeon Navigation, Rewards, Events, Rest, Boss & Retry Loop]
task.spawn(function()
    while true do
        task.wait(Config.ADVANCED.NodeScanInterval)

        local okRetry, resRetry = pcall(Dungeon.handleAutoRetry)
        if not (okRetry and resRetry) then
            local okBoss, resBoss = pcall(Dungeon.handleAutoBossVote)
            if not (okBoss and resBoss) then
                if State.IsAutoNodeRunning and Config.AUTO_NODE and not Utils.isPlayerDead() then
                    local inCombat = Combat.isInActiveCombat()
                    local inTransition = Refs.TransitionGui and Refs.TransitionGui.Enabled

                    if not inCombat and not inTransition then
                        local handled = false

                        local okRew, resRew = pcall(Dungeon.handleRewards)
                        if okRew and resRew then handled = true end

                        if not handled then
                            local okEv, resEv = pcall(Dungeon.processAutoEvent)
                            if okEv and resEv then handled = true end
                        end

                        if not handled then
                            local okRest, resRest = pcall(Dungeon.handleRestSite)
                            if okRest and resRest then handled = true end
                        end

                        if not handled then
                            pcall(function()
                                local target = Dungeon.AutoNodeThink()
                                if not target then return end
                                if Config.BOSS_MANUAL_REQUIRED and target.Type == "Boss" then
                                    if target.Name ~= State.LastDecisionKey or os.clock() - State.LastDecisionLogAt > 5 then
                                        State.LastDecisionKey, State.LastDecisionLogAt = target.Name, os.clock()
                                        UI.Log("PATH", "Boss row reached — manual embark required.", "#FFD54F")
                                    end
                                    return
                                end
                                Dungeon.embarkToNode(target)
                            end)
                        end
                    end
                end
            end
        end
    end
end)

-- [Worker 3: Run Timeout & Inactivity Watchdog Loop]
task.spawn(function()
    while true do
        task.wait(1.0)
        if State.IsBotRunning and not Utils.isPlayerDead() then
            local now = os.clock()
            local runSeconds = Utils.getRunTimeInSeconds()

            if Config.RUN_TIMEOUT > 0 and runSeconds >= Config.RUN_TIMEOUT then
                UI.Log("TIMEOUT", string.format("Run duration (%d s) exceeded limit (%d s). Resetting player...", runSeconds, Config.RUN_TIMEOUT), "#EB4D4B")
                Utils.forcePlayerReset()
                task.wait(3.0)
            elseif Config.INACTIVITY_TIMEOUT > 0 and (now - State.LastLogAt >= Config.INACTIVITY_TIMEOUT) then
                local inLoading = (Refs.LocalPlayer.PlayerGui:FindFirstChild("LoadingGui") and Refs.LocalPlayer.PlayerGui.LoadingGui.Enabled)
                if not inLoading then
                    UI.Log("TIMEOUT", string.format("Inactivity detected (%d s without logs). Resetting player...", math.floor(now - State.LastLogAt)), "#EB4D4B")
                    Utils.forcePlayerReset()
                    task.wait(3.0)
                end
            end
        end
    end
end)
