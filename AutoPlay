local okNodeInfo, NodeInfoMod = pcall(function()
    return require(Services.ReplicatedStorage.ClientModules:WaitForChild("NodeInfo", 5))
end)
local NodeInfo = (okNodeInfo and type(NodeInfoMod) == "table") and NodeInfoMod or {}

local ACTIVE_COLOR   = (NodeInfo.BackgroundColors and NodeInfo.BackgroundColors.Active)   or Color3.fromRGB(200, 200, 150)
local INACTIVE_COLOR = (NodeInfo.BackgroundColors and NodeInfo.BackgroundColors.Inactive) or Color3.fromRGB(50, 50, 50)

local IMAGE_TO_TYPE = {}
if type(NodeInfo.Images) == "table" then
    for nodeType, img in pairs(NodeInfo.Images) do IMAGE_TO_TYPE[img] = nodeType end
end

local function laneOf(name)
    local n = tostring(name):lower()
    if n:find("upper", 1, true)  then return "Upper"  end
    if n:find("lower", 1, true)  then return "Lower"  end
    if n:find("center", 1, true) then return "Center" end
    return "Any"
end

function Dungeon.registerNode(name, data)
    data = data or {}
    local frame = Refs.DungeonNodeContainer:FindFirstChild(name)
    local nodeType = data.NodeType
    if type(nodeType) ~= "string" then
        local img = frame and frame:FindFirstChild("NodeImage")
        nodeType = (img and IMAGE_TO_TYPE[img.Image]) or nil
    end

    if not nodeType then
        if name == "Boss" or name:find("Boss") then nodeType = "Boss"
        elseif name:find("Rest") then nodeType = "Rest"
        elseif name == "Start" or name:find("Start") then nodeType = "EasyBattle"
        elseif name:find("Lower") or name:find("Upper") or name:find("Center") then nodeType = "Battle"
        else nodeType = "Event" end
    end

    local pos = data.Position
    local row = Utils.toNumber(data.RowToUnlock) or (frame and Utils.toNumber(frame:GetAttribute("Furthest"))) or 0

    State.NodeGraph[name] = {
        Name   = name,
        Raw    = data,
        Type   = nodeType or "Event",
        Row    = row,
        Parent = (type(data.LockedBy) == "string") and data.LockedBy or nil,
        X      = (typeof(pos) == "UDim2") and pos.X.Scale or 0,
        Y      = (typeof(pos) == "UDim2") and pos.Y.Scale or 0.5,
        Lane   = laneOf(name),
        Frame  = frame,
    }
end

do
    local drawInfo = Refs.Events:FindFirstChild("DrawNodeInfo")
    if drawInfo then
        drawInfo.OnClientEvent:Connect(function(map)
            if type(map) ~= "table" then return end
            if map["Start"] ~= nil then State.NodeGraph, State.FinishedNodes, State.FurthestRow = {}, {}, 0 end
            for name, data in pairs(map) do if type(data) == "table" then Dungeon.registerNode(name, data) end end
        end)
    end
    local dist = Refs.Events:FindFirstChild("NodeDistIncrease")
    if dist then
        dist.OnClientEvent:Connect(function(furthest, finishedName)
            State.FurthestRow = Utils.toNumber(furthest) or State.FurthestRow
            if type(finishedName) == "string" and finishedName ~= "" then State.FinishedNodes[finishedName] = true end
        end)
    end
    local firstDraw = Refs.Events:FindFirstChild("DrawNodesForFirstTime")
    if firstDraw then
        firstDraw.OnClientEvent:Connect(function(map, furthest)
            State.FurthestRow = Utils.toNumber(furthest) or State.FurthestRow
            if type(map) ~= "table" then return end
            for name, data in pairs(map) do
                if type(data) == "table" then
                    Dungeon.registerNode(name, data)
                    if data.HasBeenFinished then State.FinishedNodes[name] = true end
                end
            end
        end)
    end
end

local function colorMatch(a, b)
    local tol = 18 / 255
    return math.abs(a.R - b.R) <= tol and math.abs(a.G - b.G) <= tol and math.abs(a.B - b.B) <= tol
end

function Dungeon.isNodeSelectable(rec)
    if not rec then return false end
    local name = rec.Name
    if State.FinishedNodes[name] then return false end
    if Config.ADVANCED.NodeAvoidUsed and Refs.PlayerStats.DungeonNodes and Refs.PlayerStats.DungeonNodes[name] then
        State.FinishedNodes[name] = true
        return false
    end

    local curRow = State.FurthestRow
    if Utils.toNumber(Refs.PlayerStats.FurthestNodeRow) then
        curRow = math.max(curRow, Utils.toNumber(Refs.PlayerStats.FurthestNodeRow))
    end
    if Config.ADVANCED.NodeStrictRowLock and curRow > 0 then
        if rec.Row ~= curRow then return false end
    elseif curRow > 0 and rec.Row > curRow then
        return false
    end

    if rec.Parent and Refs.PlayerStats.DungeonNodes and Refs.PlayerStats.DungeonNodes[rec.Parent] then return false end

    local frame = rec.Frame or Refs.DungeonNodeContainer:FindFirstChild(name)
    if not (frame and frame.Parent and frame.Visible) then return false end

    local bg = frame:FindFirstChild("bg")
    if bg and bg:IsA("GuiObject") then
        local col = bg.BackgroundColor3
        if colorMatch(col, INACTIVE_COLOR) or (col.R < 0.35 and col.G < 0.35 and col.B < 0.35) then return false end
        if not (colorMatch(col, ACTIVE_COLOR) or (col.R > 0.5 and col.G > 0.5)) then return false end
    end

    if Refs.TransitionGui and Refs.TransitionGui.Enabled then return false end
    if Refs.DialogueContainer and Refs.DialogueContainer.Visible then return false end
    local restC = Refs.DungeonGui:FindFirstChild("RestContainer") or Refs.DungeonGui:FindFirstChild("RestFrame")
    if restC and restC.Visible then return false end
    local rewF = Refs.DungeonGui:FindFirstChild("RewardFrame")
    if rewF and rewF.Visible then return false end
    local bossF = Refs.DungeonGui:FindFirstChild("PickBossFrame")
    if bossF and bossF.Visible then return false end

    return true
end

local ChildrenOf, simMemo = {}, {}
local EMPTY_FUTURE = { pos = 0, neg = 0, valuable = 0, raw = 0, via = nil }

function Dungeon.bestFutureFrom(name, depth)
    depth = depth or Config.ADVANCED.SmartSynergy.MAX_DEPTH
    local key = name .. "@" .. depth
    local memo = simMemo[key]
    if memo then return memo end

    local best = { pos = 0, neg = 0, valuable = 0, raw = 0, via = nil }
    simMemo[key] = best

    local kids = ChildrenOf[name]
    if kids then
        for _, kid in ipairs(kids) do
            local w = Config.ADVANCED.SmartPathWeights[kid.Type] or 0
            local pos, neg, val = 0, 0, 0
            if w >= 0 then
                pos = w
                if w >= Config.ADVANCED.SmartSynergy.VALUABLE_MIN then val = 1 end
            else
                neg = w
            end
            local sub = (depth > 1) and Dungeon.bestFutureFrom(kid.Name, depth - 1) or EMPTY_FUTURE
            local entry = {
                pos = pos + sub.pos,
                neg = neg + sub.neg,
                valuable = val + sub.valuable,
                via = kid.Name,
                raw = pos + sub.pos + neg + sub.neg,
            }
            if best.via == nil or entry.raw > best.raw or (entry.raw == best.raw and entry.valuable > best.valuable) then
                best = entry
                simMemo[key] = best
            end
        end
    end
    return best
end

function Dungeon.AutoNodeThink()
    if Utils.isPlayerDead() then return nil end

    for _, frame in ipairs(Refs.DungeonNodeContainer:GetChildren()) do
        if frame:IsA("Frame") and frame.Name ~= "Fog" and (frame:FindFirstChild("Confirm") or frame:FindFirstChild("NodeImage")) then
            local rec = State.NodeGraph[frame.Name]
            if rec then
                rec.Frame = frame
                if rec.Row == 0 then
                    rec.Row = Utils.toNumber(frame:GetAttribute("Furthest")) or rec.Row
                end
            else
                Dungeon.registerNode(frame.Name, {})
            end
        end
    end

    ChildrenOf, simMemo = {}, {}

    local function addChild(parentName, childRec)
        ChildrenOf[parentName] = ChildrenOf[parentName] or {}
        for _, existing in ipairs(ChildrenOf[parentName]) do
            if existing.Name == childRec.Name then return end
        end
        table.insert(ChildrenOf[parentName], childRec)
    end

    local parentless = {}
    for _, rec in pairs(State.NodeGraph) do
        if not State.FinishedNodes[rec.Name] then
            if rec.Parent and State.NodeGraph[rec.Parent] and not State.FinishedNodes[rec.Parent] then
                addChild(rec.Parent, rec)
            else
                table.insert(parentless, rec)
            end
        end
    end

    for _, rec in pairs(State.NodeGraph) do
        if not State.FinishedNodes[rec.Name] and (rec.Lane == "Center" or rec.Name:find("Center", 1, true)) then
            for _, nextNode in pairs(State.NodeGraph) do
                if not State.FinishedNodes[nextNode.Name] and nextNode.Row == rec.Row + 1 then
                    addChild(rec.Name, nextNode)
                end
            end
        end
    end

    for _, rec in ipairs(parentless) do
        local best, bestDist = nil, math.huge
        for _, other in pairs(State.NodeGraph) do
            if other ~= rec and other.Row == rec.Row - 1 and not State.FinishedNodes[other.Name] then
                local d = math.abs(other.X - rec.X) + math.abs(other.Y - rec.Y)
                if d < bestDist then
                    best, bestDist = other, d
                end
            end
        end
        if best then
            addChild(best.Name, rec)
        end
    end

    local candidates = {}
    for _, rec in pairs(State.NodeGraph) do
        if Dungeon.isNodeSelectable(rec) then
            table.insert(candidates, rec)
        end
    end
    if State.FurthestRow <= 0 and #candidates > 0 then
        local minRow = math.huge
        for _, r in ipairs(candidates) do
            minRow = math.min(minRow, r.Row)
        end
        for i = #candidates, 1, -1 do
            if candidates[i].Row > minRow then
                table.remove(candidates, i)
            end
        end
    end
    table.sort(candidates, function(a, b) return a.Name < b.Name end)

    if #candidates == 0 then return nil end
    if #candidates == 1 then return candidates[1] end

    local hp = Utils.toNumber(Refs.PlayerStats.Health) or 100
    local maxHp = Utils.toNumber(Refs.PlayerStats.MaxHealth) or hp
    local isEmergencyHp = Utils.isBelowThreshold(hp, maxHp, Config.EMERGENCY_REST_HP)

    local scored = {}
    for _, rec in ipairs(candidates) do
        local sim = Dungeon.bestFutureFrom(rec.Name, Config.ADVANCED.SmartSynergy.MAX_DEPTH)
        local factor = (sim.valuable >= Config.ADVANCED.SmartSynergy.FULL_SUPPORT and 1.0)
            or (sim.valuable == 1 and Config.ADVANCED.SmartSynergy.LONE_SUPPORT) or 0.0
        local imm = Config.ADVANCED.NodePriorities[rec.Type] or Config.ADVANCED.SmartSynergy.UNKNOWN_TYPE
        if rec.Type == "Rest" and isEmergencyHp then
            imm = imm + 600
        elseif rec.Type == "Elite" and isEmergencyHp then
            imm = imm - 200
        end

        local future = (sim.pos * factor) + sim.neg
        table.insert(scored, { rec = rec, sim = sim, factor = factor, imm = imm, future = future, total = imm + future })
    end

    table.sort(scored, function(a, b)
        if math.abs(a.total - b.total) > 0.01 then return a.total > b.total end
        if a.imm ~= b.imm then return a.imm > b.imm end
        return a.rec.Name < b.rec.Name
    end)

    local winner = scored[1]
    local now = os.clock()
    if winner.rec.Name ~= State.LastDecisionKey or now - State.LastDecisionLogAt > 5 then
        State.LastDecisionKey, State.LastDecisionLogAt = winner.rec.Name, now
        if Config.ADVANCED.PathVerbose then
            for i, s in ipairs(scored) do
                UI.Log("PATH", string.format("%s %s [%s] now %d + future %.1f (x%.2f) = <b>%.1f</b>",
                    (i == 1) and ">>" or "  ", s.rec.Name, s.rec.Type, s.imm, s.future, s.factor, s.total),
                    (i == 1) and "#2ECC71" or "#90A4AE")
            end
        end
    end
    return winner.rec
end

function Dungeon.embarkToNode(rec)
    if Utils.isPlayerDead() then return false end
    if not (rec and rec.Frame and rec.Frame.Parent) then return false end

    local now = os.clock()
    if now - State.LastEmbarkAt < Config.ADVANCED.AutoNodeDelay then return false end
    if State.LastEmbarkName == rec.Name and now - State.LastEmbarkAt < Config.ADVANCED.EmbarkRetryCooldown then return false end
    if not Dungeon.isNodeSelectable(rec) then return false end

    local confirmBtn = rec.Frame:FindFirstChild("Confirm")
    if confirmBtn then Utils.fireButtonClick(confirmBtn) end

    local voteEv = Refs.Events:FindFirstChild("VoteForNode")
    if voteEv then pcall(function() voteEv:FireServer(rec.Name) end)
    else
        local legacy = Refs.Events:FindFirstChild("NodeSelect")
        if legacy then pcall(function() legacy:FireServer(type(rec.Raw) == "table" and rec.Raw or rec.Name) end) end
    end

    State.LastEmbarkName, State.LastEmbarkAt = rec.Name, now
    UI.Log("NODE", string.format("Embarking -> <font color='#CE93D8'><b>%s</b></font> (%s, Row: %d).",
        rec.Name, rec.Type, rec.Row), "#2ECC71")
    return true
end

