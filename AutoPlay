local function isInActiveCombat(): boolean
    if not (CombatGui and CombatGui.Enabled) then
        return false
    end

    local rewardFrame = DungeonGui:FindFirstChild("RewardFrame")
    if rewardFrame and rewardFrame.Visible then return false end

    local dialogue = DungeonGui:FindFirstChild("DialogueContainer")
    if dialogue and dialogue.Visible then return false end

    local rest = DungeonGui:FindFirstChild("RestContainer") or DungeonGui:FindFirstChild("RestFrame")
    if rest and rest.Visible then return false end

    local pickBoss = DungeonGui:FindFirstChild("PickBossFrame")
    if pickBoss and pickBoss.Visible then return false end

    local isTurn = LocalPlayer:GetAttribute("IsYourTurn") == true
    local hasCards = HandContainer.Visible and #HandContainer:GetChildren() > 0
    local hasEnemies = #getAliveEnemies() > 0

    return (isTurn or hasCards) and hasEnemies
end

