local pulseTweens = setmetatable({}, { __mode = "k" })

local function setDotState(indicator, color, pulse)
    local existing = pulseTweens[indicator]
    if existing then existing:Cancel() pulseTweens[indicator] = nil end

    if indicator:IsA("ImageLabel") then
        indicator.ImageColor3 = color
