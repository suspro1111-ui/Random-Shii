end

----------------------------------------------------------------------
-- AUTO-BOSS PICK RESOLVER
----------------------------------------------------------------------
local LastBossVoteAt = 0

local function getBossOptionPriority(bossName: string): number
    if not bossName or bossName == "" then return -math.huge end
    
    if BOSS_PRIORITY_LIST[bossName] then
        return BOSS_PRIORITY_LIST[bossName]
    end
    
    local lower = bossName:lower()
    for name, prio in pairs(BOSS_PRIORITY_LIST) do
        if lower:find(name:lower(), 1, true) or name:lower():find(lower, 1, true) then
            return prio
        end
    end
    
    return BOSS_DEFAULT_PRIORITY
end

local function handleAutoBossVote()
    if not AUTO_BOSS_VOTE_ENABLED then return false end
    if isPlayerDead() then return false end
    
    local now = os.clock()
    if now - LastBossVoteAt < BOSS_VOTE_COOLDOWN then return false end
    
    local pickBossFrame = DungeonGui:FindFirstChild("PickBossFrame")
    if not (pickBossFrame and pickBossFrame.Visible) then return false end
    
    local loadingGui = LocalPlayer.PlayerGui:FindFirstChild("LoadingGui")
    if loadingGui and loadingGui.Enabled then return false end
    
    local options = {}
    for i = 1, 3 do
        local optBtn = pickBossFrame:FindFirstChild("BossOption" .. i)
        if optBtn and optBtn:IsA("TextButton") and optBtn.Visible then
            local nameLbl = optBtn:FindFirstChild("BossName")
            local bossName = nameLbl and nameLbl.Text or ""
            if bossName ~= "" then
                local prio = getBossOptionPriority(bossName)
                table.insert(options, {
                    Index = i,
                    Button = optBtn,
                    Name = bossName,
                    Priority = prio,
                })
            end
        end
    end
    
    if #options == 0 then return false end
    
    if BOSS_VOTE_STRATEGY == "Priority" then
        table.sort(options, function(a, b)
            if a.Priority ~= b.Priority then return a.Priority > b.Priority end
            return a.Index < b.Index
        end)
    elseif BOSS_VOTE_STRATEGY == "Random" then
        options = { options[math.random(1, #options)] }
    end
    
    local chosen = options[1]
    if chosen and chosen.Button then
        LastBossVoteAt = now
        Log("BOSS", string.format("Voting for Boss: <font color='#FFD54F'><b>%s</b></font> (Priority: %d)...",
            chosen.Name, chosen.Priority), "#FFD54F")
        
        fireButtonClick(chosen.Button)
        
        local playerVoteOnBoss = Events:FindFirstChild("PlayerVoteOnBoss")
        if playerVoteOnBoss and playerVoteOnBoss:IsA("RemoteFunction") then
            pcall(function() playerVoteOnBoss:InvokeServer(chosen.Name) end)
        end
        
        task.wait(0.8)
        return true
    end
    
    return false
end

----------------------------------------------------------------------
-- DETERMINISTIC AUTO-REWARD RESOLVER (With Custom Passive Priority)
----------------------------------------------------------------------
local LastRewardActionAt = 0

local function getPassivePriority(passiveName: string, passiveId: string?): number
    if not passiveName or passiveName == "" then return -math.huge end
    
    if CUSTOM_PASSIVE_PRIORITY[passiveName] then
        return CUSTOM_PASSIVE_PRIORITY[passiveName]
    end
    if passiveId and CUSTOM_PASSIVE_PRIORITY[passiveId] then
        return CUSTOM_PASSIVE_PRIORITY[passiveId]
    end
    
    local lower = passiveName:lower()
    for name, prio in pairs(CUSTOM_PASSIVE_PRIORITY) do
        local nLower = name:lower()
        if lower == nLower or lower:find(nLower, 1, true) or nLower:find(lower, 1, true) then
            return prio
        end
    end
    
    return PASSIVE_DEFAULT_PRIORITY
end

local function handleRewards()
    if not AUTO_CLAIM_REWARDS then return false end
    if isPlayerDead() then return false end

    local rewardFrame = DungeonGui:FindFirstChild("RewardFrame")
    if not (rewardFrame and rewardFrame.Visible) then return false end

    local container = rewardFrame:FindFirstChild("Container")
    if not container then return false end

    local rewardContainer = container:FindFirstChild("RewardContainer")
    local skipBtn = container:FindFirstChild("SkipButton")
    local rewardsBtn = container:FindFirstChild("RewardsButton")

    local now = os.clock()
    if now - LastRewardActionAt < REWARD_SCAN_DELAY then return false end

    -- 1. Check if Sub-Rewards (Cards / Passives in Slot 1..3) are displayed
    local subRewardButtons = {}
    for i = 1, 3 do
        local slot = container:FindFirstChild("Reward" .. i)
        if slot then
            for _, child in ipairs(slot:GetChildren()) do
                if (child:IsA("GuiButton") or child:IsA("TextButton") or child:IsA("ImageButton")) and child.Visible then
                    local attackId = child:GetAttribute("AttackId")
                    local passiveId = child:GetAttribute("PassiveId")
                    local nameLbl = child:FindFirstChild("NameLabel")
                    local name = nameLbl and nameLbl.Text or (attackId or (passiveId or child.Name))
                    local costLbl = child:FindFirstChild("Cost") and child.Cost:FindFirstChild("Label")
                    local cost = costLbl and tonumber(costLbl.Text) or 0

                    table.insert(subRewardButtons, {
                        Button = child,
                        Name = name,
                        AttackId = attackId,
                        PassiveId = passiveId,
                        Cost = cost,
                        SlotIndex = i,
                    })
                end
            end
        end
    end

    if #subRewardButtons > 0 then
        local isActionSub = subRewardButtons[1].AttackId ~= nil
        local isPassiveSub = subRewardButtons[1].PassiveId ~= nil

        -- Skip strategies
        if (isActionSub and REWARD_CARD_STRATEGY == "Skip") or (isPassiveSub and REWARD_PASSIVE_STRATEGY == "Skip") then
            if skipBtn and skipBtn.Visible then
                Log("REWARD", "Skipping category selection...", "#B0BEC5")
                fireButtonClick(skipBtn)
                LastRewardActionAt = now
                task.wait(REWARD_ACTION_DELAY)
                return true
            end
        end

        -- Action sorting
        if isActionSub and REWARD_CARD_STRATEGY == "HighestRarity" then
            table.sort(subRewardButtons, function(a, b)
                return (a.Cost or 0) > (b.Cost or 0)
            end)
        end

        -- Passive sorting with Custom Priority
        if isPassiveSub and REWARD_PASSIVE_STRATEGY == "Priority" then
            table.sort(subRewardButtons, function(a, b)
                local aPrio = getPassivePriority(a.Name, a.PassiveId)
                local bPrio = getPassivePriority(b.Name, b.PassiveId)
                if aPrio ~= bPrio then
                    return aPrio > bPrio
                end
                return a.SlotIndex < b.SlotIndex
            end)
        end

        local chosenReward = subRewardButtons[1]
        local prioTag = isPassiveSub and string.format(" [Priority: %d]", getPassivePriority(chosenReward.Name, chosenReward.PassiveId)) or ""
        Log("REWARD", string.format("Claiming: <font color='#B388FF'><b>%s</b></font>%s", chosenReward.Name, prioTag), "#B388FF")
        
        fireButtonClick(chosenReward.Button)
        LastRewardActionAt = now
        task.wait(REWARD_ACTION_DELAY)
        return true
    end

    -- 2. Check if Category Buttons exist in RewardContainer
    local categoryButtons = {}
    if rewardContainer then
        for _, child in ipairs(rewardContainer:GetChildren()) do
            if (child:IsA("TextButton") or child:IsA("ImageButton") or child:IsA("GuiButton")) and child.Visible then
                table.insert(categoryButtons, child)
            end
        end
    end

    if #categoryButtons > 0 then
        table.sort(categoryButtons, function(a, b)
            local aText = (a:IsA("TextButton") and a.Text:lower()) or ""
            local bText = (b:IsA("TextButton") and b.Text:lower()) or ""
            local aIsCondense = aText:find("condense") ~= nil
            local bIsCondense = bText:find("condense") ~= nil
            if aIsCondense ~= bIsCondense then return aIsCondense end
            return a.LayoutOrder < b.LayoutOrder
        end)

        local targetCategory = categoryButtons[1]
        local catText = targetCategory:IsA("TextButton") and targetCategory.Text or targetCategory.Name
        Log("REWARD", string.format("Opening: <font color='#FFD54F'><b>%s</b></font>", catText), "#FFD54F")
        fireButtonClick(targetCategory)
        LastRewardActionAt = now
        task.wait(REWARD_ACTION_DELAY)
        return true
    end

    -- 3. Finalize Loot Screen when no categories left
    if rewardsBtn and rewardsBtn.Visible and (not skipBtn or not skipBtn.Visible) then
        Log("REWARD", "All loot claimed. Finalizing Rewards...", "#2ECC71")
        fireButtonClick(rewardsBtn)
        LastRewardActionAt = now
        task.wait(REWARD_FINISH_DELAY)
        return true
    end

    return false
end

----------------------------------------------------------------------
-- REST SITE AUTO-HEAL RESOLVER
----------------------------------------------------------------------
local LastRestActionAt = 0

local function handleRestSite()
    if not (AUTO_CONFIRM_REST and IsAutoNodeRunning) then return false end
    if isPlayerDead() then return false end
    if REST_ACTION ~= "Heal" then return false end

    local restContainer = DungeonGui:FindFirstChild("RestContainer") or DungeonGui:FindFirstChild("RestFrame")
    if not (restContainer and restContainer.Visible) then return false end

    local now = os.clock()
    if now - LastRestActionAt < REST_ACTION_DELAY then return false end

    local healBtn = nil
    local candidateNames = {"Heal", "HealButton", "HealOption", "Option1", "Option_Heal", "Rest", "RestButton", "Confirm"}
    for _, name in ipairs(candidateNames) do
        local btn = restContainer:FindFirstChild(name, true)
        if btn and (btn:IsA("TextButton") or btn:IsA("ImageButton")) and btn.Visible then
            healBtn = btn
            break
        end
    end

    if not healBtn then
        for _, descendant in ipairs(restContainer:GetDescendants()) do
            if (descendant:IsA("TextButton") or descendant:IsA("ImageButton")) and descendant.Visible then
                local btnText = ""
                if descendant:IsA("TextButton") then
                    btnText = descendant.Text:lower()
                end
                for _, lbl in ipairs(descendant:GetDescendants()) do
                    if lbl:IsA("TextLabel") and lbl.Visible then
                        btnText = btnText .. " " .. lbl.Text:lower()
                    end
                end

                if btnText:find("heal") or btnText:find("recover") or btnText:find("health") or btnText:find("hp") then
                    healBtn = descendant
                    break
                end
            end
        end
    end

    if healBtn then
        Log("REST", "Rest site active. Selecting <font color='#2ECC71'><b>Heal</b></font>...", "#2ECC71")
        fireButtonClick(healBtn)
        LastRestActionAt = now
        task.wait(REST_ACTION_DELAY)

        local confirmBtn = restContainer:FindFirstChild("Confirm", true) or restContainer:FindFirstChild("Continue", true)
        if confirmBtn and confirmBtn:IsA("TextButton") and confirmBtn.Visible then
            fireButtonClick(confirmBtn)
        end

        task.wait(0.8)
        return true
    end

    return false
end

----------------------------------------------------------------------
-- SMART AUTO-EVENT DIALOGUE RESOLVER (With Custom Choice Support)
----------------------------------------------------------------------
local LastEventActionAt = 0

local function pickEventOption(optionVisible, optionGuaranteed)
    local n = #optionVisible
    if EVENT_OPTION_STRATEGY == "Last" then
        for i = n, 1, -1 do
            if optionVisible[i] then return i end
        end
    elseif EVENT_OPTION_STRATEGY == "Guaranteed" then
        for i = 1, n do
            if optionVisible[i] and optionGuaranteed[i] then return i end
        end
        if not EVENT_ALLOW_RISKY_FALLBACK then return nil end
    end
    for i = 1, n do
        if optionVisible[i] then return i end
    end
    return nil
end

local function getCustomChoiceForEvent(eventName: string): number?
    if not eventName or eventName == "" then return nil end
    
    if CUSTOM_EVENT_CHOICES[eventName] then
        return CUSTOM_EVENT_CHOICES[eventName]
    end
    
    local lower = eventName:lower()
    for name, optNum in pairs(CUSTOM_EVENT_CHOICES) do
        if lower:find(name:lower(), 1, true) or name:lower():find(lower, 1, true) then
            return optNum
        end
    end
    
    return nil
end

local function processAutoEvent()
    if not (AUTO_EVENT_RESOLVER and IsAutoNodeRunning and DialogueContainer and DialogueContainer.Visible) then
        return false
    end
    if isPlayerDead() then return false end

    local now = os.clock()
    if now - LastEventActionAt < EVENT_STEP_DELAY then return false end

    local container = DialogueContainer:FindFirstChild("Container")
    if not container then return false end

    -- 1. Check for "Continue" button on Options1 (Outcome screen)
    local opt1 = container:FindFirstChild("Options1")
    if opt1 and opt1.Visible then
        local txtLbl = opt1:FindFirstChild("OptionText")
        if txtLbl and txtLbl.Text:lower():find("continue") then
            Log("EVENT", "Dismissing Event outcome (Continue)...", "#B0BEC5")
            fireButtonClick(opt1)
            LastEventActionAt = now
            task.wait(EVENT_STEP_DELAY)
            return true
        end
    end

    -- 2. Identify active event name from GUI
    local eventNameLbl = container:FindFirstChild("EventName")
    local eventName = eventNameLbl and eventNameLbl.Text or "Unknown Event"

    -- 3. Read available visible options
    local optionVisible, optionGuaranteed, optionButtons = {}, {}, {}
    for i = 1, 3 do
        local optBtn = container:FindFirstChild("Options" .. i)
        if optBtn and optBtn.Visible then
            local descLbl = optBtn:FindFirstChild("OptionDesc")
            local desc = (descLbl and descLbl.Text or ""):lower()

            optionVisible[i] = true
            optionButtons[i] = optBtn

            local isRisky = desc:find("fail") or desc:find("chance") or desc:find("check") or desc:find("require")
            optionGuaranteed[i] = not isRisky
        else
            optionVisible[i] = false
            optionGuaranteed[i] = false
        end
    end

    -- 4. Check Custom Choice first, then fallback to Strategy / Option 1
    local chosenIndex = nil
    local customChoice = getCustomChoiceForEvent(eventName)
    
    if customChoice and optionVisible[customChoice] then
        chosenIndex = customChoice
    else
        chosenIndex = pickEventOption(optionVisible, optionGuaranteed)
    end

    if chosenIndex and optionButtons[chosenIndex] then
        local btn = optionButtons[chosenIndex]
        local titleLbl = btn:FindFirstChild("OptionText")
        local title = titleLbl and titleLbl.Text or ("Option " .. chosenIndex)
        local modeTag = (customChoice and chosenIndex == customChoice) and "Custom Config" or "Strategy Fallback"
        
        Log("EVENT", string.format("[%s] Option %d (%s): <font color='#B388FF'><b>%s</b></font>",
            eventName, chosenIndex, modeTag, title), "#B388FF")
            
        fireButtonClick(btn)
        LastEventActionAt = now
        task.wait(EVENT_STEP_DELAY)
        return true
    end

    return false
end

