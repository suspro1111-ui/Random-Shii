function Dungeon.getBossOptionPriority(bossName: string): number
    if not bossName or bossName == "" then return -math.huge end
    if Config.BOSS_PRIORITY_LIST[bossName] then return Config.BOSS_PRIORITY_LIST[bossName] end
    local lower = bossName:lower()
    for name, prio in pairs(Config.BOSS_PRIORITY_LIST) do
        if lower:find(name:lower(), 1, true) or name:lower():find(lower, 1, true) then return prio end
    end
    return Config.ADVANCED.BossDefaultPrio
end

function Dungeon.handleAutoBossVote()
    if not Config.AUTO_BOSS_VOTE or Utils.isPlayerDead() then return false end
    local now = os.clock()
    if now - State.LastBossVoteAt < Config.ADVANCED.BossVoteCooldown then return false end

    local pickBossFrame = Refs.DungeonGui:FindFirstChild("PickBossFrame")
    if not (pickBossFrame and pickBossFrame.Visible) then return false end
    local loadingGui = Refs.LocalPlayer.PlayerGui:FindFirstChild("LoadingGui")
    if loadingGui and loadingGui.Enabled then return false end

    local options = {}
    for i = 1, 3 do
        local optBtn = pickBossFrame:FindFirstChild("BossOption" .. i)
        if optBtn and optBtn:IsA("TextButton") and optBtn.Visible then
            local nameLbl = optBtn:FindFirstChild("BossName")
            local bossName = nameLbl and nameLbl.Text or ""
            if bossName ~= "" then
                table.insert(options, {
                    Index = i, Button = optBtn, Name = bossName,
                    Priority = Dungeon.getBossOptionPriority(bossName),
                })
            end
        end
    end

    if #options == 0 then return false end
    if Config.BOSS_VOTE_STRATEGY == "Priority" then
        table.sort(options, function(a, b)
            if a.Priority ~= b.Priority then return a.Priority > b.Priority end
            return a.Index < b.Index
        end)
    elseif Config.BOSS_VOTE_STRATEGY == "Random" then
        options = { options[math.random(1, #options)] }
    end

    local chosen = options[1]
    if chosen and chosen.Button then
        State.LastBossVoteAt = now
        UI.Log("BOSS", string.format("Voting for Boss: <font color='#FFD54F'><b>%s</b></font> (Priority: %d)...",
            chosen.Name, chosen.Priority), "#FFD54F")
        Utils.fireButtonClick(chosen.Button)
        local playerVoteOnBoss = Refs.Events:FindFirstChild("PlayerVoteOnBoss")
        if playerVoteOnBoss and playerVoteOnBoss:IsA("RemoteFunction") then
            pcall(function() playerVoteOnBoss:InvokeServer(chosen.Name) end)
        end
        task.wait(0.8)
        return true
    end
    return false
end

function Dungeon.getPassivePriority(passiveName: string, passiveId: string?): number
    if not passiveName or passiveName == "" then return -math.huge end
    if Config.CUSTOM_PASSIVE_PRIORITY[passiveName] then return Config.CUSTOM_PASSIVE_PRIORITY[passiveName] end
    if passiveId and Config.CUSTOM_PASSIVE_PRIORITY[passiveId] then return Config.CUSTOM_PASSIVE_PRIORITY[passiveId] end

    local lower = passiveName:lower()
    for name, prio in pairs(Config.CUSTOM_PASSIVE_PRIORITY) do
        local nLower = name:lower()
        if lower == nLower or lower:find(nLower, 1, true) or nLower:find(lower, 1, true) then return prio end
    end
    return Config.ADVANCED.PassiveDefaultPrio
end

function Dungeon.handleRewards()
    if not Config.AUTO_REWARDS or Utils.isPlayerDead() then return false end
    local rewardFrame = Refs.DungeonGui:FindFirstChild("RewardFrame")
    if not (rewardFrame and rewardFrame.Visible) then return false end
    local container = rewardFrame:FindFirstChild("Container")
    if not container then return false end

    local rewardContainer = container:FindFirstChild("RewardContainer")
    local skipBtn = container:FindFirstChild("SkipButton")
    local rewardsBtn = container:FindFirstChild("RewardsButton")

    local now = os.clock()
    if now - State.LastRewardActionAt < Config.ADVANCED.RewardScanDelay then return false end

    local subRewardButtons = {}
    for i = 1, 3 do
        local slot = container:FindFirstChild("Reward" .. i)
        if slot then
            for _, child in ipairs(slot:GetChildren()) do
                if (child:IsA("GuiButton") or child:IsA("TextButton") or child:IsA("ImageButton")) and child.Visible then
                    local attackId = child:GetAttribute("AttackId")
                    local passiveId = child:GetAttribute("PassiveId")
                    local nameLbl = child:FindFirstChild("NameLabel")
                    local name = nameLbl and nameLbl.Text or (attackId or (passiveId or child.Name))
                    local costLbl = child:FindFirstChild("Cost") and child.Cost:FindFirstChild("Label")
                    local cost = costLbl and tonumber(costLbl.Text) or 0
                    table.insert(subRewardButtons, {
                        Button = child, Name = name, AttackId = attackId,
                        PassiveId = passiveId, Cost = cost, SlotIndex = i,
                    })
                end
            end
        end
    end

    if #subRewardButtons > 0 then
        local isActionSub = subRewardButtons[1].AttackId ~= nil
        local isPassiveSub = subRewardButtons[1].PassiveId ~= nil

        if (isActionSub and Config.CARD_REWARD_STRATEGY == "Skip") or (isPassiveSub and Config.PASSIVE_STRATEGY == "Skip") then
            if skipBtn and skipBtn.Visible then
                UI.Log("REWARD", "Skipping category selection...", "#B0BEC5")
                Utils.fireButtonClick(skipBtn)
                State.LastRewardActionAt = now
                task.wait(Config.ADVANCED.RewardActionDelay)
                return true
            end
        end

        if isActionSub and Config.CARD_REWARD_STRATEGY == "HighestRarity" then
            table.sort(subRewardButtons, function(a, b) return (a.Cost or 0) > (b.Cost or 0) end)
        end

        if isPassiveSub and Config.PASSIVE_STRATEGY == "Priority" then
            table.sort(subRewardButtons, function(a, b)
                local aPrio = Dungeon.getPassivePriority(a.Name, a.PassiveId)
                local bPrio = Dungeon.getPassivePriority(b.Name, b.PassiveId)
                if aPrio ~= bPrio then return aPrio > bPrio end
                return a.SlotIndex < b.SlotIndex
            end)
        end

        local chosenReward = subRewardButtons[1]
        local prioTag = isPassiveSub and string.format(" [Priority: %d]", Dungeon.getPassivePriority(chosenReward.Name, chosenReward.PassiveId)) or ""
        UI.Log("REWARD", string.format("Claiming: <font color='#B388FF'><b>%s</b></font>%s", chosenReward.Name, prioTag), "#B388FF")
        Utils.fireButtonClick(chosenReward.Button)
        State.LastRewardActionAt = now
        task.wait(Config.ADVANCED.RewardActionDelay)
        return true
    end

    local categoryButtons = {}
    if rewardContainer then
        for _, child in ipairs(rewardContainer:GetChildren()) do
            if (child:IsA("TextButton") or child:IsA("ImageButton") or child:IsA("GuiButton")) and child.Visible then
                table.insert(categoryButtons, child)
            end
        end
    end

    if #categoryButtons > 0 then
        table.sort(categoryButtons, function(a, b)
            local aText = (a:IsA("TextButton") and a.Text:lower()) or ""
            local bText = (b:IsA("TextButton") and b.Text:lower()) or ""
            local aIsCondense = aText:find("condense") ~= nil
            local bIsCondense = bText:find("condense") ~= nil
            if aIsCondense ~= bIsCondense then return aIsCondense end
            return a.LayoutOrder < b.LayoutOrder
        end)

        local targetCategory = categoryButtons[1]
        local catText = targetCategory:IsA("TextButton") and targetCategory.Text or targetCategory.Name
        UI.Log("REWARD", string.format("Opening: <font color='#FFD54F'><b>%s</b></font>", catText), "#FFD54F")
        Utils.fireButtonClick(targetCategory)
        State.LastRewardActionAt = now
        task.wait(Config.ADVANCED.RewardActionDelay)
        return true
    end

    if rewardsBtn and rewardsBtn.Visible and (not skipBtn or not skipBtn.Visible) then
        UI.Log("REWARD", "All loot claimed. Finalizing Rewards...", "#2ECC71")
        Utils.fireButtonClick(rewardsBtn)
        State.LastRewardActionAt = now
        task.wait(Config.ADVANCED.RewardFinishDelay)
        return true
    end
    return false
end

function Dungeon.handleRestSite()
    if not Config.AUTO_REST or Utils.isPlayerDead() then return false end
    local restContainer = Refs.DungeonGui:FindFirstChild("RestContainer") or Refs.DungeonGui:FindFirstChild("RestFrame")
    if not (restContainer and restContainer.Visible) then return false end

    local now = os.clock()
    if now - State.LastRestActionAt < Config.ADVANCED.RestActionDelay then return false end

    local healBtn = nil
    local candidateNames = {"Heal", "HealButton", "HealOption", "Option1", "Option_Heal", "Rest", "RestButton", "Confirm"}
    for _, name in ipairs(candidateNames) do
        local btn = restContainer:FindFirstChild(name, true)
        if btn and (btn:IsA("TextButton") or btn:IsA("ImageButton")) and btn.Visible then
            healBtn = btn
            break
        end
    end

    if not healBtn then
        for _, descendant in ipairs(restContainer:GetDescendants()) do
            if (descendant:IsA("TextButton") or descendant:IsA("ImageButton")) and descendant.Visible then
                local btnText = descendant:IsA("TextButton") and descendant.Text:lower() or ""
                for _, lbl in ipairs(descendant:GetDescendants()) do
                    if lbl:IsA("TextLabel") and lbl.Visible then btnText = btnText .. " " .. lbl.Text:lower() end
                end
                if btnText:find("heal") or btnText:find("recover") or btnText:find("health") or btnText:find("hp") then
                    healBtn = descendant
                    break
                end
            end
        end
    end

    if healBtn then
        UI.Log("REST", "Rest site active. Selecting <font color='#2ECC71'><b>Heal</b></font>...", "#2ECC71")
        Utils.fireButtonClick(healBtn)
        State.LastRestActionAt = now
        task.wait(Config.ADVANCED.RestActionDelay)

        local confirmBtn = restContainer:FindFirstChild("Confirm", true) or restContainer:FindFirstChild("Continue", true)
        if confirmBtn and confirmBtn:IsA("TextButton") and confirmBtn.Visible then
            Utils.fireButtonClick(confirmBtn)
        end
        task.wait(0.8)
        return true
    end
    return false
end

function Dungeon.getCustomChoiceForEvent(eventName: string): number?
    if not eventName or eventName == "" then return nil end
    if Config.CUSTOM_EVENT_CHOICES[eventName] then return Config.CUSTOM_EVENT_CHOICES[eventName] end
    local lower = eventName:lower()
    for name, optNum in pairs(Config.CUSTOM_EVENT_CHOICES) do
        if lower:find(name:lower(), 1, true) or name:lower():find(lower, 1, true) then return optNum end
    end
    return nil
end

function Dungeon.processAutoEvent()
    if not (Config.AUTO_EVENTS and State.IsAutoNodeRunning and Refs.DialogueContainer and Refs.DialogueContainer.Visible) then
        return false
    end
    if Utils.isPlayerDead() then return false end

    local now = os.clock()
    if now - State.LastEventActionAt < Config.ADVANCED.EventStepDelay then return false end

    local container = Refs.DialogueContainer:FindFirstChild("Container")
    if not container then return false end

    local opt1 = container:FindFirstChild("Options1")
    if opt1 and opt1.Visible then
        local txtLbl = opt1:FindFirstChild("OptionText")
        if txtLbl and txtLbl.Text:lower():find("continue") then
            UI.Log("EVENT", "Dismissing Event outcome (Continue)...", "#B0BEC5")
            Utils.fireButtonClick(opt1)
            State.LastEventActionAt = now
            task.wait(Config.ADVANCED.EventStepDelay)
            return true
        end
    end

    local eventNameLbl = container:FindFirstChild("EventName")
    local eventName = eventNameLbl and eventNameLbl.Text or "Unknown Event"

    local optionVisible, optionGuaranteed, optionButtons = {}, {}, {}
    for i = 1, 3 do
        local optBtn = container:FindFirstChild("Options" .. i)
        if optBtn and optBtn.Visible then
            local descLbl = optBtn:FindFirstChild("OptionDesc")
            local desc = (descLbl and descLbl.Text or ""):lower()
            optionVisible[i] = true
            optionButtons[i] = optBtn
            optionGuaranteed[i] = not (desc:find("fail") or desc:find("chance") or desc:find("check") or desc:find("require"))
        else
            optionVisible[i] = false
            optionGuaranteed[i] = false
        end
    end

    local chosenIndex = nil
    local customChoice = Dungeon.getCustomChoiceForEvent(eventName)
    if customChoice and optionVisible[customChoice] then
        chosenIndex = customChoice
    else
        local n = #optionVisible
        if Config.EVENT_STRATEGY == "Last" then
            for i = n, 1, -1 do if optionVisible[i] then chosenIndex = i break end end
        elseif Config.EVENT_STRATEGY == "Guaranteed" then
            for i = 1, n do if optionVisible[i] and optionGuaranteed[i] then chosenIndex = i break end end
        end
        if not chosenIndex then
            for i = 1, n do if optionVisible[i] then chosenIndex = i break end end
        end
    end

    if chosenIndex and optionButtons[chosenIndex] then
        local btn = optionButtons[chosenIndex]
        local titleLbl = btn:FindFirstChild("OptionText")
        local title = titleLbl and titleLbl.Text or ("Option " .. chosenIndex)
        local modeTag = (customChoice and chosenIndex == customChoice) and "Custom Config" or "Strategy Fallback"
        UI.Log("EVENT", string.format("[%s] Option %d (%s): <font color='#B388FF'><b>%s</b></font>",
            eventName, chosenIndex, modeTag, title), "#B388FF")
        Utils.fireButtonClick(btn)
        State.LastEventActionAt = now
        task.wait(Config.ADVANCED.EventStepDelay)
        return true
    end
    return false
end

