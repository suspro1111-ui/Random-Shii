type Icon = {
    Url: string,
    Id: number,
    IconName: string,
    ImageRectOffset: Vector2,
    ImageRectSize: Vector2,
}

type IconModule = {
    Icons: { string },
    GetAsset: (Name: string) -> Icon?,
}

local FetchIcons, Icons = pcall(function()
    return (loadstring(
        game:HttpGet("https://raw.githubusercontent.com/mstudio45/lucide-roblox-direct/refs/heads/main/source.lua")
    ) :: () -> IconModule)()
end)

local function IsValidCustomIcon(Icon: string)
    return typeof(Icon) == "string" and (Icon:match("^rbxasset://textures/") or Icon:match("roblox%.com/asset/%?id=") or Icon:match("rbxthumb://type="))
end

local function IsCustomAssetIcon(Icon: string, IncludeAssetId: boolean)
    return typeof(Icon) == "string" and (Icon:match("^content://") or (Icon:match("^rbxasset://%x+/") or Icon:match("^rbxasset://[^/]+/")) or (IncludeAssetId == true and Icon:match("^rbxassetid://")))
end

local function GetIcon(IconName: string): Icon?
    if not FetchIcons or not Icons then return nil end
    local Success, Icon = pcall(Icons.GetAsset, IconName)
    if not Success or typeof(Icon) ~= "table" then return nil end
    return Icon
end

local function GetCustomIcon(IconName: string): Icon?
    if not IconName then return nil end
    if tonumber(IconName) then
        IconName = string.format("rbxassetid://%s", tostring(IconName))
    end
    if IsCustomAssetIcon(IconName, true) or IsValidCustomIcon(IconName) then
        return {
            Url = IconName,
            Id = 0,
            IconName = IconName,
            ImageRectOffset = Vector2.zero,
            ImageRectSize = Vector2.zero,
        }
    end
    return GetIcon(IconName)
end

function Utils.SetIcon(imageLabel: ImageLabel, iconName: string)
    if not (imageLabel and imageLabel:IsA("ImageLabel")) then return end
    local icon = GetCustomIcon(iconName)
    if icon then
        imageLabel.Image = icon.Url or ""
        imageLabel.ImageRectOffset = icon.ImageRectOffset or Vector2.zero
        imageLabel.ImageRectSize = icon.ImageRectSize or Vector2.zero
    else
        imageLabel.Image = ""
        imageLabel.ImageRectOffset = Vector2.zero
        imageLabel.ImageRectSize = Vector2.zero
    end
end

function Utils.toNumber(v)
    if type(v) == "number" then return v end
    if type(v) == "string" then return tonumber(v) end
    return nil
end

function Utils.resolveThreshold(val, maxVal, defaultVal)
    if val == nil then val = defaultVal end
    if type(val) == "string" then
        local pct = val:match("^(%d+%.?%d*)%%$")
        if pct then
            local p = tonumber(pct) or 0
            return (p / 100) * (maxVal or 100), true, p
        end
        local num = tonumber(val)
        if num then
            return num, false, (maxVal and maxVal > 0) and ((num / maxVal) * 100) or 0
        end
    elseif type(val) == "number" then
        return val, false, (maxVal and maxVal > 0) and ((val / maxVal) * 100) or 0
    end
    return defaultVal or 0, false, 0
end

function Utils.isBelowThreshold(currentVal, maxVal, threshold)
    local targetVal, isPct, pct = Utils.resolveThreshold(threshold, maxVal, 0)
    if isPct then
        local curPct = (maxVal and maxVal > 0) and ((currentVal / maxVal) * 100) or 0
        return curPct <= pct
    else
        return currentVal <= targetVal
    end
end

function Utils.isAboveThreshold(currentVal, maxVal, threshold)
    local targetVal, isPct, pct = Utils.resolveThreshold(threshold, maxVal, 0)
    if isPct then
        local curPct = (maxVal and maxVal > 0) and ((currentVal / maxVal) * 100) or 0
        return curPct >= pct
    else
        return currentVal >= targetVal
    end
end

function Utils.isPlayerDead(): boolean
    if not Config.STOP_ON_DEATH then return false end
    local char = Refs.LocalPlayer.Character
    if not (char and char.Parent) then return true end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return true end
    local pHealth = Utils.toNumber(Refs.PlayerStats.Health)
    if pHealth and pHealth <= 0 then return true end
    return false
end

function Utils.ableToPlay(): boolean
    if Refs.LocalPlayer:GetAttribute("ignore") then return true end
    if Refs.LocalPlayer:GetAttribute("IsInTutorial") then return false end
    if not Refs.LocalPlayer:GetAttribute("IsYourTurn") then return false end
    if Refs.LocalPlayer:GetAttribute("Active") then return false end
    return true
end

function Utils.fireButtonClick(button)
    if not button then return end
    pcall(function()
        if firesignal then
            firesignal(button.MouseButton1Click)
            if button:IsA("GuiButton") then firesignal(button.Activated) end
        elseif getconnections then
            for _, conn in ipairs(getconnections(button.MouseButton1Click)) do
                if conn.Function then conn.Function() elseif conn.Fire then conn:Fire() end
            end
            if button:IsA("GuiButton") then
                for _, conn in ipairs(getconnections(button.Activated)) do
                    if conn.Function then conn.Function() elseif conn.Fire then conn:Fire() end
                end
            end
        end
    end)
end

function Utils.getRunTime(): string
    local ok, text = pcall(function()
        local lbl = Refs.DungeonGui:FindFirstChild("TotalTimeCountLabel")
        return lbl and lbl.Text
    end)
    if ok and type(text) == "string" and text ~= "" then
        local match = text:match("(%d+:%d+:%d+)") or text:match("(%d+:%d+)")
        if match then return match end
    end
    return os.date("%H:%M:%S")
end

function Utils.getRunTimeInSeconds(): number
    local ok, text = pcall(function()
        local lbl = Refs.DungeonGui:FindFirstChild("TotalTimeCountLabel")
        return lbl and lbl.Text
    end)
    if ok and type(text) == "string" and text ~= "" then
        local h, m, s = text:match("(%d+):(%d+):(%d+)")
        if h and m and s then
            return tonumber(h) * 3600 + tonumber(m) * 60 + tonumber(s)
        end
        local m2, s2 = text:match("(%d+):(%d+)")
        if m2 and s2 then
            return tonumber(m2) * 60 + tonumber(s2)
        end
    end
    return 0
end

function Utils.forcePlayerReset()
    pcall(function()
        local char = Refs.LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.Health = 0 else char:BreakJoints() end
            Refs.Events.OnRunCompletion:FireServer(true)
        end
    end)
end

