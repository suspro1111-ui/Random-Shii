                TweenInfo.new(1.35, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
                { ImageTransparency = 0.45 })
            tween:Play()
            pulseTweens[indicator] = tween
        end
    else
        indicator.BackgroundColor3 = color
        local halo = indicator:FindFirstChild("Halo")
        if halo then halo.Color = color end
        indicator.BackgroundTransparency = 0
        if pulse then
            local tween = TweenService:Create(indicator,
                TweenInfo.new(1.35, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
                { BackgroundTransparency = 0.4 })
            tween:Play()
            pulseTweens[indicator] = tween
        end
    end
end

