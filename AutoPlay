function Combat.getCurrentBossName(): string?
    local ok, txt = pcall(function()
        local lbl = Refs.DungeonGui:FindFirstChild("BossLabel")
        return lbl and lbl.Text
    end)
    if ok and type(txt) == "string" and txt ~= "" then
        local matched = txt:match("Layer Boss:%s*(.+)")
        if matched and matched ~= "" then return matched end
    end
    return nil
end

function Combat.getBossStrategy(bossName: string?)
    if not bossName or bossName == "" then return nil end
    if Combat.BossStrategies[bossName] then return Combat.BossStrategies[bossName] end

    local lower = bossName:lower()
    for registeredName, strat in pairs(Combat.BossStrategies) do
        if lower:find(registeredName:lower(), 1, true) or registeredName:lower():find(lower, 1, true) then
            return strat
        end
    end
    return nil
end

