----------------------------------------------------------------------
-- REAL-TIME LOG MANAGER & EXACT COUNTER BADGE SYNC
----------------------------------------------------------------------
local logIndex = 0

local function sanitizeRichText(value)
    return (tostring(value):gsub("[<>&]", {
        ["<"] = "&lt;", [">"] = "&gt;", ["&"] = "&amp;",
    }))
end

local function getActiveLogCount(): number
    local count = 0
    for _, child in ipairs(LogScroll:GetChildren()) do
        if child:IsA("TextLabel") then
            count += 1
        end
    end
    return count
end

local function updateCounterBadge()
    local count = getActiveLogCount()
    CounterBadge.Text = string.format("%d/%d", count, MAX_LOG_LINES)
    CounterBadge.TextColor3 = (count >= MAX_LOG_LINES) and THEME.AccentSoft or THEME.SubMuted
end

LogScroll.ChildAdded:Connect(function(child)
    if child:IsA("TextLabel") then
        updateCounterBadge()
    end
end)

LogScroll.ChildRemoved:Connect(function(child)
    if child:IsA("TextLabel") then
        task.defer(updateCounterBadge)
    end
end)

local function pruneLogs(limit)
    local labels = {}
    for _, child in ipairs(LogScroll:GetChildren()) do
        if child:IsA("TextLabel") then
            table.insert(labels, child)
        end
    end

    table.sort(labels, function(a, b)
        return (a.LayoutOrder or 0) < (b.LayoutOrder or 0)
    end)

    while #labels > limit do
        local oldest = table.remove(labels, 1)
        if oldest then
            pcall(function() oldest:Destroy() end)
        end
    end
end

local function Log(tag, text, colorHex)
    LastLogAt = os.clock()
    local ok, err = pcall(function()
        logIndex += 1
        colorHex = colorHex or "#E6E6F0"

        local tagOut  = sanitizeRichText(tag)
        local textOut = RICH_TEXT_PASSTHROUGH and tostring(text) or sanitizeRichText(text)
        local timeStamp = getRunTime()

        local nearBottom = (LogScroll.AbsoluteCanvasSize.Y
            - LogScroll.CanvasPosition.Y
            - LogScroll.AbsoluteWindowSize.Y) <= 48

        local entry = Instance.new("TextLabel")
        entry.Name = string.format("LogEntry_%d", logIndex)
        entry.Size = UDim2.new(1, 0, 0, 0)
        entry.AutomaticSize = Enum.AutomaticSize.Y
        entry.BackgroundTransparency = 1
        entry.RichText = true
        entry.Font = UI_LAYOUT.LogFont
        entry.TextSize = UI_LAYOUT.LogTextSize
        entry.TextColor3 = THEME.Text
        entry.TextXAlignment = Enum.TextXAlignment.Left
        entry.TextWrapped = true
        entry.LayoutOrder = logIndex
        entry.ZIndex = 4
        entry.Text = string.format(
            "<font color='#584E6D'>[%s]</font> <font color='%s'><b>[%s]</b> %s</font>",
            timeStamp, colorHex, tagOut, textOut)
        entry.Parent = LogScroll

        pruneLogs(MAX_LOG_LINES)

        if nearBottom then
            task.defer(function()
                if entry.Parent then
                    LogScroll.CanvasPosition = Vector2.new(0, LogScroll.AbsoluteCanvasSize.Y)
                end
            end)
        end

        entry.TextTransparency = 0.45
        TweenService:Create(entry,
            TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { TextTransparency = 0 }):Play()
    end)
    if not ok then
        warn("[Console] log error:", err)
    end
end

