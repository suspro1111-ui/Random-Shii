-- [Worker 1: Hardened Combat Loop]
task.spawn(function()
    while true do
        task.wait(0.15)
        if State.IsBotRunning and State.CombatMode > 0 and not Utils.isPlayerDead() then
            local ok, err = pcall(Combat.processTurn)
            if not ok then
                UI.Log("ERROR", tostring(err), "#EB4D4B")
                task.wait(1)
            end
        end
    end
end)

-- [Worker 2: Dungeon Navigation, Rewards, Events, Rest, Boss & Retry Loop]
task.spawn(function()
    while true do
        task.wait(Config.NODE_SCAN_INTERVAL)

        if not Utils.isPlayerDead() then
            -- 1. Auto-Retry always checked first
            local retried = false
            local okRetry, resRetry = pcall(Dungeon.handleAutoRetry)
            if okRetry and resRetry then
                retried = true
            end

            if not retried then
                local inCombat = Combat.isInActiveCombat()
                local inTransition = Dungeon.isInTransition()
                local modalOpen = Dungeon.isAnyModalOpen()

                -- Strict isolation: Never touch exploration or map if combat or transitions are active
                if not inCombat and not inTransition then
                    -- 2. Boss Vote
                    local bossVoted = false
                    local okBoss, resBoss = pcall(Dungeon.handleAutoBossVote)
                    if okBoss and resBoss then
                        bossVoted = true
                    end

                    if not bossVoted and State.IsAutoNodeRunning and Config.AUTO_NODE_ENABLED then
                        -- 3. Standard Exploration Automation
                        local rewHandled = false
                        local rewFrame = Refs.DungeonGui:FindFirstChild("RewardFrame")
                        if rewFrame and rewFrame.Visible then
                            pcall(Dungeon.handleRewards)
                            rewHandled = true
                        end

                        local evHandled = false
                        local dialContainer = Refs.DialogueContainer or Refs.DungeonGui:FindFirstChild("DialogueContainer")
                        if not rewHandled and dialContainer and dialContainer.Visible then
                            pcall(Dungeon.processAutoEvent)
                            evHandled = true
                        end

                        local restHandled = false
                        local restContainer = Refs.DungeonGui:FindFirstChild("RestContainer") or Refs.DungeonGui:FindFirstChild("RestFrame")
                        if not rewHandled and not evHandled and restContainer and restContainer.Visible then
                            pcall(Dungeon.handleRestSite)
                            restHandled = true
                        end

                        -- 4. Map Node Embarkation (Only when all modals, combat, and transitions are clean)
                        if not rewHandled and not evHandled and not restHandled and not modalOpen then
                            pcall(function()
                                local target = Dungeon.AutoNodeThink()
                                if not target then return end
                                if Config.BOSS_REQUIRES_MANUAL and target.Type == "Boss" then
                                    if target.Name ~= State.LastDecisionKey or os.clock() - State.LastDecisionLogAt > 5 then
                                        State.LastDecisionKey, State.LastDecisionLogAt = target.Name, os.clock()
                                        UI.Log("PATH", "Boss row reached — manual embark required.", "#FFD54F")
                                    end
                                    return
                                end
                                Dungeon.embarkToNode(target)
                            end)
                        end
                    end
                end
            end
        end
    end
end)

-- [Worker 3: Run Timeout & Inactivity Watchdog Loop]
task.spawn(function()
    while true do
        task.wait(1.0)
        if Config.ENABLED_RUN_TIMEOUT and State.IsBotRunning and not Utils.isPlayerDead() then
            local now = os.clock()
            local runSeconds = Utils.getRunTimeInSeconds()

            if Config.RUN_TIMEOUT > 0 and runSeconds >= Config.RUN_TIMEOUT then
                UI.Log("TIMEOUT", string.format("Run duration (%d s) exceeded limit (%d s). Resetting player...", runSeconds, Config.RUN_TIMEOUT), "#EB4D4B")
                Utils.forcePlayerReset()
                task.wait(3.0)
            elseif Config.ENABLED_INACTIVITY_TIMEOUT and Config.INACTIVITY_TIMEOUT > 0 and (now - State.LastLogAt >= Config.INACTIVITY_TIMEOUT) then
                local inLoading = (Refs.LocalPlayer.PlayerGui:FindFirstChild("LoadingGui") and Refs.LocalPlayer.PlayerGui.LoadingGui.Enabled)
                if not inLoading then
                    UI.Log("TIMEOUT", string.format("Inactivity detected (%d s without logs). Resetting player...", math.floor(now - State.LastLogAt)), "#EB4D4B")
                    Utils.forcePlayerReset()
                    task.wait(3.0)
                end
            end
        end
    end
end)
