    function UI.Log(tag, text, colorHex)
        State.LastLogAt = os.clock()
        local ok, err = pcall(function()
            State.LogIndex += 1
            colorHex = colorHex or "#E6E6F0"
            local tagOut = (tostring(tag):gsub("[<>&]", { ["<"] = "&lt;", [">"] = "&gt;", ["&"] = "&amp;" }))
            local textOut = Config.RICH_TEXT_PASSTHROUGH and tostring(text) or (tostring(text):gsub("[<>&]", { ["<"] = "&lt;", [">"] = "&gt;", ["&"] = "&amp;" }))
            local timeStamp = Utils.getRunTime()

            local nearBottom = (LogScroll.AbsoluteCanvasSize.Y - LogScroll.CanvasPosition.Y - LogScroll.AbsoluteWindowSize.Y) <= 48

            local entry = Instance.new("TextLabel")
            entry.Name = string.format("LogEntry_%d", State.LogIndex)
            entry.Size = UDim2.new(1, 0, 0, 0)
            entry.AutomaticSize = Enum.AutomaticSize.Y
            entry.BackgroundTransparency = 1
            entry.RichText = true
            entry.Font = Config.UI_LAYOUT.LogFont
            entry.TextSize = Config.UI_LAYOUT.LogTextSize
            entry.TextColor3 = Config.THEME.Text
            entry.TextXAlignment = Enum.TextXAlignment.Left
            entry.TextWrapped = true
            entry.LayoutOrder = State.LogIndex
            entry.ZIndex = 4
            entry.Text = string.format("<font color='#584E6D'>[%s]</font> <font color='%s'><b>[%s]</b> %s</font>", timeStamp, colorHex, tagOut, textOut)
            entry.Parent = LogScroll

            -- Pruning
            local labels = {}
            for _, child in ipairs(LogScroll:GetChildren()) do
                if child:IsA("TextLabel") then table.insert(labels, child) end
            end
            table.sort(labels, function(a, b) return (a.LayoutOrder or 0) < (b.LayoutOrder or 0) end)
            while #labels > Config.MAX_LOG_LINES do
                local oldest = table.remove(labels, 1)
                if oldest then pcall(function() oldest:Destroy() end) end
            end

            if nearBottom then
                task.defer(function()
                    if entry.Parent then LogScroll.CanvasPosition = Vector2.new(0, LogScroll.AbsoluteCanvasSize.Y) end
                end)
            end
            entry.TextTransparency = 0.45
            Services.TweenService:Create(entry, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { TextTransparency = 0 }):Play()
        end)
        if not ok then warn("[Console] log error:", err) end
    end

