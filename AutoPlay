local DAMAGE_TYPES = { "Slash", "Stab", "Strike" }
local DAMAGE_TYPE_ALIAS = { Slash = "Slash", Stab = "Stab", Strike = "Strike", Pierce = "Stab", Blunt = "Strike" }
local GRADES = { "Fatal", "Weak", "Normal", "Endured", "Ineffective" }
local RESIST_WORDS = {}
for _, g in ipairs(GRADES) do RESIST_WORDS[g] = true end

local ResistTable = { Fatal = 2, Weak = 1.5, Normal = 1, Endured = 0.5, Ineffective = 0.25 }
do
    local ok, mod = pcall(function()
        return require(ReplicatedStorage.ClientModules:WaitForChild("Resistances", 3))
    end)
    if ok and type(mod) == "table" then
        local valid = true
        for _, g in ipairs(GRADES) do
            local v = toNumber(mod[g])
            if v == nil or v <= 0 then valid = false break end
        end
        if valid then
            ResistTable = {}
            for _, g in ipairs(GRADES) do ResistTable[g] = toNumber(mod[g]) end
        end
    end
end

local function normalizeGrade(v)
    if type(v) == "string" then
        local g = v:gsub("%s+", "")
        if RESIST_WORDS[g] then return g end
    end
    return nil
end

----------------------------------------------------------------------
-- CARD / INTENT PARSER
----------------------------------------------------------------------
local function parseIntent(intent)
    if type(intent) ~= "table" then return nil end

    local bonus = toNumber(intent["Intent Bonus"])
    local damageType, role, defKind = nil, nil, nil

    local function classify(value)
        if type(value) ~= "string" then return end
        if value == "Attack" then if role == nil then role = "Attack" end return end
        if value == "Defend" then if role == nil then role = "Defend" end return end
        local alias = DAMAGE_TYPE_ALIAS[value]
        if alias then
            if damageType == nil then damageType = alias end
            return
        end
        local lv = value:lower()
        if INTENT_DEF_WORDS[lv] and defKind == nil then
            defKind = (lv == "evade" or lv == "dodge") and "Evade" or "Guard"
        end
    end

    classify(intent["Intent Type"])
    classify(intent["Intent Damage"])

    for _, v in pairs(intent) do
        if type(v) == "string" then
            classify(v)
        elseif type(v) == "number" and bonus == nil then
            bonus = v
        end
    end

    bonus = bonus or 0
    local isDefensive = (defKind ~= nil) or (role == "Defend")
    local isOffensive = (not isDefensive) and (role == "Attack" or damageType ~= nil)

    return {
        Bonus = bonus,
        DamageType = damageType,
        Role = role,
        Kind = defKind,
        IsDefensive = isDefensive,
        IsOffensive = isOffensive,
    }
end

local function parseCardData(rawCard, fallbackId)
    if type(rawCard) ~= "table" then return nil end

    local id = fallbackId or rawCard.AttackId or rawCard[3]
    local name = rawCard.Name or rawCard[7] or rawCard[6] or rawCard.DisplayName or rawCard[2] or "Action"

    local intentList = rawCard["Intent List"] or rawCard.IntentList
    if type(intentList) ~= "table" then
        if type(rawCard[5]) == "table" then
            intentList = rawCard[5]
        elseif type(rawCard[4]) == "table" then
            intentList = rawCard[4]
        end
    end

    local basePower = toNumber(rawCard["Base Power"]) or toNumber(rawCard.BasePower)
    if basePower == nil then
        basePower = toNumber(rawCard[4]) or toNumber(rawCard[3]) or 0
    end

    local cost = toNumber(rawCard.Cost) or toNumber(rawCard[9]) or toNumber(rawCard[8]) or 0
    local rarity = toNumber(rawCard.Rarity) or toNumber(rawCard[8]) or toNumber(rawCard[7]) or 1
    local attackWeight = toNumber(rawCard["Attack Weight"]) or toNumber(rawCard.AttackWeight) or 1

    local coins, bonusSum, isDefense, defenseKind, intentCount = {}, 0, false, nil, 0
    if type(intentList) == "table" then
        for _, intent in ipairs(intentList) do
            local info = parseIntent(intent)
            if info then
                intentCount = intentCount + 1
                bonusSum = bonusSum + info.Bonus
                if info.IsDefensive then
                    isDefense = true
                    if defenseKind == nil then defenseKind = info.Kind end
                end
                table.insert(coins, info)
            end
        end
    end

    local lowerName = tostring(name):lower()
    for word in pairs(CARD_DEF_WORDS) do
        if lowerName:find(word, 1, true) then
            isDefense = true
            break
        end
    end

    local offensiveCoins = 0
    for _, c in ipairs(coins) do
        if c.IsOffensive then offensiveCoins = offensiveCoins + 1 end
    end
    if #coins == 0 and not isDefense then offensiveCoins = 1 end

    return {
        AttackId = tostring(id),
        Name = tostring(name),
        BasePower = basePower,
        MaxPower = basePower + bonusSum,
        BonusSum = bonusSum,
        Cost = cost,
        Rarity = rarity,
        IntentCount = intentCount,
        IsDefenseOrEvade = isDefense,
        DefenseKind = defenseKind,
        Coins = coins,
        OffensiveCoinCount = offensiveCoins,
        AttackWeight = attackWeight,
        RawData = rawCard,
        Button = nil,
        Source = nil,
    }
end

----------------------------------------------------------------------
-- RESISTANCE READERS
----------------------------------------------------------------------
local function getPlayerResistancesDirect()
    local res = {
        Slash = normalizeGrade(PlayerStats.SlashPhysicalResist),
        Stab = normalizeGrade(PlayerStats.StabPhysicalResist),
        Strike = normalizeGrade(PlayerStats.StrikePhysicalResist),
    }

    if not (res.Slash and res.Stab and res.Strike) then
        local function fromLabel(labelName, key)
            if res[key] then return end
            local ok, txt = pcall(function()
                local list = CombatGui:FindFirstChild("AllyDataList")
                local cont = list and list:FindFirstChild("ResistancesContainer")
                local lbl = cont and cont:FindFirstChild(labelName)
                return lbl and lbl.Text
            end)
            if ok and type(txt) == "string" then
                res[key] = normalizeGrade(txt:match("^(%a+)"))
            end
        end
        fromLabel("SlashDefense", "Slash")
        fromLabel("StabDefense", "Stab")
        fromLabel("StrikeDefense", "Strike")
    end

    for _, t in ipairs(DAMAGE_TYPES) do
        if not res[t] then res[t] = "Normal" end
    end
    return res
end

local resCache = { At = 0, Res = nil }
local function getPlayerResistances()
    if resCache.Res and (os.clock() - resCache.At) < RESIST_CACHE_TIME then return resCache.Res end
    local ok, r = pcall(getPlayerResistancesDirect)
    resCache.Res = (ok and r) or { Slash = "Normal", Stab = "Normal", Strike = "Normal" }
    resCache.At = os.clock()
    return resCache.Res
end

local function getUnitResistances(unitData)
    local res = {
        Slash = normalizeGrade(unitData and unitData.SlashPhysicalResist),
        Stab = normalizeGrade(unitData and unitData.StabPhysicalResist),
        Strike = normalizeGrade(unitData and unitData.StrikePhysicalResist),
    }
    for _, t in ipairs(DAMAGE_TYPES) do
        if not res[t] then res[t] = "Normal" end
    end
    return res
end

----------------------------------------------------------------------
-- THREAT MATH & INCOMING DAMAGE CALCULATOR
----------------------------------------------------------------------
local function getEnemyFirstCard(unitData)
    if type(unitData) ~= "table" or type(unitData.Hand) ~= "table" then return nil end
    return unitData.Hand[1] or select(2, next(unitData.Hand))
end

local function calculateEnemyIncomingDamage(targetEnemy): number
    if not targetEnemy or not targetEnemy.UnitData then return 0 end
    local firstCard = getEnemyFirstCard(targetEnemy.UnitData)
    if not firstCard then return 0 end

    local card = parseCardData(firstCard)
    if not card then return 0 end

    local playerRes = getPlayerResistances()
    local totalDamage = 0

    for _, coin in ipairs(card.Coins) do
        if coin.IsOffensive then
            local coinPower = card.BasePower + coin.Bonus
            local mult = 1.0
            if coin.DamageType and playerRes[coin.DamageType] then
                mult = ResistTable[playerRes[coin.DamageType]] or 1.0
            end
            totalDamage = totalDamage + (coinPower * mult)
        end
    end

    if totalDamage <= 0 and card.MaxPower > 0 then
        totalDamage = card.MaxPower
    end

    return totalDamage
end

local function estimateEnemyThreat(unitData)
    local res = getPlayerResistances()
    local score, offensiveCards, scanned, topCard = 0, 0, 0, 0
    local profile = {}

    local hand = unitData and unitData.Hand
    if type(hand) ~= "table" then return 0, 0, 0, 0, profile end

    for _, rawCard in ipairs(hand) do
        local card = parseCardData(rawCard)
        if card then
            scanned = scanned + 1
            if card.OffensiveCoinCount > 0 then
                offensiveCards = offensiveCards + 1
                local cardScore = 0
                for _, coin in ipairs(card.Coins) do
                    if coin.IsOffensive then
                        local power = card.BasePower + coin.Bonus
                        if coin.DamageType then
                            power = power * (ResistTable[res[coin.DamageType]] or 1)
                            profile[coin.DamageType] = true
                        end
                        cardScore = cardScore + power
                    end
                end
                score = score + cardScore
                if cardScore > topCard then topCard = cardScore end
            end
        end
    end

    return score, offensiveCards, scanned, topCard, profile
end

local function profileToString(profile)
    local out = {}
    for _, t in ipairs(DAMAGE_TYPES) do
        if profile[t] then table.insert(out, t) end
    end
    if #out == 0 then return "?" end
    return table.concat(out, "/")
end

local function expectedDamage(card, enemyRes)
    local total = 0
    for _, coin in ipairs(card.Coins) do
        if coin.IsOffensive then
            local power = card.BasePower + coin.Bonus
            if coin.DamageType then
                power = power * (ResistTable[enemyRes[coin.DamageType]] or 1)
            end
            total = total + power
        end
    end
    if total <= 0 then total = card.MaxPower end
    return total
end

----------------------------------------------------------------------
-- PLAYER & ENEMY STATE HELPERS
----------------------------------------------------------------------
local function isEnemyCardDefensiveOrEvasive(unitData)
    local first = getEnemyFirstCard(unitData)
    if not first then return false end
    local parsed = parseCardData(first)
    return parsed ~= nil and parsed.IsDefenseOrEvade or false
end

local function isEnemyStaggered(unitData, model)
    local targetModel = model or (unitData and unitData.Model)
    
    if targetModel then
        local hrp = targetModel:FindFirstChild("HumanoidRootPart") or targetModel.PrimaryPart
        local staggerFrames = CombatGui:FindFirstChild("StaggerFrames")
        
        if staggerFrames then
            local staggerTemplate = staggerFrames:FindFirstChild("StaggerTemplate")
            if staggerTemplate and staggerTemplate:IsA("BillboardGui") and staggerTemplate.Enabled then
                if (hrp and staggerTemplate.Adornee == hrp)
                    or (staggerTemplate.Adornee and (staggerTemplate.Adornee == targetModel or staggerTemplate.Adornee:IsDescendantOf(targetModel))) then
                    return true
                end
            end

            for _, frame in ipairs(staggerFrames:GetChildren()) do
                if frame:IsA("BillboardGui") and frame.Enabled and frame.Adornee then
                    if (hrp and frame.Adornee == hrp)
                        or frame.Adornee == targetModel
                        or frame.Adornee:IsDescendantOf(targetModel) then
                        return true
                    end
                end
            end
        end

        if targetModel:GetAttribute("Staggered") or targetModel:GetAttribute("StanceBreak") then
            return true
        end
    end

    if type(unitData) == "table" and type(unitData.Hand) == "table" and next(unitData.Hand) == nil then
        return true
    end

    return false
end

local function getPlayerPosture()
    local ok, v = pcall(function() return PlayerStats.Posture end)
    if ok and type(v) == "number" then return v end
    local ok2, txt = pcall(function()
        local ally = CombatGui:FindFirstChild("AllyDataList")
        local post = ally and ally:FindFirstChild("Posture")
        local lbl = post and post:FindFirstChild("Label")
        return lbl and lbl.Text
    end)
    if ok2 and type(txt) == "string" then return tonumber(txt) end
    return nil
end

local function currentHPPercent()
    local hp    = toNumber(PlayerStats.Health)    or 100
    local maxHp = toNumber(PlayerStats.MaxHealth) or hp
    if maxHp <= 0 then return 100 end
    return (hp / maxHp) * 100
end

----------------------------------------------------------------------
-- HAND & E.G.O SCANNERS
----------------------------------------------------------------------
local function getEGOCards()
    local egoCards = {}
    if not (PlayerStats and type(PlayerStats.EGOHand) == "table") then
        return egoCards
    end
    for k, raw in pairs(PlayerStats.EGOHand) do
        local attackId = tostring(raw[3] or k)
        local parsed = parseCardData(raw, attackId)
        if parsed then
            parsed.Source = "EGO"
            table.insert(egoCards, parsed)
        end
    end
    return egoCards
end

local function resolveRawCard(attackId)
    local src = PlayerStats.Hand and PlayerStats.Hand[attackId]
    if src then return src, "Hand" end
    if AUTO_USE_EGO then
        local ego = PlayerStats.EGOHand and PlayerStats.EGOHand[attackId]
        if ego then return ego, "EGO" end
    end
    local function scan(tbl, tag)
        if type(tbl) ~= "table" then return nil end
        for k, v in pairs(tbl) do
            if type(v) == "table" and (tostring(k) == tostring(attackId) or tostring(v[3] or "") == tostring(attackId)) then
                return v, tag
            end
        end
        return nil
    end
    local a, aTag = scan(PlayerStats.Hand, "Hand")
    if a then return a, aTag end
    if AUTO_USE_EGO then
        local e, eTag = scan(PlayerStats.EGOHand, "EGO")
        if e then return e, eTag end
    end
    return nil
end

local function scanCardButtons(container, out, seen)
    if not container then return end
    for _, child in ipairs(container:GetChildren()) do
        if child:IsA("TextButton") then
            local attackId = child:GetAttribute("AttackId")
            if attackId and not seen[tostring(attackId)] then
                local raw, source = resolveRawCard(attackId)
                if raw then
                    local parsed = parseCardData(raw, tostring(attackId))
                    if parsed then
                        parsed.Button = child
                        parsed.Source = source
                        seen[parsed.AttackId] = true
                        table.insert(out, parsed)
                    end
                end
            end
        end
    end
end

local function getCardsInHand()
    local cards, seen = {}, {}
    scanCardButtons(HandContainer, cards, seen)
    scanCardButtons(CombatGui:FindFirstChild("GuardCardPosition"), cards, seen)

    if #cards == 0 and PlayerStats and type(PlayerStats.Hand) == "table" then
        for k, raw in pairs(PlayerStats.Hand) do
            local attackId = tostring(raw[3] or k)
            if not seen[attackId] then
                local parsed = parseCardData(raw, attackId)
                if parsed then
                    parsed.Source = "Hand"
                    seen[attackId] = true
                    table.insert(cards, parsed)
                end
            end
        end
    end

    return cards
end

----------------------------------------------------------------------
-- ENEMY SCANNER WITH TARGETABILITY VERIFICATION
----------------------------------------------------------------------
local function getEntitiesFolder()
    return Workspace:FindFirstChild("Entities")
        or Workspace:FindFirstChild("BattleEntities")
        or Workspace:FindFirstChild("Units")
end

local function findUnitDataForModel(model, modelId)
    if modelId and CachedBattleUnits[modelId] then
        return CachedBattleUnits[modelId], modelId
    end
    if CachedBattleUnits[model.Name] then
        return CachedBattleUnits[model.Name], model.Name
    end
    for id, uData in pairs(CachedBattleUnits) do
        if type(uData) == "table" then
            if uData.Model == model then
                return uData, id
            elseif modelId and (uData.Id == modelId or tostring(uData[10] or "") == modelId) then
                return uData, id
            end
        end
    end
    return nil, modelId or model.Name
end

local function getAliveEnemies()
    local enemies = {}
    local seenIds = {}
    local seenModels = {}

    local entitiesFolder = getEntitiesFolder()

    local function addEnemy(id, unitData, model, frame)
        if not id or id == "" then return end
        if seenIds[id] then return end

        if not (model and model.Parent) then
            if unitData and unitData.Model and unitData.Model.Parent then
                model = unitData.Model
            elseif entitiesFolder then
                model = entitiesFolder:FindFirstChild(id)
                if not model then
                    for _, child in ipairs(entitiesFolder:GetChildren()) do
                        if child:IsA("Model") and (child:GetAttribute("id") == id or child.Name == id) then
                            model = child
                            break
                        end
                    end
                end
            end
        end

        if not (model and model.Parent) then return end
        if seenModels[model] then return end

        if model == LocalPlayer.Character or Players:GetPlayerFromCharacter(model) then return end
        if model:GetAttribute("Untargetable") then return end
        if model:GetAttribute("Dead") or model:GetAttribute("IsDead") then return end

        local hum = model:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health <= 0 then return end

        if unitData and (not unitData.Model or unitData.Model ~= model) then
            unitData.Model = model
        end

        local health = toNumber(unitData and unitData.Health) or (hum and hum.Health) or 0
        if health <= 0 and (not hum or hum.Health <= 0) then return end

        local maxHealth = toNumber(unitData and unitData.MaxHealth) or (hum and hum.MaxHealth) or health
        local tempHealth = toNumber(unitData and unitData.TempHealth) or 0
        local speed = toNumber(unitData and unitData.Speed) or 0

        local handCount, handKnown = 0, false
        if unitData and type(unitData.Hand) == "table" then
            handCount, handKnown = #unitData.Hand, true
        elseif frame then
            local holder = frame:FindFirstChild("CardsInHand")
            local label = holder and holder:FindFirstChild("Label")
            local n = label and tonumber(label.Text)
            if n then handCount, handKnown = math.max(0, n), true end
        end

        local staggered = isEnemyStaggered(unitData, model)
        local defending = (not staggered) and handKnown and handCount > 0
            and isEnemyCardDefensiveOrEvasive(unitData)

        local threatScore, offensiveCards, scanned, topCard, profile = 0, handCount, 0, 0, {}
        if handKnown and handCount > 0 then
            threatScore, offensiveCards, scanned, topCard, profile = estimateEnemyThreat(unitData)
            if scanned == 0 then offensiveCards = handCount end
        end
        if staggered then
            offensiveCards, threatScore, topCard = 0, 0, 0
        elseif defending then
            offensiveCards = 0
        end

        seenIds[id] = true
        seenModels[model] = true

        local rawName = (unitData and unitData.DisplayName) or model:GetAttribute("DisplayName") or model.Name
        local shortId = tostring(id):sub(1, 6)
        local uniqueDisplayName = string.format("%s [%s]", rawName, shortId)

        table.insert(enemies, {
            Id = id,
            Name = uniqueDisplayName,
            DisplayName = rawName,
            UnitData = unitData,
            Model = model,
            HandCount = handCount,
            HandKnown = handKnown,
            Health = health,
            MaxHealth = maxHealth,
            TempHealth = tempHealth,
            EffectiveHP = health + tempHealth,
            Speed = speed,
            IsStaggered = staggered,
            IsDefendingOrEvading = defending,
            OffensiveThreats = offensiveCards,
            ThreatScore = threatScore,
            TopCardThreat = topCard,
            DamageProfileString = profileToString(profile),
        })
    end

    if entitiesFolder then
        for _, ent in ipairs(entitiesFolder:GetChildren()) do
            if ent:IsA("Model") and ent ~= LocalPlayer.Character and not Players:GetPlayerFromCharacter(ent) then
                local mId = ent:GetAttribute("id") or ent.Name
                local uData, resolvedId = findUnitDataForModel(ent, mId)
                local frame = EnemyContainer:FindFirstChild(resolvedId) or EnemyContainer:FindFirstChild(mId)
                addEnemy(resolvedId or mId, uData, ent, frame)
            end
        end
    end

    for _, frame in ipairs(EnemyContainer:GetChildren()) do
        if frame:IsA("Frame") and frame.Name ~= "" then
            local uData = CachedBattleUnits[frame.Name]
            addEnemy(frame.Name, uData, uData and uData.Model, frame)
        end
    end

    for id, uData in pairs(CachedBattleUnits) do
        if type(uData) == "table" then
            local frame = EnemyContainer:FindFirstChild(id)
            addEnemy(id, uData, uData.Model, frame)
        end
    end

    return enemies
end

----------------------------------------------------------------------
-- CLASH EVALUATION
----------------------------------------------------------------------
local function evaluateClash(cardObj, enemy)
    if not enemy or enemy.IsStaggered or (enemy.HandKnown and enemy.HandCount == 0) then
        return 5, cardObj.MaxPower, nil, "Unopposed"
    end

    local prediction = nil
    if enemy.Model then
        pcall(function()
            prediction = clashPredictor:InvokeServer(cardObj.BasePower, cardObj.MaxPower, cardObj.RawData, enemy.Model)
        end)
    end

    if type(prediction) == "table" then
        local pBase = toNumber(prediction.PlayerBaseValue) or cardObj.BasePower
        local eBase = toNumber(prediction.EnemyBaseValue) or 0
        local eMax = toNumber(prediction.EnemyMaxValue) or 0
        local score = toNumber(prediction.Score) or 0

        if math.max(eBase, eMax) < pBase then
            return 5, 1000 + score, prediction, "Certain Victory"
        elseif score > CLASH_OVERWHELM_SCORE then
            return 4, 500 + score, prediction, "Overwhelming Advantage"
        elseif score > CLASH_ADVANTAGE_SCORE then
            return 3, 200 + score, prediction, "Advantaged"
        elseif score >= CLASH_RISKY_SCORE then
            return 2, 50 + score, prediction, "Risky"
        else
            return 1, score, prediction, "Desperate/Hopeless"
        end
    end

    return 3, cardObj.MaxPower, nil, "No Prediction"
end

----------------------------------------------------------------------
-- COMBAT CARD SELECTION (With Flat & PCT E.G.O Threat Gates)
----------------------------------------------------------------------
local function selectCardForEnemy(cardsInHand, targetEnemy, isOpposed)
    if #cardsInHand == 0 then return nil end

    local offensives, defenses = {}, {}
    for _, card in ipairs(cardsInHand) do
        if card.IsDefenseOrEvade then
            table.insert(defenses, card)
        else
            table.insert(offensives, card)
        end
    end
    table.sort(offensives, function(a, b)
        if a.MaxPower ~= b.MaxPower then return a.MaxPower > b.MaxPower end
        return a.Cost < b.Cost
    end)
    table.sort(defenses, function(a, b) return a.MaxPower > b.MaxPower end)

    local bestDefense = defenses[1]
    local bestEvade = nil
    for _, d in ipairs(defenses) do
        if d.DefenseKind == "Evade" then bestEvade = d break end
    end

    local canDefend = (#defenses > KEEP_DEFENSE_RESERVE)
    local safe = canDefend
        and ((PREFER_EVADE_OVER_GUARD and (bestEvade or bestDefense)) or (bestDefense or bestEvade))
        or nil

    -- Staggered / Unopposed Target Logic
    if targetEnemy.IsStaggered or targetEnemy.HandCount == 0 or not isOpposed then
        if targetEnemy.IsDefendingOrEvading and targetEnemy.HandCount > 0 and not targetEnemy.IsStaggered then
            -- Fall through to clash calculation
        else
            if #offensives > 0 then
                local eRes = getUnitResistances(targetEnemy.UnitData)
                local chosen, chosenDmg = offensives[1], -1
                for _, c in ipairs(offensives) do
                    local d = expectedDamage(c, eRes)
                    if d > chosenDmg then chosen, chosenDmg = c, d end
                end
                Log("THINK", string.format("Target %s is %s. Best damage: <font color='#B388FF'>%s</font> (~%d Dmg).",
                    targetEnemy.Name, targetEnemy.IsStaggered and "STAGGERED" or "UNOPPOSED", chosen.Name, math.floor(chosenDmg)), "#B0BEC5")
                return chosen
            end
            if PLAY_LEFTOVER_EVADES and bestEvade then return bestEvade end
            return bestDefense
        end
    end

    if targetEnemy.IsDefendingOrEvading then
        if canDefend and bestDefense then return bestDefense end
        if #offensives > 0 then return offensives[#offensives] end
    end

    -- 1. Evaluate Normal Hand Attacks
    local scored = {}
    for _, card in ipairs(offensives) do
        local rank, score, _, verdict = evaluateClash(card, targetEnemy)
        table.insert(scored, { Card = card, Rank = rank, Score = score, Verdict = verdict })
    end

    table.sort(scored, function(a, b)
        if a.Rank ~= b.Rank then return a.Rank > b.Rank end
        return a.Score > b.Score
    end)

    local bestNormal = scored[1]

    -- If normal attack wins the clash (Advantaged / Overwhelming / Certain Victory)
    if bestNormal and bestNormal.Rank > DEFENSE_SWAP_MAX_RANK then
        Log("PREDICT", string.format("Clash vs %s -> <font color='#B388FF'>%s</font> [<b>%s</b>, Score: %d].",
            targetEnemy.Name, bestNormal.Card.Name, bestNormal.Verdict, math.floor(bestNormal.Score)), "#2ECC71")
        return bestNormal.Card
    end

    -- =========================================================================
    -- 2. SMART THREAT-GATED E.G.O CLASH SOLVER (Flat & PCT Thresholds)
    -- =========================================================================
    if AUTO_USE_EGO and (EGO_USAGE_MODE == "Emergency" or EGO_USAGE_MODE == "Always") then
        local currentPosture = getPlayerPosture() or 0
        local currentHp = toNumber(PlayerStats.Health) or 100
        local maxHp = toNumber(PlayerStats.MaxHealth) or currentHp

        if currentPosture >= EGO_MIN_POSTURE_LIMIT then
            -- Calculate incoming enemy damage and its percentage of your Max HP
            local incomingDamage = calculateEnemyIncomingDamage(targetEnemy)
            local incomingPct = (maxHp > 0) and ((incomingDamage / maxHp) * 100) or 0

            local isLethalRisk = EGO_USE_ON_LETHAL and (incomingDamage >= currentHp)
            local isFlatThreat = (EGO_MIN_THREAT_DAMAGE > 0) and (incomingDamage >= EGO_MIN_THREAT_DAMAGE)
            local isPctThreat  = (EGO_MIN_THREAT_DAMAGE_PCT > 0) and (incomingPct >= EGO_MIN_THREAT_DAMAGE_PCT)

            local isHighThreat = isFlatThreat or isPctThreat

            -- Only consider burning an E.G.O if the incoming hit is legitimately dangerous
            if isHighThreat or isLethalRisk then
                local egoCards = getEGOCards()
                local egoScored = {}

                for _, egoCard in ipairs(egoCards) do
                    local rank, score, _, verdict = evaluateClash(egoCard, targetEnemy)
                    table.insert(egoScored, { Card = egoCard, Rank = rank, Score = score, Verdict = verdict })
                end

                table.sort(egoScored, function(a, b)
                    if a.Rank ~= b.Rank then return a.Rank > b.Rank end
                    return a.Score > b.Score
                end)

                local bestEGO = egoScored[1]
                if bestEGO and bestEGO.Rank > DEFENSE_SWAP_MAX_RANK then
                    local threatReason = isLethalRisk and "LETHAL RISK"
                        or (isPctThreat and string.format("%.1f%% Max HP", incomingPct)
                        or string.format("%d Dmg", math.floor(incomingDamage)))
                        
                    Log("EGO", string.format("Threat (%s) -> Deployed E.G.O: <font color='#FFD54F'><b>%s</b></font> [<b>%s</b>]!",
                        threatReason, bestEGO.Card.Name, bestEGO.Verdict), "#FFD54F")
                    return bestEGO.Card
                end
            else
                Log("THINK", string.format("Enemy attack is low threat (~%d Dmg, %.1f%% HP). Conserving E.G.O...",
                    math.floor(incomingDamage), incomingPct), "#B0BEC5")
            end
        end
    end

    -- =========================================================================
    -- 3. FALLBACK: TANK / EVADE / GUARD
    -- =========================================================================
    if bestNormal then
        Log("PREDICT", string.format("Clash vs %s -> <font color='#B388FF'>%s</font> [<b>%s</b>, Score: %d].",
            targetEnemy.Name, bestNormal.Card.Name, bestNormal.Verdict, math.floor(bestNormal.Score)), "#EB4D4B")

        if safe then
            Log("DEFENSE", string.format("Clash unsafe. Conserving E.G.O -> Defensive: <font color='#CE93D8'>%s</font>.", safe.Name), "#BA68C8")
            return safe
        end

        return bestNormal.Card
    end

    return safe or bestDefense
end

----------------------------------------------------------------------
-- HARDENED COMBAT TURN ENGINE
----------------------------------------------------------------------
local function tryEndTurn()
    task.wait(ACTION_DELAY)
    
    local endWaitStart = os.clock()
    while LocalPlayer:GetAttribute("Active") and (os.clock() - endWaitStart < CLASH_MAX_TIMEOUT) do
        if not LocalPlayer:GetAttribute("IsYourTurn") or not CombatGui.Enabled or isPlayerDead() then
            break
        end
        task.wait(0.1)
    end
    LocalPlayer:SetAttribute("Active", false)

    if IsBotRunning and CombatMode > 0
        and LocalPlayer:GetAttribute("IsYourTurn")
        and CombatGui.Enabled then
        Log("TURN", "Turn completed. Sending EndTurn request...", "#90A4AE")
        endTurn:FireServer()
        task.wait(END_TURN_COOLDOWN)
    end
end

local function processTurn()
    if isPlayerDead() then return end
    if not (LocalPlayer:GetAttribute("IsYourTurn") and CombatGui.Enabled) then return end

    if not ableToPlay() then
        if LocalPlayer:GetAttribute("Active") then
            local clashWait = os.clock()
            while LocalPlayer:GetAttribute("Active") and (os.clock() - clashWait < CLASH_MAX_TIMEOUT) do
                if not LocalPlayer:GetAttribute("IsYourTurn") or not CombatGui.Enabled or isPlayerDead() then return end
                task.wait(0.1)
            end
            LocalPlayer:SetAttribute("Active", false)
        else
            return
        end
    end

    Log("TURN", "Player turn detected. Inspecting battlefield...", "#8A5CFF")

    if SyncHoldSince == nil then SyncHoldSince = os.clock() end
    local lastHoldLog, dataFound = 0, false
    while os.clock() - SyncHoldSince < ENCOUNTER_SYNC_TIMEOUT do
        if isPlayerDead() then return end
        local enemiesNow = getAliveEnemies()
        if #enemiesNow > 0 then
            local anyHand = false
            for _, e in ipairs(enemiesNow) do
                if e.HandKnown then anyHand = true break end
            end
            if anyHand then
                dataFound = true
                break
            end
        end
        if not IsBotRunning or not LocalPlayer:GetAttribute("IsYourTurn") then
            SyncHoldSince = nil
            return
        end
        if os.clock() - lastHoldLog > SYNC_LOG_THROTTLE then
            Log("WAIT", string.format("Encounter loading (units: %d). Holding turn...", #enemiesNow), "#FFD54F")
            lastHoldLog = os.clock()
        end
        task.wait(0.2)
    end

    SyncHoldSince = nil
    if dataFound and LocalPlayer:GetAttribute("IsYourTurn") then
        task.wait(SYNC_SETTLE_DELAY)
    end

    local graceStart = os.clock()
    while os.clock() - graceStart < TURN_GRACE_TIME do
        if isPlayerDead() then return end
        if #getCardsInHand() > 0 and #getAliveEnemies() > 0 then break end
        task.wait(0.1)
    end

    local enemies = getAliveEnemies()
    local cardsInHand = getCardsInHand()

    if #enemies == 0 or #cardsInHand == 0 then
        tryEndTurn()
        return
    end

    local pendingThreats, pendingThreatScore, timesTargeted = {}, {}, {}
    for _, enemy in ipairs(enemies) do
        pendingThreats[enemy.Id] = enemy.OffensiveThreats
        pendingThreatScore[enemy.Id] = enemy.ThreatScore
        timesTargeted[enemy.Id] = 0
    end

    local playedThisTurn = {}
    local actionsThisTurn = 0
    local turnDone = false
    local FocusTargetId = nil

    while (not turnDone)
        and actionsThisTurn < MAX_ACTIONS_PER_TURN
        and IsBotRunning
        and LocalPlayer:GetAttribute("IsYourTurn")
        and not isPlayerDead()
        and CombatGui.Enabled do

        if not ableToPlay() then
            if LocalPlayer:GetAttribute("Active") then
                local clashWait = os.clock()
                while LocalPlayer:GetAttribute("Active") and (os.clock() - clashWait < CLASH_MAX_TIMEOUT) do
                    if not LocalPlayer:GetAttribute("IsYourTurn") or not CombatGui.Enabled or isPlayerDead() then
                        turnDone = true
                        break
                    end
                    task.wait(0.1)
                end
                LocalPlayer:SetAttribute("Active", false)
                task.wait(ACTION_POST_DELAY)
            else
                turnDone = true
                break
            end
        end

        if not turnDone then
            enemies = getAliveEnemies()
            if #enemies == 0 then
                turnDone = true
            else
                cardsInHand = getCardsInHand()
                local available = {}
                for _, c in ipairs(cardsInHand) do
                    if not playedThisTurn[c.AttackId] then table.insert(available, c) end
                end

                if #available == 0 then
                    turnDone = true
                else
                    for _, enemy in ipairs(enemies) do
                        if pendingThreats[enemy.Id] == nil then
                            pendingThreats[enemy.Id] = enemy.OffensiveThreats
                            pendingThreatScore[enemy.Id] = enemy.ThreatScore
                            timesTargeted[enemy.Id] = 0
                        else
                            pendingThreats[enemy.Id] = math.min(pendingThreats[enemy.Id], enemy.OffensiveThreats)
                            pendingThreatScore[enemy.Id] = (pendingThreats[enemy.Id] == 0) and 0 or enemy.ThreatScore
                        end
                    end

                    local totalThreatsLeft = 0
                    for _, enemy in ipairs(enemies) do
                        totalThreatsLeft = totalThreatsLeft + (pendingThreats[enemy.Id] or 0)
                    end

                    local chosenEnemy = nil
                    local isOpposed = false

                    if CombatMode == 1 then
                        if totalThreatsLeft > 0 then
                            table.sort(enemies, function(a, b)
                                local aT, bT = pendingThreats[a.Id] or 0, pendingThreats[b.Id] or 0
                                local aS, bS = pendingThreatScore[a.Id] or 0, pendingThreatScore[b.Id] or 0
                                local aH, bH = timesTargeted[a.Id] or 0, timesTargeted[b.Id] or 0
                                if (aT > 0) ~= (bT > 0) then return aT > 0 end
                                if aS ~= bS then return aS > bS end
                                if TARGET_STAGGERED_FIRST and a.IsStaggered ~= b.IsStaggered then return a.IsStaggered end
                                if aH ~= bH then return aH < bH end
                                if THREAT_TIEBREAK_SPEED and a.Speed ~= b.Speed then return a.Speed > b.Speed end
                                return a.Id < b.Id
                            end)
                            chosenEnemy = enemies[1]
                            isOpposed = (pendingThreats[chosenEnemy.Id] or 0) > 0
                                and chosenEnemy.HandCount > 0 and not chosenEnemy.IsStaggered
                        else
                            local hasOffense, strongest = false, 0
                            for _, c in ipairs(available) do
                                if not c.IsDefenseOrEvade then
                                    hasOffense = true
                                    if c.MaxPower > strongest then strongest = c.MaxPower end
                                end
                            end

                            local posture = getPlayerPosture()
                            if posture and posture < LOW_POSTURE_LIMIT then
                                turnDone = true
                            elseif hasOffense then
                                local killLine = strongest * KILL_MARGIN
                                table.sort(enemies, function(a, b)
                                    if TARGET_STAGGERED_FIRST and a.IsStaggered ~= b.IsStaggered then return a.IsStaggered end
                                    if TARGET_KILLABLE_FIRST then
                                        local aK, bK = a.EffectiveHP <= killLine, b.EffectiveHP <= killLine
                                        if aK ~= bK then return aK end
                                    end
                                    if a.EffectiveHP ~= b.EffectiveHP then return a.EffectiveHP < b.EffectiveHP end
                                    return a.Id < b.Id
                                end)
                                chosenEnemy = enemies[1]
                                isOpposed = chosenEnemy.HandCount > 0 and not chosenEnemy.IsStaggered
                            elseif PLAY_LEFTOVER_EVADES then
                                chosenEnemy = enemies[1]
                                isOpposed = false
                            else
                                turnDone = true
                            end
                        end
                    else
                        if AGGRO_FOCUS_FIRE and FocusTargetId then
                            for _, e in ipairs(enemies) do
                                if e.Id == FocusTargetId then chosenEnemy = e break end
                            end
                        end

                        if not chosenEnemy then
                            table.sort(enemies, function(a, b)
                                if TARGET_STAGGERED_FIRST and a.IsStaggered ~= b.IsStaggered then return a.IsStaggered end
                                local aS, bS = pendingThreatScore[a.Id] or 0, pendingThreatScore[b.Id] or 0
                                if aS ~= bS then return aS > bS end
                                if a.EffectiveHP ~= b.EffectiveHP then return a.EffectiveHP < b.EffectiveHP end
                                return a.Id < b.Id
                            end)
                            chosenEnemy = enemies[1]
                        end

                        if chosenEnemy then FocusTargetId = chosenEnemy.Id end
                        isOpposed = chosenEnemy and chosenEnemy.HandCount > 0 and not chosenEnemy.IsStaggered
                    end

                    if not chosenEnemy or not chosenEnemy.Model or not chosenEnemy.Model.Parent then
                        turnDone = true
                    else
                        if chosenEnemy.Model:GetAttribute("Untargetable") or chosenEnemy.Health <= 0 then
                            turnDone = true
                        else
                            timesTargeted[chosenEnemy.Id] = (timesTargeted[chosenEnemy.Id] or 0) + 1
                            pcall(function() LockOnSystem.setLockOn(chosenEnemy.Model, chosenEnemy.UnitData) end)
                            task.wait(ACTION_DELAY)

                            local cardToPlay = selectCardForEnemy(available, chosenEnemy, isOpposed)
                            if not cardToPlay or playedThisTurn[cardToPlay.AttackId] then
                                turnDone = true
                            else
                                local movementOk = true
                                if LockOnSystem and LockOnSystem.detectMovement then
                                    local okDetect, resDetect = pcall(LockOnSystem.detectMovement, cardToPlay.RawData)
                                    if okDetect and resDetect == false then
                                        movementOk = false
                                    end
                                end

                                if not movementOk then
                                    Log("WARN", string.format("Movement cannot reach %s with %s.", chosenEnemy.Name, cardToPlay.Name), "#FFD54F")
                                    playedThisTurn[cardToPlay.AttackId] = true
                                else
                                    local targetId = chosenEnemy.Model:GetAttribute("id") or chosenEnemy.Id
                                    LocalPlayer:SetAttribute("Active", true)
                                    actionsThisTurn = actionsThisTurn + 1

                                    Log("EXEC", string.format("Playing <font color='#B388FF'><b>%s</b></font> on %s...",
                                        cardToPlay.Name, chosenEnemy.Name), "#B388FF")

                                    if cardToPlay.Source == "EGO" then
                                        playEGOAttack:FireServer(cardToPlay.RawData.Name or cardToPlay.Name, cardToPlay.AttackId, targetId)
                                    else
                                        playAttack:FireServer(cardToPlay.AttackId, targetId)
                                    end

                                    playedThisTurn[cardToPlay.AttackId] = true
                                    if cardToPlay.Button then pcall(function() cardToPlay.Button:Destroy() end) end

                                    if (pendingThreats[chosenEnemy.Id] or 0) > 0 then
                                        pendingThreats[chosenEnemy.Id] = pendingThreats[chosenEnemy.Id] - 1
                                    end

                                    local t0 = os.clock()
                                    task.wait(0.15)
                                    while (os.clock() - t0 < CLASH_MAX_TIMEOUT) do
                                        if not LocalPlayer:GetAttribute("Active") then
                                            break
                                        end
                                        if not LocalPlayer:GetAttribute("IsYourTurn") then
                                            break
                                        end
                                        if not CombatGui.Enabled or not HandContainer.Visible then
                                            break
                                        end
                                        if isPlayerDead() then
                                            break
                                        end
                                        task.wait(0.1)
                                    end

                                    LocalPlayer:SetAttribute("Active", false)
                                    task.wait(ACTION_POST_DELAY)
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    tryEndTurn()
end

