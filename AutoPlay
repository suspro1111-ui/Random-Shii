local function toNumber(v)
    if type(v) == "number" then return v end
    if type(v) == "string" then return tonumber(v) end
    return nil
end

local function isPlayerDead()
    if not STOP_ON_DEATH then return false end
    
    local char = LocalPlayer.Character
    if not (char and char.Parent) then return true end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return true end

    local pHealth = toNumber(PlayerStats.Health)
    if pHealth and pHealth <= 0 then return true end

    return false
end

local function ableToPlay(): boolean
    if LocalPlayer:GetAttribute("ignore") then return true end
    if LocalPlayer:GetAttribute("IsInTutorial") then return false end
    if not LocalPlayer:GetAttribute("IsYourTurn") then return false end
    if LocalPlayer:GetAttribute("Active") then return false end
    return true
end

