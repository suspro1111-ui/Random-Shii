local function colorMatch(a, b)
    local tol = 18 / 255
    return math.abs(a.R - b.R) <= tol and math.abs(a.G - b.G) <= tol and math.abs(a.B - b.B) <= tol
end

function Dungeon.isNodeSelectable(rec)
    if not rec then return false end
    local name = rec.Name
    if State.FinishedNodes[name] then return false end
    if Config.NODE_AVOID_USED and Refs.PlayerStats.DungeonNodes and Refs.PlayerStats.DungeonNodes[name] then
        State.FinishedNodes[name] = true
        return false
    end

    -- Strict check: never select nodes if in active combat, in transition, or during modals
    if Combat.isInActiveCombat() then return false end
    if Dungeon.isInTransition() then return false end
    if Dungeon.isAnyModalOpen() then return false end

    local curRow = State.FurthestRow
    if Refs.PlayerStats and Utils.toNumber(Refs.PlayerStats.FurthestNodeRow) then
        curRow = math.max(curRow, Utils.toNumber(Refs.PlayerStats.FurthestNodeRow))
    end
    if Config.NODE_STRICT_ROW_LOCK and curRow > 0 then
        if rec.Row ~= curRow then return false end
    elseif curRow > 0 and rec.Row > curRow then
        return false
    end

    if rec.Parent and Refs.PlayerStats.DungeonNodes and Refs.PlayerStats.DungeonNodes[rec.Parent] then return false end

    local frame = rec.Frame or Refs.DungeonNodeContainer:FindFirstChild(name)
    if not (frame and frame.Parent and frame.Visible) then return false end

    local bg = frame:FindFirstChild("bg")
    if bg and bg:IsA("GuiObject") then
        local col = bg.BackgroundColor3
        if colorMatch(col, INACTIVE_COLOR) or (col.R < 0.35 and col.G < 0.35 and col.B < 0.35) then return false end
        if not (colorMatch(col, ACTIVE_COLOR) or (col.R > 0.5 and col.G > 0.5)) then return false end
    end

    return true
end

local ChildrenOf, simMemo = {}, {}
local EMPTY_FUTURE = { pos = 0, neg = 0, valuable = 0, raw = 0, via = nil }

function Dungeon.bestFutureFrom(name, depth)
    depth = depth or Config.SMART_SYNERGY.MAX_DEPTH
    local key = name .. "@" .. depth
    local memo = simMemo[key]
    if memo then return memo end

    local best = { pos = 0, neg = 0, valuable = 0, raw = 0, via = nil }
    simMemo[key] = best

    local kids = ChildrenOf[name]
    if kids then
        for _, kid in ipairs(kids) do
            local w = Config.SMART_PATH_WEIGHTS[kid.Type] or 0
            local pos, neg, val = 0, 0, 0
            if w >= 0 then
                pos = w
                if w >= Config.SMART_SYNERGY.VALUABLE_MIN then val = 1 end
            else
                neg = w
            end
            local sub = (depth > 1) and Dungeon.bestFutureFrom(kid.Name, depth - 1) or EMPTY_FUTURE
            local entry = {
                pos = pos + sub.pos,
                neg = neg + sub.neg,
                valuable = val + sub.valuable,
                via = kid.Name,
                raw = pos + sub.pos + neg + sub.neg,
            }
            if best.via == nil or entry.raw > best.raw or (entry.raw == best.raw and entry.valuable > best.valuable) then
                best = entry
                simMemo[key] = best
            end
        end
    end
    return best
end

function Dungeon.AutoNodeThink()
    if Utils.isPlayerDead() then return nil end
    if Combat.isInActiveCombat() then return nil end
    if Dungeon.isInTransition() then return nil end
    if Dungeon.isAnyModalOpen() then return nil end
    if not (Refs.DungeonGui and Refs.DungeonGui.Enabled and Refs.DungeonNodeContainer and Refs.DungeonNodeContainer.Visible) then return nil end

    -- Rebuild Graph
    ChildrenOf, simMemo = {}, {}
    local parentless = {}
    for _, rec in pairs(State.NodeGraph) do
        if not State.FinishedNodes[rec.Name] then
            if rec.Parent and State.NodeGraph[rec.Parent] and not State.FinishedNodes[rec.Parent] then
                ChildrenOf[rec.Parent] = ChildrenOf[rec.Parent] or {}
                table.insert(ChildrenOf[rec.Parent], rec)
            else
                table.insert(parentless, rec)
            end
        end
    end
    for _, rec in ipairs(parentless) do
        local best, bestDist = nil, math.huge
        for _, other in pairs(State.NodeGraph) do
            if other ~= rec and other.Row == rec.Row - 1 and not State.FinishedNodes[other.Name] then
                local d = math.abs(other.X - rec.X) + math.abs(other.Y - rec.Y)
                if d < bestDist then best, bestDist = other, d end
            end
        end
        if best then
            ChildrenOf[best.Name] = ChildrenOf[best.Name] or {}
            table.insert(ChildrenOf[best.Name], rec)
        end
    end

    -- Refresh & Get Candidates
    for _, frame in ipairs(Refs.DungeonNodeContainer:GetChildren()) do
        if frame:IsA("Frame") and frame.Name ~= "Fog" and (frame:FindFirstChild("Confirm") or frame:FindFirstChild("NodeImage")) then
            local rec = State.NodeGraph[frame.Name]
            if rec then
                rec.Frame = frame
                if rec.Row == 0 then rec.Row = Utils.toNumber(frame:GetAttribute("Furthest")) or rec.Row end
            else
                Dungeon.registerNode(frame.Name, {})
            end
        end
    end

    local candidates = {}
    for _, rec in pairs(State.NodeGraph) do
        if Dungeon.isNodeSelectable(rec) then table.insert(candidates, rec) end
    end
    if State.FurthestRow <= 0 and #candidates > 0 then
        local minRow = math.huge
        for _, r in ipairs(candidates) do minRow = math.min(minRow, r.Row) end
        for i = #candidates, 1, -1 do if candidates[i].Row > minRow then table.remove(candidates, i) end end
    end
    table.sort(candidates, function(a, b) return a.Name < b.Name end)

    if #candidates == 0 then return nil end
    if #candidates == 1 then return candidates[1] end

    local hp = Utils.toNumber(Refs.PlayerStats.Health) or 100
    local maxHp = Utils.toNumber(Refs.PlayerStats.MaxHealth) or hp
    local hpPct = (maxHp > 0) and ((hp / maxHp) * 100) or 100

    local scored = {}
    for _, rec in ipairs(candidates) do
        local sim = Dungeon.bestFutureFrom(rec.Name, Config.SMART_SYNERGY.MAX_DEPTH)
        local factor = (sim.valuable >= Config.SMART_SYNERGY.FULL_SUPPORT and 1.0)
            or (sim.valuable == 1 and Config.SMART_SYNERGY.LONE_SUPPORT) or 0.0
        local imm = Config.NODE_TYPE_PRIORITIES[rec.Type] or Config.SMART_SYNERGY.UNKNOWN_TYPE
        if rec.Type == "Rest" and hpPct <= Config.EMERGENCY_REST_HP_PCT then imm += 600
        elseif rec.Type == "Elite" and hpPct <= Config.EMERGENCY_REST_HP_PCT then imm -= 200 end

        local future = (sim.pos * factor) + sim.neg
        table.insert(scored, { rec = rec, sim = sim, factor = factor, imm = imm, future = future, total = imm + future })
    end

    table.sort(scored, function(a, b)
        if math.abs(a.total - b.total) > 0.01 then return a.total > b.total end
        if a.imm ~= b.imm then return a.imm > b.imm end
        return a.rec.Name < b.rec.Name
    end)

    local winner = scored[1]
    local now = os.clock()
    if winner.rec.Name ~= State.LastDecisionKey or now - State.LastDecisionLogAt > 5 then
        State.LastDecisionKey, State.LastDecisionLogAt = winner.rec.Name, now
        if Config.PATH_VERBOSE then
            for i, s in ipairs(scored) do
                UI.Log("PATH", string.format("%s %s [%s] now %d + future %.1f (x%.2f) = <b>%.1f</b>",
                    (i == 1) and ">>" or "  ", s.rec.Name, s.rec.Type, s.imm, s.future, s.factor, s.total),
                    (i == 1) and "#2ECC71" or "#90A4AE")
            end
        end
    end
    return winner.rec
end

function Dungeon.embarkToNode(rec)
    if Utils.isPlayerDead() then return false end
    if Combat.isInActiveCombat() then return false end
    if Dungeon.isInTransition() then return false end
    if Dungeon.isAnyModalOpen() then return false end
    if not (rec and rec.Frame and rec.Frame.Parent and rec.Frame.Visible) then return false end

    local now = os.clock()
    if now - State.LastEmbarkAt < Config.AUTO_NODE_DELAY then return false end
    if State.LastEmbarkName == rec.Name and now - State.LastEmbarkAt < Config.EMBARK_RETRY_COOLDOWN then return false end
    if not Dungeon.isNodeSelectable(rec) then return false end

    State.LastEmbarkName, State.LastEmbarkAt = rec.Name, now

    local confirmBtn = rec.Frame:FindFirstChild("Confirm")
    if confirmBtn and (confirmBtn:IsA("GuiButton") or confirmBtn:IsA("TextButton") or confirmBtn:IsA("ImageButton")) and confirmBtn.Visible then
        Utils.fireButtonClick(confirmBtn)
    end

    local voteEv = Refs.Events:FindFirstChild("VoteForNode")
    if voteEv and voteEv:IsA("RemoteEvent") then
        pcall(function() voteEv:FireServer(rec.Name) end)
    else
        local legacy = Refs.Events:FindFirstChild("NodeSelect")
        if legacy and legacy:IsA("RemoteEvent") then
            pcall(function() legacy:FireServer(type(rec.Raw) == "table" and rec.Raw or rec.Name) end)
        end
    end

    UI.Log("NODE", string.format("Embarking -> <font color='#CE93D8'><b>%s</b></font> (%s, Row: %d).",
        rec.Name, rec.Type, rec.Row), "#2ECC71")
    return true
end

