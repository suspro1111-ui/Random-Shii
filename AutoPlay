local function refreshNodeFrames()
    for _, frame in ipairs(DungeonNodeContainer:GetChildren()) do
        if frame:IsA("Frame") and frame.Name ~= "Fog"
            and (frame:FindFirstChild("Confirm") or frame:FindFirstChild("NodeImage")) then
            local rec = NodeGraph[frame.Name]
            if rec then
                rec.Frame = frame
                if rec.Row == 0 then rec.Row = toNumber(frame:GetAttribute("Furthest")) or rec.Row end
            else
                registerNode(frame.Name, {})
            end
        end
    end
end

local function colorMatch(a, b)
    local tol = 18 / 255
    return math.abs(a.R - b.R) <= tol and math.abs(a.G - b.G) <= tol and math.abs(a.B - b.B) <= tol
end

----------------------------------------------------------------------
-- STRICT GUARDRAIL NODE SELECTABILITY CHECK
----------------------------------------------------------------------
local function isNodeSelectable(rec)
    if not rec then return false end
    local name = rec.Name

    if FinishedNodes[name] then return false end
    if NODE_AVOID_USED and PlayerStats.DungeonNodes and PlayerStats.DungeonNodes[name] then
        FinishedNodes[name] = true
        return false
    end

    local curRow = FurthestRow
    if toNumber(PlayerStats.FurthestNodeRow) then
        curRow = math.max(curRow, toNumber(PlayerStats.FurthestNodeRow))
    end
    
    if NODE_STRICT_ROW_LOCK and curRow > 0 then
        if rec.Row ~= curRow then
            return false
        end
    elseif curRow > 0 and rec.Row > curRow then
        return false
    end

    if rec.Parent and PlayerStats.DungeonNodes and PlayerStats.DungeonNodes[rec.Parent] then
        return false
    end

    local frame = rec.Frame or DungeonNodeContainer:FindFirstChild(name)
    if not (frame and frame.Parent and frame.Visible) then return false end

    local bg = frame:FindFirstChild("bg")
    if bg and bg:IsA("GuiObject") then
        local col = bg.BackgroundColor3
        if colorMatch(col, INACTIVE_COLOR) or (col.R < 0.35 and col.G < 0.35 and col.B < 0.35) then
            return false
        end
        if not (colorMatch(col, ACTIVE_COLOR) or (col.R > 0.5 and col.G > 0.5)) then
            return false
        end
    end

    if TransitionGui and TransitionGui.Enabled then return false end
    if DialogueContainer and DialogueContainer.Visible then return false end
    local restC = DungeonGui:FindFirstChild("RestContainer") or DungeonGui:FindFirstChild("RestFrame")
    if restC and restC.Visible then return false end
    local rewF = DungeonGui:FindFirstChild("RewardFrame")
    if rewF and rewF.Visible then return false end
    local bossF = DungeonGui:FindFirstChild("PickBossFrame")
    if bossF and bossF.Visible then return false end

    return true
end

local function getCandidateNodes()
    refreshNodeFrames()
    local list = {}
    for _, rec in pairs(NodeGraph) do
        if isNodeSelectable(rec) then table.insert(list, rec) end
    end
    if FurthestRow <= 0 and #list > 0 then
        local minRow = math.huge
        for _, r in ipairs(list) do minRow = math.min(minRow, r.Row) end
        for i = #list, 1, -1 do
            if list[i].Row > minRow then table.remove(list, i) end
        end
    end
    table.sort(list, function(a, b) return a.Name < b.Name end)
    return list
end

----------------------------------------------------------------------
-- FORWARD PATH SIMULATION (DFS)
----------------------------------------------------------------------
local ChildrenOf, simMemo = {}, {}
local EMPTY_FUTURE = { pos = 0, neg = 0, valuable = 0, raw = 0, via = nil }

local function rebuildGraph()
    ChildrenOf, simMemo = {}, {}
    local parentless = {}
    for _, rec in pairs(NodeGraph) do
        if not FinishedNodes[rec.Name] then
            if rec.Parent and NodeGraph[rec.Parent] and not FinishedNodes[rec.Parent] then
                ChildrenOf[rec.Parent] = ChildrenOf[rec.Parent] or {}
                table.insert(ChildrenOf[rec.Parent], rec)
            else
                table.insert(parentless, rec)
            end
        end
    end
    for _, rec in ipairs(parentless) do
        local best, bestDist = nil, math.huge
        for _, other in pairs(NodeGraph) do
            if other ~= rec and other.Row == rec.Row - 1 and not FinishedNodes[other.Name] then
                local d = math.abs(other.X - rec.X) + math.abs(other.Y - rec.Y)
                if d < bestDist then best, bestDist = other, d end
            end
        end
        if best then
            ChildrenOf[best.Name] = ChildrenOf[best.Name] or {}
            table.insert(ChildrenOf[best.Name], rec)
        end
    end
end

local function bestFutureFrom(name, depth)
    depth = depth or SMART_SYNERGY.MAX_DEPTH
    local key = name .. "@" .. depth
    local memo = simMemo[key]
    if memo then return memo end

    local best = { pos = 0, neg = 0, valuable = 0, raw = 0, via = nil }
    simMemo[key] = best

    local kids = ChildrenOf[name]
    if kids then
        for _, kid in ipairs(kids) do
            local w = SMART_PATH_WEIGHTS[kid.Type] or 0
            local pos, neg, val = 0, 0, 0
            if w >= 0 then
                pos = w
                if w >= SMART_SYNERGY.VALUABLE_MIN then val = 1 end
            else
                neg = w
            end
            local sub = (depth > 1) and bestFutureFrom(kid.Name, depth - 1) or EMPTY_FUTURE
            local entry = {
                pos = pos + sub.pos,
                neg = neg + sub.neg,
                valuable = val + sub.valuable,
                via = kid.Name,
                raw = 0,
            }
            entry.raw = entry.pos + entry.neg
            if best.via == nil or entry.raw > best.raw
                or (entry.raw == best.raw and entry.valuable > best.valuable) then
                best = entry
                simMemo[key] = best
            end
        end
    end
    return best
end

local function supportFactor(valuableCount)
    if valuableCount >= SMART_SYNERGY.FULL_SUPPORT then return 1.0 end
    if valuableCount == 1 then return SMART_SYNERGY.LONE_SUPPORT end
    return 0.0
end

local function immediateScore(rec, hpPct)
    local s = NODE_TYPE_PRIORITIES[rec.Type] or SMART_SYNERGY.UNKNOWN_TYPE
    if rec.Type == "Rest" and hpPct <= EMERGENCY_REST_HP_PCT then
        s = s + 600
    elseif rec.Type == "Elite" and hpPct <= EMERGENCY_REST_HP_PCT then
        s = s - 200
    end
    return s
end

local function branchBias(rec)
    if PREFERRED_BRANCH == "Upper"  then return rec.Y end
    if PREFERRED_BRANCH == "Lower"  then return -rec.Y end
    if PREFERRED_BRANCH == "Center" then return math.abs(rec.Y - 0.5) end
    return 0
end

local function describeFuture(name)
    local hops, cur = {}, name
    local depth = SMART_SYNERGY.MAX_DEPTH
    for _ = 1, SMART_SYNERGY.MAX_DEPTH do
        local s = simMemo[cur .. "@" .. depth]
        if not s or not s.via then break end
        cur = s.via
        depth = depth - 1
        local rec = NodeGraph[cur]
        table.insert(hops, string.format("%s(%s)", cur, rec and rec.Type or "?"))
    end
    if #hops == 0 then return "end of mapped branch" end
    return table.concat(hops, " > ")
end

local LastDecisionKey, LastDecisionLogAt = nil, 0
local function shouldLogDecision(key)
    local now = os.clock()
    if key ~= LastDecisionKey or now - LastDecisionLogAt > 5 then
        LastDecisionKey, LastDecisionLogAt = key, now
        return true
    end
    return false
end

----------------------------------------------------------------------
-- AUTO-NODE DECISION ENGINE
----------------------------------------------------------------------
local function AutoNodeThink()
    if isPlayerDead() then return nil end

    rebuildGraph()
    local candidates = getCandidateNodes()
    if #candidates == 0 then return nil end
    if #candidates == 1 then return candidates[1] end

    if PREFERRED_BRANCH ~= "Smart" then
        table.sort(candidates, function(a, b)
            local ba, bb = branchBias(a), branchBias(b)
            if math.abs(ba - bb) > SMART_SYNERGY.LANE_TIEBREAK then return ba < bb end
            local pa = NODE_TYPE_PRIORITIES[a.Type] or SMART_SYNERGY.UNKNOWN_TYPE
            local pb = NODE_TYPE_PRIORITIES[b.Type] or SMART_SYNERGY.UNKNOWN_TYPE
            if pa ~= pb then return pa > pb end
            return a.Name < b.Name
        end)
        if shouldLogDecision(candidates[1].Name) then
            Log("PATH", string.format("Branch [%s] -> %s (%s).",
                PREFERRED_BRANCH, candidates[1].Name, candidates[1].Type), "#FFD54F")
        end
        return candidates[1]
    end

    local hpPct = currentHPPercent()
    local scored = {}
    for _, rec in ipairs(candidates) do
        local sim    = bestFutureFrom(rec.Name, SMART_SYNERGY.MAX_DEPTH)
        local factor = supportFactor(sim.valuable)
        local imm    = immediateScore(rec, hpPct)
        local future = (sim.pos * factor) + sim.neg
        table.insert(scored, {
            rec = rec,
            sim = sim,
            factor = factor,
            imm = imm,
            future = future,
            total = imm + future
        })
    end

    table.sort(scored, function(a, b)
        if math.abs(a.total - b.total) > 0.01 then return a.total > b.total end
        if a.imm ~= b.imm then return a.imm > b.imm end
        local ba, bb = branchBias(a.rec), branchBias(b.rec)
        if ba ~= bb then return ba < bb end
        return a.rec.Name < b.rec.Name
    end)

    local winner = scored[1]
    if shouldLogDecision(winner.rec.Name) then
        if PATH_VERBOSE then
            for i, s in ipairs(scored) do
                Log("PATH", string.format("%s %s [%s] now %d + future %.1f (x%.2f) = <b>%.1f</b>",
                    (i == 1) and ">>" or "  ", s.rec.Name, s.rec.Type,
                    s.imm, s.future, s.factor, s.total),
                    (i == 1) and "#2ECC71" or "#90A4AE")
            end
        end
        if PATH_LOG_ROUTE then
            Log("PATH", "Route: " .. describeFuture(winner.rec.Name), "#B388FF")
        end
        if winner.sim.valuable < SMART_SYNERGY.FULL_SUPPORT then
            Log("PATH", string.format("Thin future (<%d valuable nodes ahead): Current node priority decided.",
                SMART_SYNERGY.FULL_SUPPORT), "#FFD54F")
        end
    end
    return winner.rec
end

----------------------------------------------------------------------
-- EMBARK WITH COMPLETE VOTE & CONFIRM GUARDRAILS
----------------------------------------------------------------------
local LastEmbarkName, LastEmbarkAt = nil, 0
local function embarkToNode(rec)
    if isPlayerDead() then return false end
    if not (rec and rec.Frame and rec.Frame.Parent) then return false end
    
    local now = os.clock()
    if now - LastEmbarkAt < AUTO_NODE_DELAY then return false end
    if LastEmbarkName == rec.Name and now - LastEmbarkAt < EMBARK_RETRY_COOLDOWN then return false end

    if not isNodeSelectable(rec) then return false end

    local confirmBtn = rec.Frame:FindFirstChild("Confirm")
    if confirmBtn then
        fireButtonClick(confirmBtn)
    end

    local voteEv = Events:FindFirstChild("VoteForNode")
    if voteEv then
        pcall(function() voteEv:FireServer(rec.Name) end)
    else
        local legacy = Events:FindFirstChild("NodeSelect")
        if legacy then
            pcall(function() legacy:FireServer(type(rec.Raw) == "table" and rec.Raw or rec.Name) end)
        end
    end

    LastEmbarkName, LastEmbarkAt = rec.Name, now
    Log("NODE", string.format("Embarking -> <font color='#CE93D8'><b>%s</b></font> (%s, Row: %d).",
        rec.Name, rec.Type, rec.Row), "#2ECC71")
    return true
end

