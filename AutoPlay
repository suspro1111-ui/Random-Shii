    if ok and type(mod) == "table" then
        local valid = true
        for _, g in ipairs(GRADES) do
            local v = Utils.toNumber(mod[g])
            if v == nil or v <= 0 then valid = false break end
        end
        if valid then
            ResistTable = {}
            for _, g in ipairs(GRADES) do ResistTable[g] = Utils.toNumber(mod[g]) end
        end
    end
end

local function normalizeGrade(v)
    if type(v) == "string" then
        local g = v:gsub("%s+", "")
        if RESIST_WORDS[g] then return g end
    end
    return nil
end

function Combat.getPlayerResistances()
    if State.ResCache.Res and (os.clock() - State.ResCache.At) < Config.RESIST_CACHE_TIME then
        return State.ResCache.Res
    end

    local res = {
        Slash = normalizeGrade(Refs.PlayerStats.SlashPhysicalResist),
        Stab = normalizeGrade(Refs.PlayerStats.StabPhysicalResist),
        Strike = normalizeGrade(Refs.PlayerStats.StrikePhysicalResist),
    }

    if not (res.Slash and res.Stab and res.Strike) then
        local function fromLabel(labelName, key)
            if res[key] then return end
            local ok, txt = pcall(function()
                local list = Refs.CombatGui:FindFirstChild("AllyDataList")
                local cont = list and list:FindFirstChild("ResistancesContainer")
                local lbl = cont and cont:FindFirstChild(labelName)
                return lbl and lbl.Text
            end)
            if ok and type(txt) == "string" then res[key] = normalizeGrade(txt:match("^(%a+)")) end
        end
        fromLabel("SlashDefense", "Slash")
        fromLabel("StabDefense", "Stab")
        fromLabel("StrikeDefense", "Strike")
    end

    for _, t in ipairs(DAMAGE_TYPES) do if not res[t] then res[t] = "Normal" end end
    State.ResCache.Res = res
    State.ResCache.At = os.clock()
    return res
end

function Combat.getUnitResistances(unitData)
    local res = {
        Slash = normalizeGrade(unitData and unitData.SlashPhysicalResist),
        Stab = normalizeGrade(unitData and unitData.StabPhysicalResist),
        Strike = normalizeGrade(unitData and unitData.StrikePhysicalResist),
    }
    for _, t in ipairs(DAMAGE_TYPES) do if not res[t] then res[t] = "Normal" end end
    return res
end

local INTENT_DEF_WORDS = { evade = true, guard = true, defend = true, dodge = true }
local CARD_DEF_WORDS = { evade = true, dodge = true, guard = true, defend = true, shield = true, rewind = true, counter = true }

function Combat.parseCardData(rawCard, fallbackId)
    if type(rawCard) ~= "table" then return nil end

    local id = fallbackId or rawCard.AttackId or rawCard[3]
    local name = rawCard.Name or rawCard[7] or rawCard[6] or rawCard.DisplayName or rawCard[2] or "Action"

    local intentList = rawCard["Intent List"] or rawCard.IntentList
    if type(intentList) ~= "table" then
        if type(rawCard[5]) == "table" then intentList = rawCard[5]
        elseif type(rawCard[4]) == "table" then intentList = rawCard[4] end
    end

    local basePower = Utils.toNumber(rawCard["Base Power"]) or Utils.toNumber(rawCard.BasePower)
    if basePower == nil then basePower = Utils.toNumber(rawCard[4]) or Utils.toNumber(rawCard[3]) or 0 end

    local cost = Utils.toNumber(rawCard.Cost) or Utils.toNumber(rawCard[9]) or Utils.toNumber(rawCard[8]) or 0
    local rarity = Utils.toNumber(rawCard.Rarity) or Utils.toNumber(rawCard[8]) or Utils.toNumber(rawCard[7]) or 1
    local attackWeight = Utils.toNumber(rawCard["Attack Weight"]) or Utils.toNumber(rawCard.AttackWeight) or 1

    local coins, bonusSum, isDefense, defenseKind, intentCount = {}, 0, false, nil, 0
    if type(intentList) == "table" then
        for _, intent in ipairs(intentList) do
            if type(intent) == "table" then
                local bonus = Utils.toNumber(intent["Intent Bonus"]) or 0
                local damageType, role, defKind = nil, nil, nil

                local function classify(value)
                    if type(value) ~= "string" then return end
                    if value == "Attack" then if role == nil then role = "Attack" end return end
                    if value == "Defend" then if role == nil then role = "Defend" end return end
                    local alias = DAMAGE_TYPE_ALIAS[value]
                    if alias then if damageType == nil then damageType = alias end return end
                    local lv = value:lower()
                    if INTENT_DEF_WORDS[lv] and defKind == nil then
                        defKind = (lv == "evade" or lv == "dodge") and "Evade" or "Guard"
                    end
                end

                classify(intent["Intent Type"])
                classify(intent["Intent Damage"])
                for _, v in pairs(intent) do
                    if type(v) == "string" then classify(v)
                    elseif type(v) == "number" and bonus == 0 then bonus = v end
                end

                local isDef = (defKind ~= nil) or (role == "Defend")
                local isOff = (not isDef) and (role == "Attack" or damageType ~= nil)
                intentCount += 1
                bonusSum += bonus
                if isDef then
                    isDefense = true
                    if defenseKind == nil then defenseKind = defKind end
                end
                table.insert(coins, {
                    Bonus = bonus, DamageType = damageType, Role = role,
                    Kind = defKind, IsDefensive = isDef, IsOffensive = isOff,
                })
            end
        end
    end

    local lowerName = tostring(name):lower()
    for word in pairs(CARD_DEF_WORDS) do
        if lowerName:find(word, 1, true) then isDefense = true break end
    end

    local offensiveCoins = 0
    for _, c in ipairs(coins) do if c.IsOffensive then offensiveCoins += 1 end end
    if #coins == 0 and not isDefense then offensiveCoins = 1 end

    return {
        AttackId = tostring(id),
        Name = tostring(name),
        BasePower = basePower,
        MaxPower = basePower + bonusSum,
        BonusSum = bonusSum,
        Cost = cost,
        Rarity = rarity,
        IntentCount = intentCount,
        IsDefenseOrEvade = isDefense,
        DefenseKind = defenseKind,
        Coins = coins,
        OffensiveCoinCount = offensiveCoins,
        AttackWeight = attackWeight,
        RawData = rawCard,
        Button = nil,
        Source = nil,
    }
end

function Combat.getEnemyFirstCard(unitData)
    if type(unitData) ~= "table" or type(unitData.Hand) ~= "table" then return nil end
    return unitData.Hand[1] or select(2, next(unitData.Hand))
end

function Combat.calculateEnemyIncomingDamage(targetEnemy): number
    if not targetEnemy or not targetEnemy.UnitData then return 0 end
    local firstCard = Combat.getEnemyFirstCard(targetEnemy.UnitData)
    if not firstCard then return 0 end
    local card = Combat.parseCardData(firstCard)
    if not card then return 0 end

    local playerRes = Combat.getPlayerResistances()
    local totalDamage = 0

    for _, coin in ipairs(card.Coins) do
        if coin.IsOffensive then
            local coinPower = card.BasePower + coin.Bonus
            local mult = 1.0
            if coin.DamageType and playerRes[coin.DamageType] then
                mult = ResistTable[playerRes[coin.DamageType]] or 1.0
            end
            totalDamage = totalDamage + (coinPower * mult)
        end
    end

    if totalDamage <= 0 and card.MaxPower > 0 then totalDamage = card.MaxPower end
    return totalDamage
end

function Combat.estimateEnemyThreat(unitData)
    local res = Combat.getPlayerResistances()
    local score, offensiveCards, scanned, topCard = 0, 0, 0, 0
    local profile = {}

    local hand = unitData and unitData.Hand
    if type(hand) ~= "table" then return 0, 0, 0, 0, profile end

    for _, rawCard in ipairs(hand) do
        local card = Combat.parseCardData(rawCard)
        if card then
            scanned += 1
            if card.OffensiveCoinCount > 0 then
                offensiveCards += 1
                local cardScore = 0
                for _, coin in ipairs(card.Coins) do
                    if coin.IsOffensive then
                        local power = card.BasePower + coin.Bonus
                        if coin.DamageType then
                            power = power * (ResistTable[res[coin.DamageType]] or 1)
                            profile[coin.DamageType] = true
                        end
                        cardScore += power
                    end
                end
                score += cardScore
                if cardScore > topCard then topCard = cardScore end
            end
        end
    end

    return score, offensiveCards, scanned, topCard, profile
end

function Combat.expectedDamage(card, enemyRes)
    local total = 0
    for _, coin in ipairs(card.Coins) do
        if coin.IsOffensive then
            local power = card.BasePower + coin.Bonus
            if coin.DamageType then power = power * (ResistTable[enemyRes[coin.DamageType]] or 1) end
            total += power
        end
    end
    if total <= 0 then total = card.MaxPower end
    return total
end

function Combat.isEnemyStaggered(unitData, model)
    local targetModel = model or (unitData and unitData.Model)
    if targetModel then
        local hrp = targetModel:FindFirstChild("HumanoidRootPart") or targetModel.PrimaryPart
        local staggerFrames = Refs.CombatGui:FindFirstChild("StaggerFrames")
        if staggerFrames then
            local staggerTemplate = staggerFrames:FindFirstChild("StaggerTemplate")
            if staggerTemplate and staggerTemplate:IsA("BillboardGui") and staggerTemplate.Enabled then
                if (hrp and staggerTemplate.Adornee == hrp)
                    or (staggerTemplate.Adornee and (staggerTemplate.Adornee == targetModel or staggerTemplate.Adornee:IsDescendantOf(targetModel))) then
                    return true
                end
            end
            for _, frame in ipairs(staggerFrames:GetChildren()) do
                if frame:IsA("BillboardGui") and frame.Enabled and frame.Adornee then
                    if (hrp and frame.Adornee == hrp) or frame.Adornee == targetModel or frame.Adornee:IsDescendantOf(targetModel) then
                        return true
                    end
                end
            end
        end
        if targetModel:GetAttribute("Staggered") or targetModel:GetAttribute("StanceBreak") then return true end
    end
    if type(unitData) == "table" and type(unitData.Hand) == "table" and next(unitData.Hand) == nil then return true end
    return false
end

function Combat.getPlayerPosture()
    local ok, v = pcall(function() return Refs.PlayerStats.Posture end)
    if ok and type(v) == "number" then return v end
    local ok2, txt = pcall(function()
        local ally = Refs.CombatGui:FindFirstChild("AllyDataList")
        local post = ally and ally:FindFirstChild("Posture")
        local lbl = post and post:FindFirstChild("Label")
        return lbl and lbl.Text
    end)
    if ok2 and type(txt) == "string" then return tonumber(txt) end
    return nil
end

function Combat.getEGOCards()
    local egoCards = {}
    if not (Refs.PlayerStats and type(Refs.PlayerStats.EGOHand) == "table") then return egoCards end
    for k, raw in pairs(Refs.PlayerStats.EGOHand) do
        local attackId = tostring(raw[3] or k)
        local parsed = Combat.parseCardData(raw, attackId)
        if parsed then
            parsed.Source = "EGO"
            table.insert(egoCards, parsed)
        end
    end
    return egoCards
end

function Combat.getCardsInHand()
    local cards, seen = {}, {}
    local function resolveRaw(attackId)
        local src = Refs.PlayerStats.Hand and Refs.PlayerStats.Hand[attackId]
        if src then return src, "Hand" end
        if Config.AUTO_USE_EGO then
            local ego = Refs.PlayerStats.EGOHand and Refs.PlayerStats.EGOHand[attackId]
            if ego then return ego, "EGO" end
        end
        return nil
    end

    local function scanButtons(container)
        if not container then return end
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("TextButton") then
                local attackId = child:GetAttribute("AttackId")
                if attackId and not seen[tostring(attackId)] then
                    local raw, source = resolveRaw(attackId)
                    if raw then
                        local parsed = Combat.parseCardData(raw, tostring(attackId))
                        if parsed then
                            parsed.Button = child
                            parsed.Source = source
                            seen[parsed.AttackId] = true
                            table.insert(cards, parsed)
                        end
                    end
                end
            end
        end
    end

    scanButtons(Refs.HandContainer)
    scanButtons(Refs.CombatGui:FindFirstChild("GuardCardPosition"))

    if #cards == 0 and Refs.PlayerStats and type(Refs.PlayerStats.Hand) == "table" then
        for k, raw in pairs(Refs.PlayerStats.Hand) do
            local attackId = tostring(raw[3] or k)
            if not seen[attackId] then
                local parsed = Combat.parseCardData(raw, attackId)
                if parsed then
                    parsed.Source = "Hand"
                    seen[attackId] = true
                    table.insert(cards, parsed)
                end
            end
        end
    end
    return cards
end

function Combat.getAliveEnemies()
    local enemies = {}
    local seenIds, seenModels = {}, {}
    local entitiesFolder = Services.Workspace:FindFirstChild("Entities")
        or Services.Workspace:FindFirstChild("BattleEntities")
        or Services.Workspace:FindFirstChild("Units")

    local function addEnemy(id, unitData, model, frame)
        if not id or id == "" or seenIds[id] then return end
        if not (model and model.Parent) then
            if unitData and unitData.Model and unitData.Model.Parent then model = unitData.Model
            elseif entitiesFolder then
                model = entitiesFolder:FindFirstChild(id)
                if not model then
                    for _, child in ipairs(entitiesFolder:GetChildren()) do
                        if child:IsA("Model") and (child:GetAttribute("id") == id or child.Name == id) then
                            model = child
                            break
                        end
                    end
                end
            end
        end

        if not (model and model.Parent) or seenModels[model] then return end
        if model == Refs.LocalPlayer.Character or Services.Players:GetPlayerFromCharacter(model) then return end
        if model:GetAttribute("Untargetable") or model:GetAttribute("Dead") or model:GetAttribute("IsDead") then return end

        local hum = model:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health <= 0 then return end
        if unitData and (not unitData.Model or unitData.Model ~= model) then unitData.Model = model end

        local health = Utils.toNumber(unitData and unitData.Health) or (hum and hum.Health) or 0
        if health <= 0 and (not hum or hum.Health <= 0) then return end

        local maxHealth = Utils.toNumber(unitData and unitData.MaxHealth) or (hum and hum.MaxHealth) or health
        local tempHealth = Utils.toNumber(unitData and unitData.TempHealth) or 0
        local speed = Utils.toNumber(unitData and unitData.Speed) or 0

        local handCount, handKnown = 0, false
        if unitData and type(unitData.Hand) == "table" then
            handCount, handKnown = #unitData.Hand, true
        elseif frame then
            local holder = frame:FindFirstChild("CardsInHand")
            local label = holder and holder:FindFirstChild("Label")
            local n = label and tonumber(label.Text)
            if n then handCount, handKnown = math.max(0, n), true end
        end

        local staggered = Combat.isEnemyStaggered(unitData, model)
        local first = Combat.getEnemyFirstCard(unitData)
        local defending = (not staggered) and handKnown and handCount > 0 and (first and (Combat.parseCardData(first) or {}).IsDefenseOrEvade or false)

        local threatScore, offensiveCards, scanned, topCard, profile = 0, handCount, 0, 0, {}
        if handKnown and handCount > 0 then
            threatScore, offensiveCards, scanned, topCard, profile = Combat.estimateEnemyThreat(unitData)
            if scanned == 0 then offensiveCards = handCount end
        end
        if staggered or defending then offensiveCards = 0 end

        seenIds[id] = true
        seenModels[model] = true

        local rawName = (unitData and unitData.DisplayName) or model:GetAttribute("DisplayName") or model.Name
        local shortId = tostring(id):sub(1, 6)
        local outProfile = {}
        for _, t in ipairs(DAMAGE_TYPES) do if profile[t] then table.insert(outProfile, t) end end

        table.insert(enemies, {
            Id = id,
            Name = string.format("%s [%s]", rawName, shortId),
            DisplayName = rawName,
            UnitData = unitData,
            Model = model,
            HandCount = handCount,
            HandKnown = handKnown,
            Health = health,
            MaxHealth = maxHealth,
            TempHealth = tempHealth,
            EffectiveHP = health + tempHealth,
            Speed = speed,
            IsStaggered = staggered,
            IsDefendingOrEvading = defending,
            OffensiveThreats = offensiveCards,
            ThreatScore = threatScore,
            TopCardThreat = topCard,
            DamageProfileString = (#outProfile > 0 and table.concat(outProfile, "/") or "?"),
        })
    end

    if entitiesFolder then
        for _, ent in ipairs(entitiesFolder:GetChildren()) do
            if ent:IsA("Model") and ent ~= Refs.LocalPlayer.Character and not Services.Players:GetPlayerFromCharacter(ent) then
                local mId = ent:GetAttribute("id") or ent.Name
                local uData = Refs.CachedBattleUnits[mId] or Refs.CachedBattleUnits[ent.Name]
                local frame = Refs.EnemyContainer:FindFirstChild(mId)
                addEnemy(mId, uData, ent, frame)
            end
        end
    end

    for _, frame in ipairs(Refs.EnemyContainer:GetChildren()) do
        if frame:IsA("Frame") and frame.Name ~= "" then
            local uData = Refs.CachedBattleUnits[frame.Name]
            addEnemy(frame.Name, uData, uData and uData.Model, frame)
        end
    end

    return enemies
end

function Combat.evaluateClash(cardObj, enemy)
    if not enemy or enemy.IsStaggered or (enemy.HandKnown and enemy.HandCount == 0) then
        return 5, cardObj.MaxPower, nil, "Unopposed"
    end

    local prediction = nil
    if enemy.Model then
        pcall(function()
            prediction = Refs.clashPredictor:InvokeServer(cardObj.BasePower, cardObj.MaxPower, cardObj.RawData, enemy.Model)
        end)
    end

    if type(prediction) == "table" then
        local pBase = Utils.toNumber(prediction.PlayerBaseValue) or cardObj.BasePower
        local eBase = Utils.toNumber(prediction.EnemyBaseValue) or 0
        local eMax = Utils.toNumber(prediction.EnemyMaxValue) or 0
        local score = Utils.toNumber(prediction.Score) or 0

        if math.max(eBase, eMax) < pBase then return 5, 1000 + score, prediction, "Certain Victory"
        elseif score > Config.CLASH_OVERWHELM_SCORE then return 4, 500 + score, prediction, "Overwhelming Advantage"
        elseif score > Config.CLASH_ADVANTAGE_SCORE then return 3, 200 + score, prediction, "Advantaged"
        elseif score >= Config.CLASH_RISKY_SCORE then return 2, 50 + score, prediction, "Risky"
        else return 1, score, prediction, "Desperate/Hopeless" end
    end
    return 3, cardObj.MaxPower, nil, "No Prediction"
end

function Combat.selectCardForEnemy(cardsInHand, targetEnemy, isOpposed)
    if #cardsInHand == 0 then return nil end

    local offensives, defenses = {}, {}
    for _, card in ipairs(cardsInHand) do
        if card.IsDefenseOrEvade then table.insert(defenses, card)
        else table.insert(offensives, card) end
    end
    table.sort(offensives, function(a, b)
        if a.MaxPower ~= b.MaxPower then return a.MaxPower > b.MaxPower end
        return a.Cost < b.Cost
    end)
    table.sort(defenses, function(a, b) return a.MaxPower > b.MaxPower end)

    local bestDefense = defenses[1]
    local bestEvade = nil
    for _, d in ipairs(defenses) do
        if d.DefenseKind == "Evade" then bestEvade = d break end
    end

    local canDefend = (#defenses > Config.KEEP_DEFENSE_RESERVE)
    local safe = canDefend and ((Config.PREFER_EVADE_OVER_GUARD and (bestEvade or bestDefense)) or (bestDefense or bestEvade)) or nil

    if targetEnemy.IsStaggered or targetEnemy.HandCount == 0 or not isOpposed then
        if targetEnemy.IsDefendingOrEvading and targetEnemy.HandCount > 0 and not targetEnemy.IsStaggered then
            -- clash calculation
        else
            if #offensives > 0 then
                local eRes = Combat.getUnitResistances(targetEnemy.UnitData)
                local chosen, chosenDmg = offensives[1], -1
                for _, c in ipairs(offensives) do
                    local d = Combat.expectedDamage(c, eRes)
                    if d > chosenDmg then chosen, chosenDmg = c, d end
                end
                UI.Log("THINK", string.format("Target %s is %s. Best damage: <font color='#B388FF'>%s</font> (~%d Dmg).",
                    targetEnemy.Name, targetEnemy.IsStaggered and "STAGGERED" or "UNOPPOSED", chosen.Name, math.floor(chosenDmg)), "#B0BEC5")
                return chosen
            end
            if Config.PLAY_LEFTOVER_EVADES and bestEvade then return bestEvade end
            return bestDefense
        end
    end

    if targetEnemy.IsDefendingOrEvading then
        if canDefend and bestDefense then return bestDefense end
        if #offensives > 0 then return offensives[#offensives] end
    end

    local scored = {}
    for _, card in ipairs(offensives) do
        local rank, score, _, verdict = Combat.evaluateClash(card, targetEnemy)
        table.insert(scored, { Card = card, Rank = rank, Score = score, Verdict = verdict })
    end

    table.sort(scored, function(a, b)
        if a.Rank ~= b.Rank then return a.Rank > b.Rank end
        return a.Score > b.Score
    end)

    local bestNormal = scored[1]

    if bestNormal and bestNormal.Rank > Config.DEFENSE_SWAP_MAX_RANK then
        UI.Log("PREDICT", string.format("Clash vs %s -> <font color='#B388FF'>%s</font> [<b>%s</b>, Score: %d].",
            targetEnemy.Name, bestNormal.Card.Name, bestNormal.Verdict, math.floor(bestNormal.Score)), "#2ECC71")
        return bestNormal.Card
    end

    -- Smart Threat-Gated E.G.O Solver (Flat & PCT)
    if Config.AUTO_USE_EGO and (Config.EGO_USAGE_MODE == "Emergency" or Config.EGO_USAGE_MODE == "Always") then
        local currentPosture = Combat.getPlayerPosture() or 0
        local currentHp = Utils.toNumber(Refs.PlayerStats.Health) or 100
        local maxHp = Utils.toNumber(Refs.PlayerStats.MaxHealth) or currentHp

        if currentPosture >= Config.EGO_MIN_POSTURE_LIMIT then
            local incomingDamage = Combat.calculateEnemyIncomingDamage(targetEnemy)
            local incomingPct = (maxHp > 0) and ((incomingDamage / maxHp) * 100) or 0

            local isLethalRisk = Config.EGO_USE_ON_LETHAL and (incomingDamage >= currentHp)
            local isFlatThreat = (Config.EGO_MIN_THREAT_DAMAGE > 0) and (incomingDamage >= Config.EGO_MIN_THREAT_DAMAGE)
            local isPctThreat  = (Config.EGO_MIN_THREAT_DAMAGE_PCT > 0) and (incomingPct >= Config.EGO_MIN_THREAT_DAMAGE_PCT)

            if isFlatThreat or isPctThreat or isLethalRisk then
                local egoCards = Combat.getEGOCards()
                local egoScored = {}

                for _, egoCard in ipairs(egoCards) do
                    local rank, score, _, verdict = Combat.evaluateClash(egoCard, targetEnemy)
                    table.insert(egoScored, { Card = egoCard, Rank = rank, Score = score, Verdict = verdict })
                end

                table.sort(egoScored, function(a, b)
                    if a.Rank ~= b.Rank then return a.Rank > b.Rank end
                    return a.Score > b.Score
                end)

                local bestEGO = egoScored[1]
                if bestEGO and bestEGO.Rank > Config.DEFENSE_SWAP_MAX_RANK then
                    local threatTag = isLethalRisk and "LETHAL RISK"
                        or (isPctThreat and string.format("%.1f%% Max HP", incomingPct)
                        or string.format("%d Dmg", math.floor(incomingDamage)))

                    UI.Log("EGO", string.format("Threat (%s) -> Deployed E.G.O: <font color='#FFD54F'><b>%s</b></font> [<b>%s</b>]!",
                        threatTag, bestEGO.Card.Name, bestEGO.Verdict), "#FFD54F")
                    return bestEGO.Card
                end
            else
                UI.Log("THINK", string.format("Enemy attack is low threat (~%d Dmg, %.1f%% HP). Conserving E.G.O...",
                    math.floor(incomingDamage), incomingPct), "#B0BEC5")
            end
        end
    end

    if bestNormal then
        UI.Log("PREDICT", string.format("Clash vs %s -> <font color='#B388FF'>%s</font> [<b>%s</b>, Score: %d].",
            targetEnemy.Name, bestNormal.Card.Name, bestNormal.Verdict, math.floor(bestNormal.Score)), "#EB4D4B")

        if safe then
            UI.Log("DEFENSE", string.format("Clash unsafe. Conserving E.G.O -> Defensive: <font color='#CE93D8'>%s</font>.", safe.Name), "#BA68C8")
            return safe
        end
        return bestNormal.Card
    end

    return safe or bestDefense
end

function Combat.tryEndTurn()
    task.wait(Config.ACTION_DELAY)
    local endWaitStart = os.clock()
    while Refs.LocalPlayer:GetAttribute("Active") and (os.clock() - endWaitStart < Config.CLASH_MAX_TIMEOUT) do
        if not Refs.LocalPlayer:GetAttribute("IsYourTurn") or not Refs.CombatGui.Enabled or Utils.isPlayerDead() then break end
        task.wait(0.1)
    end
    Refs.LocalPlayer:SetAttribute("Active", false)

    if State.IsBotRunning and State.CombatMode > 0
        and Refs.LocalPlayer:GetAttribute("IsYourTurn")
        and Refs.CombatGui.Enabled then
        UI.Log("TURN", "Turn completed. Sending EndTurn request...", "#90A4AE")
        Refs.endTurn:FireServer()
        task.wait(Config.END_TURN_COOLDOWN)
    end
end

function Combat.processTurn()
    if Utils.isPlayerDead() then return end
    if not (Refs.LocalPlayer:GetAttribute("IsYourTurn") and Refs.CombatGui.Enabled) then return end

    if not Utils.ableToPlay() then
        if Refs.LocalPlayer:GetAttribute("Active") then
            local clashWait = os.clock()
            while Refs.LocalPlayer:GetAttribute("Active") and (os.clock() - clashWait < Config.CLASH_MAX_TIMEOUT) do
                if not Refs.LocalPlayer:GetAttribute("IsYourTurn") or not Refs.CombatGui.Enabled or Utils.isPlayerDead() then return end
                task.wait(0.1)
            end
            Refs.LocalPlayer:SetAttribute("Active", false)
        else
            return
        end
    end

    UI.Log("TURN", "Player turn detected. Inspecting battlefield...", "#8A5CFF")

    if State.SyncHoldSince == nil then State.SyncHoldSince = os.clock() end
    local lastHoldLog, dataFound = 0, false
    while os.clock() - State.SyncHoldSince < Config.ENCOUNTER_SYNC_TIMEOUT do
        if Utils.isPlayerDead() then return end
        local enemiesNow = Combat.getAliveEnemies()
        if #enemiesNow > 0 then
            local anyHand = false
            for _, e in ipairs(enemiesNow) do if e.HandKnown then anyHand = true break end end
            if anyHand then dataFound = true break end
        end
        if not State.IsBotRunning or not Refs.LocalPlayer:GetAttribute("IsYourTurn") then
            State.SyncHoldSince = nil
            return
        end
        if os.clock() - lastHoldLog > Config.SYNC_LOG_THROTTLE then
            UI.Log("WAIT", string.format("Encounter loading (units: %d). Holding turn...", #enemiesNow), "#FFD54F")
            lastHoldLog = os.clock()
        end
        task.wait(0.2)
    end

    State.SyncHoldSince = nil
    if dataFound and Refs.LocalPlayer:GetAttribute("IsYourTurn") then task.wait(Config.SYNC_SETTLE_DELAY) end

    local graceStart = os.clock()
    while os.clock() - graceStart < Config.TURN_GRACE_TIME do
        if Utils.isPlayerDead() then return end
        if #Combat.getCardsInHand() > 0 and #Combat.getAliveEnemies() > 0 then break end
        task.wait(0.1)
    end

    local enemies = Combat.getAliveEnemies()
    local cardsInHand = Combat.getCardsInHand()

    if #enemies == 0 or #cardsInHand == 0 then
        Combat.tryEndTurn()
        return
    end

    local pendingThreats, pendingThreatScore, timesTargeted = {}, {}, {}
    for _, enemy in ipairs(enemies) do
        pendingThreats[enemy.Id] = enemy.OffensiveThreats
        pendingThreatScore[enemy.Id] = enemy.ThreatScore
        timesTargeted[enemy.Id] = 0
    end

    local playedThisTurn = {}
    local actionsThisTurn = 0
    local turnDone = false
    local FocusTargetId = nil

    while (not turnDone)
        and actionsThisTurn < Config.MAX_ACTIONS_PER_TURN
        and State.IsBotRunning
        and Refs.LocalPlayer:GetAttribute("IsYourTurn")
        and not Utils.isPlayerDead()
        and Refs.CombatGui.Enabled do

        if not Utils.ableToPlay() then
            if Refs.LocalPlayer:GetAttribute("Active") then
                local clashWait = os.clock()
                while Refs.LocalPlayer:GetAttribute("Active") and (os.clock() - clashWait < Config.CLASH_MAX_TIMEOUT) do
                    if not Refs.LocalPlayer:GetAttribute("IsYourTurn") or not Refs.CombatGui.Enabled or Utils.isPlayerDead() then
                        turnDone = true
                        break
                    end
                    task.wait(0.1)
                end
                Refs.LocalPlayer:SetAttribute("Active", false)
                task.wait(Config.ACTION_POST_DELAY)
            else
                turnDone = true
                break
            end
        end

        if not turnDone then
            enemies = Combat.getAliveEnemies()
            if #enemies == 0 then
                turnDone = true
            else
                cardsInHand = Combat.getCardsInHand()
                local available = {}
                for _, c in ipairs(cardsInHand) do
                    if not playedThisTurn[c.AttackId] then table.insert(available, c) end
                end

                if #available == 0 then
                    turnDone = true
                else
                    for _, enemy in ipairs(enemies) do
                        if pendingThreats[enemy.Id] == nil then
                            pendingThreats[enemy.Id] = enemy.OffensiveThreats
                            pendingThreatScore[enemy.Id] = enemy.ThreatScore
                            timesTargeted[enemy.Id] = 0
                        else
                            pendingThreats[enemy.Id] = math.min(pendingThreats[enemy.Id], enemy.OffensiveThreats)
                            pendingThreatScore[enemy.Id] = (pendingThreats[enemy.Id] == 0) and 0 or enemy.ThreatScore
                        end
                    end

                    local totalThreatsLeft = 0
                    for _, enemy in ipairs(enemies) do totalThreatsLeft += (pendingThreats[enemy.Id] or 0) end

                    local chosenEnemy = nil
                    local isOpposed = false

                    if State.CombatMode == 1 then
                        if totalThreatsLeft > 0 then
                            table.sort(enemies, function(a, b)
                                local aT, bT = pendingThreats[a.Id] or 0, pendingThreats[b.Id] or 0
                                local aS, bS = pendingThreatScore[a.Id] or 0, pendingThreatScore[b.Id] or 0
                                local aH, bH = timesTargeted[a.Id] or 0, timesTargeted[b.Id] or 0
                                if (aT > 0) ~= (bT > 0) then return aT > 0 end
                                if aS ~= bS then return aS > bS end
                                if Config.TARGET_STAGGERED_FIRST and a.IsStaggered ~= b.IsStaggered then return a.IsStaggered end
                                if aH ~= bH then return aH < bH end
                                if Config.THREAT_TIEBREAK_SPEED and a.Speed ~= b.Speed then return a.Speed > b.Speed end
                                return a.Id < b.Id
                            end)
                            chosenEnemy = enemies[1]
                            isOpposed = (pendingThreats[chosenEnemy.Id] or 0) > 0 and chosenEnemy.HandCount > 0 and not chosenEnemy.IsStaggered
                        else
                            local hasOffense, strongest = false, 0
                            for _, c in ipairs(available) do
                                if not c.IsDefenseOrEvade then
                                    hasOffense = true
                                    if c.MaxPower > strongest then strongest = c.MaxPower end
                                end
                            end

                            local posture = Combat.getPlayerPosture()
                            if posture and posture < Config.LOW_POSTURE_LIMIT then
                                turnDone = true
                            elseif hasOffense then
                                local killLine = strongest * Config.KILL_MARGIN
                                table.sort(enemies, function(a, b)
                                    if Config.TARGET_STAGGERED_FIRST and a.IsStaggered ~= b.IsStaggered then return a.IsStaggered end
                                    if Config.TARGET_KILLABLE_FIRST then
                                        local aK, bK = a.EffectiveHP <= killLine, b.EffectiveHP <= killLine
                                        if aK ~= bK then return aK end
                                    end
                                    if a.EffectiveHP ~= b.EffectiveHP then return a.EffectiveHP < b.EffectiveHP end
                                    return a.Id < b.Id
                                end)
                                chosenEnemy = enemies[1]
                                isOpposed = chosenEnemy.HandCount > 0 and not chosenEnemy.IsStaggered
                            elseif Config.PLAY_LEFTOVER_EVADES then
                                chosenEnemy = enemies[1]
                                isOpposed = false
                            else
                                turnDone = true
                            end
                        end
                    else
                        if Config.AGGRO_FOCUS_FIRE and FocusTargetId then
                            for _, e in ipairs(enemies) do if e.Id == FocusTargetId then chosenEnemy = e break end end
                        end
                        if not chosenEnemy then
                            table.sort(enemies, function(a, b)
                                if Config.TARGET_STAGGERED_FIRST and a.IsStaggered ~= b.IsStaggered then return a.IsStaggered end
                                local aS, bS = pendingThreatScore[a.Id] or 0, pendingThreatScore[b.Id] or 0
                                if aS ~= bS then return aS > bS end
                                if a.EffectiveHP ~= b.EffectiveHP then return a.EffectiveHP < b.EffectiveHP end
                                return a.Id < b.Id
                            end)
                            chosenEnemy = enemies[1]
                        end
                        if chosenEnemy then FocusTargetId = chosenEnemy.Id end
                        isOpposed = chosenEnemy and chosenEnemy.HandCount > 0 and not chosenEnemy.IsStaggered
                    end

                    if not chosenEnemy or not chosenEnemy.Model or not chosenEnemy.Model.Parent then
                        turnDone = true
                    elseif chosenEnemy.Model:GetAttribute("Untargetable") or chosenEnemy.Health <= 0 then
                        turnDone = true
                    else
                        timesTargeted[chosenEnemy.Id] = (timesTargeted[chosenEnemy.Id] or 0) + 1
                        pcall(function() Refs.LockOnSystem.setLockOn(chosenEnemy.Model, chosenEnemy.UnitData) end)
                        task.wait(Config.ACTION_DELAY)

                        local cardToPlay = Combat.selectCardForEnemy(available, chosenEnemy, isOpposed)
                        if not cardToPlay or playedThisTurn[cardToPlay.AttackId] then
                            turnDone = true
                        else
                            local movementOk = true
                            if Refs.LockOnSystem and Refs.LockOnSystem.detectMovement then
                                local okDetect, resDetect = pcall(Refs.LockOnSystem.detectMovement, cardToPlay.RawData)
                                if okDetect and resDetect == false then movementOk = false end
                            end

                            if not movementOk then
                                UI.Log("WARN", string.format("Movement cannot reach %s with %s.", chosenEnemy.Name, cardToPlay.Name), "#FFD54F")
                                playedThisTurn[cardToPlay.AttackId] = true
                            else
                                local targetId = chosenEnemy.Model:GetAttribute("id") or chosenEnemy.Id
                                Refs.LocalPlayer:SetAttribute("Active", true)
                                actionsThisTurn += 1

                                UI.Log("EXEC", string.format("Playing <font color='#B388FF'><b>%s</b></font> on %s...",
                                    cardToPlay.Name, chosenEnemy.Name), "#B388FF")

                                if cardToPlay.Source == "EGO" then
                                    Refs.playEGOAttack:FireServer(cardToPlay.RawData.Name or cardToPlay.Name, cardToPlay.AttackId, targetId)
                                else
                                    Refs.playAttack:FireServer(cardToPlay.AttackId, targetId)
                                end

                                playedThisTurn[cardToPlay.AttackId] = true
                                if cardToPlay.Button then pcall(function() cardToPlay.Button:Destroy() end) end

                                if (pendingThreats[chosenEnemy.Id] or 0) > 0 then
                                    pendingThreats[chosenEnemy.Id] = pendingThreats[chosenEnemy.Id] - 1
                                end

                                local t0 = os.clock()
                                task.wait(0.15)
                                while (os.clock() - t0 < Config.CLASH_MAX_TIMEOUT) do
                                    if not Refs.LocalPlayer:GetAttribute("Active") then break end
                                    if not Refs.LocalPlayer:GetAttribute("IsYourTurn") then break end
                                    if not Refs.CombatGui.Enabled or not Refs.HandContainer.Visible then break end
                                    if Utils.isPlayerDead() then break end
                                    task.wait(0.1)
                                end

                                Refs.LocalPlayer:SetAttribute("Active", false)
                                task.wait(Config.ACTION_POST_DELAY)
                            end
                        end
                    end
                end
            end
        end
    end
    Combat.tryEndTurn()
end

-- Completely hardened combat detector
function Combat.isInActiveCombat(): boolean
    if Utils.isPlayerDead() then return false end

    -- Primary: Check if CombatGui is currently rendering and active
    if Refs.CombatGui and Refs.CombatGui.Enabled then
        local rew = Refs.DungeonGui:FindFirstChild("RewardFrame")
        if rew and rew.Visible then return false end
        local dial = Refs.DialogueContainer or Refs.DungeonGui:FindFirstChild("DialogueContainer")
        if dial and dial.Visible then return false end
        local rest = Refs.DungeonGui:FindFirstChild("RestContainer") or Refs.DungeonGui:FindFirstChild("RestFrame")
        if rest and rest.Visible then return false end
        local boss = Refs.DungeonGui:FindFirstChild("PickBossFrame")
        if boss and boss.Visible then return false end
        return true
    end

    -- Secondary: Check player turn and active clash attributes
    if Refs.LocalPlayer:GetAttribute("IsYourTurn") == true or Refs.LocalPlayer:GetAttribute("Active") == true then
        return true
    end

    -- Tertiary: Check alive entities on field
    local enemies = Combat.getAliveEnemies()
    if #enemies > 0 then
        return true
    end

    return false
end

