function Combat.tryEndTurn()
    task.wait(Config.ADVANCED.ActionDelay)
    local endWaitStart = os.clock()
    while Refs.LocalPlayer:GetAttribute("Active") and (os.clock() - endWaitStart < Config.ADVANCED.ClashMaxTimeout) do
        if not Refs.LocalPlayer:GetAttribute("IsYourTurn") or not Refs.CombatGui.Enabled or Utils.isPlayerDead() then break end
        task.wait(0.1)
    end
    Refs.LocalPlayer:SetAttribute("Active", false)

    if State.IsBotRunning and State.CombatMode > 0
        and Refs.LocalPlayer:GetAttribute("IsYourTurn")
        and Refs.CombatGui.Enabled then
        UI.Log("TURN", "Turn completed. Sending EndTurn request...", "#90A4AE")
        Refs.endTurn:FireServer()
        task.wait(Config.ADVANCED.EndTurnCooldown)
    end
end

function Combat.processTurn()
    if Utils.isPlayerDead() then return end
    if not (Refs.LocalPlayer:GetAttribute("IsYourTurn") and Refs.CombatGui.Enabled) then return end

    Combat.IsTurnExecuting = false

    if not Utils.ableToPlay() then
        if Refs.LocalPlayer:GetAttribute("Active") then
            local clashWait = os.clock()
            while Refs.LocalPlayer:GetAttribute("Active") and (os.clock() - clashWait < Config.ADVANCED.ClashMaxTimeout) do
                if not Refs.LocalPlayer:GetAttribute("IsYourTurn") or not Refs.CombatGui.Enabled or Utils.isPlayerDead() then return end
                task.wait(0.1)
            end
            Refs.LocalPlayer:SetAttribute("Active", false)
        else
            return
        end
    end

    UI.Log("TURN", "Player turn detected. Inspecting battlefield...", "#8A5CFF")

    if State.SyncHoldSince == nil then State.SyncHoldSince = os.clock() end
    local lastHoldLog, dataFound = 0, false
    while os.clock() - State.SyncHoldSince < Config.ADVANCED.EncounterSyncTimeout do
        if Utils.isPlayerDead() then return end
        local enemiesNow = Combat.getAliveEnemies({}, false)
        if #enemiesNow > 0 then
            local anyHand = false
            for _, e in ipairs(enemiesNow) do if e.HandKnown then anyHand = true break end end
            if anyHand then dataFound = true break end
        end
        if not State.IsBotRunning or not Refs.LocalPlayer:GetAttribute("IsYourTurn") then
            State.SyncHoldSince = nil
            return
        end
        if os.clock() - lastHoldLog > Config.ADVANCED.SyncLogThrottle then
            UI.Log("WAIT", string.format("Encounter loading (units: %d). Holding turn...", #enemiesNow), "#FFD54F")
            lastHoldLog = os.clock()
        end
        task.wait(0.2)
    end

    State.SyncHoldSince = nil
    if dataFound and Refs.LocalPlayer:GetAttribute("IsYourTurn") then task.wait(Config.ADVANCED.SyncSettleDelay) end

    local graceStart = os.clock()
    while os.clock() - graceStart < Config.ADVANCED.TurnGraceTime do
        if Utils.isPlayerDead() then return end
        if #Combat.getCardsInHand() > 0 and #Combat.getAliveEnemies({}, false) > 0 then break end
        task.wait(0.1)
    end

    local playedThisTurn = {}
    local timesTargeted = {}
    local actionsThisTurn = 0
    local turnDone = false
    local FocusTargetId = nil

    local initialEnemies = Combat.getAliveEnemies({}, false)
    local cardsInHand = Combat.getCardsInHand()

    if #initialEnemies == 0 or #cardsInHand == 0 then
        Combat.tryEndTurn()
        return
    end

    Combat.resetTurnHandTracking()
    Combat.IsTurnExecuting = true

    -- Detect Active Boss Strategy
    local currentBossName = Combat.getCurrentBossName()
    local activeBossStrat = Config.AUTO_USE_BOSS_STRATS and Combat.getBossStrategy(currentBossName) or nil
    if activeBossStrat and currentBossName then
        UI.Log("System", string.format("Custom combat strategy loaded for <font color='#FFD54F'><b>%s</b></font>!", currentBossName), "#FFD54F")
    end

    while (not turnDone)
        and actionsThisTurn < Config.ADVANCED.MaxActionsPerTurn
        and State.IsBotRunning
        and Refs.LocalPlayer:GetAttribute("IsYourTurn")
        and not Utils.isPlayerDead()
        and Refs.CombatGui.Enabled do

        if not Utils.ableToPlay() then
            if Refs.LocalPlayer:GetAttribute("Active") then
                local clashWait = os.clock()
                while Refs.LocalPlayer:GetAttribute("Active") and (os.clock() - clashWait < Config.ADVANCED.ClashMaxTimeout) do
                    if not Refs.LocalPlayer:GetAttribute("IsYourTurn") or not Refs.CombatGui.Enabled or Utils.isPlayerDead() then
                        turnDone = true
                        break
                    end
                    task.wait(0.1)
                end
                Refs.LocalPlayer:SetAttribute("Active", false)
                task.wait(Config.ADVANCED.ActionPostDelay)
            else
                turnDone = true
                break
            end
        end

        if not turnDone then
            local enemies = Combat.getAliveEnemies(timesTargeted, true)
            if #enemies == 0 then
                turnDone = true
            else
                cardsInHand = Combat.getCardsInHand()
                local available = {}
                for _, c in ipairs(cardsInHand) do
                    if not playedThisTurn[c.AttackId] then table.insert(available, c) end
                end

                if #available == 0 then
                    turnDone = true
                else
                    local chosenEnemy = nil
                    local cardToPlay = nil
                    local isOpposed = false

                    -- 1. Check Custom Boss Strategy Hook
                    if activeBossStrat and activeBossStrat.selectAction then
                        local bossEnemy = nil
                        for _, e in ipairs(enemies) do
                            if currentBossName and e.DisplayName:find(currentBossName, 1, true) then
                                bossEnemy = e
                                break
                            end
                        end

                        local ctx = {
                            Boss            = bossEnemy or enemies[1],
                            Enemies         = enemies,
                            AvailableCards  = available,
                            ActionsThisTurn = actionsThisTurn,
                            Posture         = Combat.getPlayerPosture() or 100,
                            Health          = Utils.toNumber(Refs.PlayerStats.Health) or 100,
                            MaxHealth       = Utils.toNumber(Refs.PlayerStats.MaxHealth) or 100,
                        }

                        local okStrat, stratEnemy, stratCard = pcall(activeBossStrat.selectAction, ctx)
                        if okStrat and stratEnemy and stratCard then
                            chosenEnemy = stratEnemy
                            cardToPlay = stratCard
                        end
                    end

                    -- 2. Standard Strategic AI Fallback (Safe / Aggressive)
                    if not chosenEnemy or not cardToPlay then
                        if State.CombatMode == 1 then
                            local threateningEnemies = {}
                            local spareEnemies = {}

                            for _, enemy in ipairs(enemies) do
                                if (enemy.UnaddressedThreats or 0) > 0 and not enemy.IsStaggered then
                                    table.insert(threateningEnemies, enemy)
                                else
                                    table.insert(spareEnemies, enemy)
                                end
                            end

                            if #threateningEnemies > 0 then
                                table.sort(threateningEnemies, function(a, b)
                                    local aImm = not a.IsNextSlotDefensive
                                    local bImm = not b.IsNextSlotDefensive
                                    if aImm ~= bImm then return aImm end

                                    if a.NextThreatScore ~= b.NextThreatScore then
                                        return a.NextThreatScore > b.NextThreatScore
                                    end

                                    if Config.ADVANCED.ThreatTiebreakSpeed and a.Speed ~= b.Speed then
                                        return a.Speed > b.Speed
                                    end

                                    return a.Id < b.Id
                                end)

                                chosenEnemy = threateningEnemies[1]
                                isOpposed = true
                            else
                                local currentPosture = Combat.getPlayerPosture() or 100
                                local isLowPosture = Utils.isBelowThreshold(currentPosture, 100, Config.LOW_POSTURE_LIMIT)

                                if isLowPosture then
                                    UI.Log("POSTURE", string.format("Posture (%d) <= Limit (%s). Conserving posture.",
                                        math.floor(currentPosture), tostring(Config.LOW_POSTURE_LIMIT)), "#FFD54F")
                                    turnDone = true
                                else
                                    local affordableCards = {}
                                    local postThreshold = Utils.resolveThreshold(Config.LOW_POSTURE_LIMIT, 100, 0)

                                    for _, c in ipairs(available) do
                                        local cost = c.Cost or 0
                                        if not c.IsDefenseOrEvade and (currentPosture - cost) >= postThreshold then
                                            table.insert(affordableCards, c)
                                        end
                                    end

                                    if #affordableCards == 0 and Config.PLAY_LEFTOVER_EVADES then
                                        for _, c in ipairs(available) do
                                            if c.IsDefenseOrEvade and c.DefenseKind == "Evade" then
                                                table.insert(affordableCards, c)
                                            end
                                        end
                                    end

                                    if #affordableCards == 0 then
                                        UI.Log("POSTURE", "No spare attacks affordable without breaching Low Posture Limit. Ending turn.", "#B0BEC5")
                                        turnDone = true
                                    else
                                        local targetPool = #spareEnemies > 0 and spareEnemies or enemies

                                        local strongest = 0
                                        for _, c in ipairs(affordableCards) do
                                            if (c.MaxPower or 0) > strongest then strongest = c.MaxPower end
                                        end
                                        local killLine = strongest * Config.KILL_MARGIN

                                        table.sort(targetPool, function(a, b)
                                            if Config.TARGET_STAGGERED_FIRST and a.IsStaggered ~= b.IsStaggered then
                                                return a.IsStaggered
                                            end
                                            if Config.TARGET_KILLABLE_FIRST then
                                                local aK, bK = a.EffectiveHP <= killLine, b.EffectiveHP <= killLine
                                                if aK ~= bK then return aK end
                                            end
                                            if a.EffectiveHP ~= b.EffectiveHP then
                                                return a.EffectiveHP < b.EffectiveHP
                                            end
                                            return a.Id < b.Id
                                        end)

                                        chosenEnemy = targetPool[1]
                                        isOpposed = false
                                        available = affordableCards
                                    end
                                end
                            end
                        else
                            if Config.AGGRO_FOCUS_FIRE and FocusTargetId then
                                for _, e in ipairs(enemies) do if e.Id == FocusTargetId then chosenEnemy = e break end end
                            end
                            if not chosenEnemy then
                                table.sort(enemies, function(a, b)
                                    if Config.TARGET_STAGGERED_FIRST and a.IsStaggered ~= b.IsStaggered then return a.IsStaggered end
                                    if a.RemainingThreatScore ~= b.RemainingThreatScore then
                                        return a.RemainingThreatScore > b.RemainingThreatScore
                                    end
                                    if a.EffectiveHP ~= b.EffectiveHP then return a.EffectiveHP < b.EffectiveHP end
                                    return a.Id < b.Id
                                end)
                                chosenEnemy = enemies[1]
                            end
                            if chosenEnemy then FocusTargetId = chosenEnemy.Id end
                            isOpposed = chosenEnemy and (chosenEnemy.NextCard ~= nil) and not chosenEnemy.IsStaggered
                        end
                    end

                    if not chosenEnemy or not chosenEnemy.Model or not chosenEnemy.Model.Parent then
                        turnDone = true
                    elseif chosenEnemy.Model:GetAttribute("Untargetable") or chosenEnemy.Health <= 0 then
                        turnDone = true
                    else
                        local targetSlot = chosenEnemy.NextSlotIndex
                        pcall(function() Refs.LockOnSystem.setLockOn(chosenEnemy.Model, chosenEnemy.UnitData) end)
                        task.wait(Config.ADVANCED.ActionDelay)

                        if not cardToPlay then
                            cardToPlay = Combat.selectCardForEnemy(available, chosenEnemy, isOpposed, targetSlot)
                        end

                        if not cardToPlay or playedThisTurn[cardToPlay.AttackId] then
                            turnDone = true
                        else
                            local movementOk = true
                            if Refs.LockOnSystem and Refs.LockOnSystem.detectMovement then
                                local okDetect, resDetect = pcall(Refs.LockOnSystem.detectMovement, cardToPlay.RawData)
                                if okDetect and resDetect == false then movementOk = false end
                            end

                            if not movementOk then
                                UI.Log("WARN", string.format("Movement cannot reach %s with %s.", chosenEnemy.Name, cardToPlay.Name), "#FFD54F")
                                playedThisTurn[cardToPlay.AttackId] = true
                            else
                                timesTargeted[chosenEnemy.Id] = (timesTargeted[chosenEnemy.Id] or 0) + 1
                                local targetId = chosenEnemy.Model:GetAttribute("id") or chosenEnemy.Id
                                Refs.LocalPlayer:SetAttribute("Active", true)
                                actionsThisTurn = actionsThisTurn + 1

                                UI.Log("EXEC", string.format("Playing <font color='#B388FF'><b>%s</b></font> vs %s [Slot #%d]...",
                                    cardToPlay.Name, chosenEnemy.Name, targetSlot), "#B388FF")

                                if cardToPlay.Source == "EGO" then
                                    Refs.playEGOAttack:FireServer(cardToPlay.RawData.Name or cardToPlay.Name, cardToPlay.AttackId, targetId)
                                else
                                    Refs.playAttack:FireServer(cardToPlay.AttackId, targetId)
                                end

                                playedThisTurn[cardToPlay.AttackId] = true
                                if cardToPlay.Button then pcall(function() cardToPlay.Button:Destroy() end) end

                                local t0 = os.clock()
                                task.wait(0.15)
                                while (os.clock() - t0 < Config.ADVANCED.ClashMaxTimeout) do
                                    if not Refs.LocalPlayer:GetAttribute("Active") then break end
                                    if not Refs.LocalPlayer:GetAttribute("IsYourTurn") then break end
                                    if not Refs.CombatGui.Enabled or not Refs.HandContainer.Visible then break end
                                    if Utils.isPlayerDead() then break end
                                    task.wait(0.1)
                                end

                                Refs.LocalPlayer:SetAttribute("Active", false)
                                task.wait(Config.ADVANCED.ActionPostDelay)
                            end
                        end
                    end
                end
            end
        end
    end
    Combat.IsTurnExecuting = false
    Combat.tryEndTurn()
end

function Combat.isInActiveCombat(): boolean
    if Refs.HandContainer and Refs.HandContainer.Visible then return true end
    if Refs.DungeonGui and not Refs.DungeonGui.Enabled then return true end

    local rewardFrame = Refs.DungeonGui:FindFirstChild("RewardFrame")
    if rewardFrame and rewardFrame.Visible then return false end
    local dialogue = Refs.DungeonGui:FindFirstChild("DialogueContainer")
    if dialogue and dialogue.Visible then return false end
    local rest = Refs.DungeonGui:FindFirstChild("RestContainer") or Refs.DungeonGui:FindFirstChild("RestFrame")
    if rest and rest.Visible then return false end
    local pickBoss = Refs.DungeonGui:FindFirstChild("PickBossFrame")
    if pickBoss and pickBoss.Visible then return false end

    return false
end

