--=====================================================================
-- ACRYLIC ENGINE (DepthOfField + Viewport Projected Glass Mesh)
--=====================================================================
local AcrylicEngine = {
    Cleanups = {},
    BlurInstances = {},
    Folder = nil,
    DOF = nil,
    Enabled = ACRYLIC.BlurEnabled,
}

local function map(value, inMin, inMax, outMin, outMax)
    return (value - inMin) * (outMax - outMin) / (inMax - inMin) + outMin
end

local function viewportPointToWorld(location, distance)
    local camera = Workspace.CurrentCamera
    if not camera then return Vector3.zero end
    local unitRay = camera:ScreenPointToRay(location.X, location.Y)
    return unitRay.Origin + unitRay.Direction * distance
end

local function getOffset()
    local camera = Workspace.CurrentCamera
    local viewportSizeY = camera and camera.ViewportSize.Y or 1080
    return map(viewportSizeY, 0, 2560, 8, 56)
end

local function createAcrylicPart()
    local part = Instance.new("Part")
    part.Name = "AcrylicBody"
    part.Color = THEME.AcrylicMain
    part.Material = Enum.Material.Glass
    part.Size = Vector3.new(1, 1, 0)
    part.Anchored = true
    part.CanCollide = false
    part.Locked = true
    part.CastShadow = false
    part.Transparency = 0.98

    local mesh = Instance.new("SpecialMesh")
    mesh.MeshType = Enum.MeshType.Brick
    mesh.Offset = Vector3.new(0, 0, -0.000001)
    mesh.Parent = part

    return part
end

function AcrylicEngine.Init()
    local camera = Workspace.CurrentCamera
    if not camera then return end

    if AcrylicEngine.Folder and AcrylicEngine.Folder.Parent then
        AcrylicEngine.Folder:Destroy()
    end
    
    local folder = Instance.new("Folder")
    folder.Name = "ObsidianAcrylicBlur"
    folder.Parent = camera
    AcrylicEngine.Folder = folder

    pcall(function()
        local stale = Lighting:FindFirstChild("ObsidianAcrylicDOF")
        if stale then stale:Destroy() end
    end)

    local dof = Instance.new("DepthOfFieldEffect")
    dof.Name = "ObsidianAcrylicDOF"
    dof.FarIntensity = 0
    dof.InFocusRadius = 0.1
    dof.NearIntensity = 1
    dof.Enabled = AcrylicEngine.Enabled
    dof.Parent = Lighting
    AcrylicEngine.DOF = dof

    local camConn = Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        local newCam = Workspace.CurrentCamera
        if newCam and AcrylicEngine.Folder then
            AcrylicEngine.Folder.Parent = newCam
        end
    end)
    table.insert(AcrylicEngine.Cleanups, camConn)
end

function AcrylicEngine.SetEnabled(enabled)
    AcrylicEngine.Enabled = enabled
    if AcrylicEngine.DOF then
        AcrylicEngine.DOF.Enabled = enabled
    end
    for _, blur in ipairs(AcrylicEngine.BlurInstances) do
        if blur.SetVisibility then
            blur.SetVisibility(enabled and (blur.Frame and blur.Frame.Visible))
        end
    end
end

function AcrylicEngine.CreateBlur(targetFrame, distance)
    distance = distance or ACRYLIC.Distance
    local cleanups = {}
    local positions = {
        topLeft = Vector2.zero,
        topRight = Vector2.zero,
        bottomRight = Vector2.zero,
    }

    local model = createAcrylicPart()
    if AcrylicEngine.Folder then
        model.Parent = AcrylicEngine.Folder
    elseif Workspace.CurrentCamera then
        model.Parent = Workspace.CurrentCamera
    end

    local function updatePositions(size, position)
        positions.topLeft = position
        positions.topRight = position + Vector2.new(size.X, 0)
        positions.bottomRight = position + size
    end

    local function render()
        local camera = Workspace.CurrentCamera
        if not camera then return end
        local cframe = camera.CFrame or CFrame.new()

        local topLeft3D = viewportPointToWorld(positions.topLeft, distance)
        local topRight3D = viewportPointToWorld(positions.topRight, distance)
        local bottomRight3D = viewportPointToWorld(positions.bottomRight, distance)

        local width = (topRight3D - topLeft3D).Magnitude
        local height = (topRight3D - bottomRight3D).Magnitude

        model.CFrame = CFrame.fromMatrix((topLeft3D + bottomRight3D) / 2, cframe.XVector, cframe.YVector, cframe.ZVector)
        local mesh = model:FindFirstChildOfClass("SpecialMesh")
        if mesh then
            mesh.Scale = Vector3.new(width, height, 0)
        end
    end

    local function onChange()
        if not (targetFrame and targetFrame.Parent) then return end
        local offset = getOffset()
        local size = targetFrame.AbsoluteSize - Vector2.new(offset, offset)
        local position = targetFrame.AbsolutePosition + Vector2.new(offset / 2, offset / 2)

        updatePositions(size, position)
        task.spawn(render)
    end

    local function setupCameraListeners()
        local camera = Workspace.CurrentCamera
        if not camera then return end

        table.insert(cleanups, camera:GetPropertyChangedSignal("CFrame"):Connect(render))
        table.insert(cleanups, camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
            onChange()
            render()
        end))
        table.insert(cleanups, camera:GetPropertyChangedSignal("FieldOfView"):Connect(render))
        task.spawn(render)
    end

    table.insert(cleanups, targetFrame:GetPropertyChangedSignal("AbsolutePosition"):Connect(onChange))
    table.insert(cleanups, targetFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(onChange))

    setupCameraListeners()

    local blurObj = {
        Frame = targetFrame,
        Model = model,
        SetVisibility = function(visible)
            if model and model.Parent then
                model.Transparency = (visible and AcrylicEngine.Enabled) and 0.98 or 1
            end
        end,
        Destroy = function()
            for _, c in ipairs(cleanups) do pcall(function() c:Disconnect() end) end
            if model and model.Parent then model:Destroy() end
        end
    }

    model.Destroying:Connect(function()
        for _, c in ipairs(cleanups) do pcall(function() c:Disconnect() end) end
    end)

    targetFrame.Destroying:Connect(function()
        blurObj.Destroy()
    end)

    table.insert(AcrylicEngine.BlurInstances, blurObj)
    onChange()

    return blurObj
end

function AcrylicEngine.Destroy()
    for _, c in ipairs(AcrylicEngine.Cleanups) do pcall(function() c:Disconnect() end) end
    for _, b in ipairs(AcrylicEngine.BlurInstances) do pcall(function() b.Destroy() end) end
    table.clear(AcrylicEngine.BlurInstances)
    if AcrylicEngine.DOF then pcall(function() AcrylicEngine.DOF:Destroy() end) end
    if AcrylicEngine.Folder then pcall(function() AcrylicEngine.Folder:Destroy() end) end
end

AcrylicEngine.Init()

local function setAcrylicBlur(enabled)
    AcrylicEngine.SetEnabled(enabled)
end

