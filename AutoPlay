-- RESISTANCES, BUFFS & COMBAT DATA
-- ---------------------------------------------------------------------
local DAMAGE_TYPES = { "Slash", "Stab", "Strike" }
local DAMAGE_TYPE_ALIAS = { Slash = "Slash", Stab = "Stab", Strike = "Strike", Pierce = "Stab", Blunt = "Strike" }
local GRADES = { "Fatal", "Weak", "Normal", "Endured", "Ineffective" }
local RESIST_WORDS = {}
for _, g in ipairs(GRADES) do RESIST_WORDS[g] = true end

local ResistTable = { Fatal = 2, Weak = 1.5, Normal = 1, Endured = 0.5, Ineffective = 0.25 }
do
    local ok, mod = pcall(function() return require(Services.ReplicatedStorage.ClientModules:WaitForChild("Resistances", 3)) end)
    if ok and type(mod) == "table" then
        local valid = true
        for _, g in ipairs(GRADES) do
            local v = Utils.toNumber(mod[g])
            if v == nil or v <= 0 then valid = false break end
        end
        if valid then
            ResistTable = {}
            for _, g in ipairs(GRADES) do ResistTable[g] = Utils.toNumber(mod[g]) end
        end
    end
end

local function normalizeGrade(v)
    if type(v) == "string" then
        local g = v:gsub("%s+", "")
        if RESIST_WORDS[g] then return g end
    end
    return nil
end

function Combat.getPlayerResistances()
    if State.ResCache.Res and (os.clock() - State.ResCache.At) < Config.ADVANCED.ResistCacheTime then
        return State.ResCache.Res
    end

    local res = {
        Slash = normalizeGrade(Refs.PlayerStats.SlashPhysicalResist),
        Stab = normalizeGrade(Refs.PlayerStats.StabPhysicalResist),
        Strike = normalizeGrade(Refs.PlayerStats.StrikePhysicalResist),
    }

    if not (res.Slash and res.Stab and res.Strike) then
        local function fromLabel(labelName, key)
            if res[key] then return end
            local ok, txt = pcall(function()
                local list = Refs.CombatGui:FindFirstChild("AllyDataList")
                local cont = list and list:FindFirstChild("ResistancesContainer")
                local lbl = cont and cont:FindFirstChild(labelName)
                return lbl and lbl.Text
            end)
            if ok and type(txt) == "string" then res[key] = normalizeGrade(txt:match("^(%a+)")) end
        end
        fromLabel("SlashDefense", "Slash")
        fromLabel("StabDefense", "Stab")
        fromLabel("StrikeDefense", "Strike")
    end

    for _, t in ipairs(DAMAGE_TYPES) do if not res[t] then res[t] = "Normal" end end
    State.ResCache.Res = res
    State.ResCache.At = os.clock()
    return res
end

function Combat.getUnitModifiers(unitData)
    local m = {
        ClashPower = 0, FinalPower = 0, IntentPower = 0, DefPower = 0,
        OffenseLevel = 0, DefenseLevel = 0,
        DamageOutPct = 0, DamageInPct = 0,
        SlashInPct = 0, StabInPct = 0, StrikeInPct = 0,
        Speed = 0, Unknown = {},
    }
    local list = unitData and unitData.BuffList
    if type(list) ~= "table" or not Refs.BuffDB then return m end

    for key, rawCount in pairs(list) do
        local data = Refs.BuffDB.loadBuffData(key)
        if type(data) == "table" then
            local count = Utils.toNumber(rawCount) or 0
            local stacking = Utils.toNumber(data.StackingBuff)
            local v = stacking and math.floor(count * stacking) or count
            local fn  = Combat.BuffModifiers[data.Name]
            local kfn = Combat.BuffKeyModifiers[key]
            if fn  then fn(v, m) end
            if kfn then kfn(m) end
            if not fn and not kfn then
                table.insert(m.Unknown, string.format("%s [%s] x%d", tostring(key), tostring(data.Name), count))
            end
        end
    end
    return m
end

function Combat.getUnitResistances(unitData)
    local res = {
        Slash = normalizeGrade(unitData and unitData.SlashPhysicalResist),
        Stab = normalizeGrade(unitData and unitData.StabPhysicalResist),
        Strike = normalizeGrade(unitData and unitData.StrikePhysicalResist),
    }
    for _, t in ipairs(DAMAGE_TYPES) do if not res[t] then res[t] = "Normal" end end
    return res
end

local INTENT_DEF_WORDS = { evade = true, guard = true, defend = true, dodge = true }
local CARD_DEF_WORDS = { evade = true, dodge = true, guard = true, defend = true, shield = true, rewind = true, counter = true }

function Combat.parseCardData(rawCard, fallbackId, ownerId, slotIndex)
    if type(rawCard) ~= "table" then return nil end

    if rawCard[1] and type(rawCard[1]) == "table" and rawCard["Base Power"] == nil and rawCard.BasePower == nil and rawCard["Intent List"] == nil then
        rawCard = rawCard[1]
    end

    local id = fallbackId or rawCard.AttackId or rawCard[3]
    local name = rawCard.Name or rawCard[7] or rawCard[6] or rawCard.DisplayName or rawCard[2] or "Action"

    local intentList = rawCard["Intent List"] or rawCard.IntentList
    if type(intentList) ~= "table" then
        if type(rawCard[5]) == "table" then intentList = rawCard[5]
        elseif type(rawCard[4]) == "table" then intentList = rawCard[4] end
    end

    local basePower = Utils.toNumber(rawCard["Base Power"]) or Utils.toNumber(rawCard.BasePower)
    if basePower == nil then basePower = Utils.toNumber(rawCard[4]) or Utils.toNumber(rawCard[3]) or 0 end

    local cost = Utils.toNumber(rawCard.Cost) or Utils.toNumber(rawCard[9]) or Utils.toNumber(rawCard[8]) or 0
    local rarity = Utils.toNumber(rawCard.Rarity) or Utils.toNumber(rawCard[8]) or Utils.toNumber(rawCard[7]) or 1
    local attackWeight = Utils.toNumber(rawCard["Attack Weight"]) or Utils.toNumber(rawCard.AttackWeight) or 1

    local coins, bonusSum, isDefense, defenseKind, intentCount = {}, 0, false, nil, 0
    if type(intentList) == "table" then
        for _, intent in ipairs(intentList) do
            if type(intent) == "table" then
                local bonus = Utils.toNumber(intent["Intent Bonus"]) or 0
                local damageType, role, defKind = nil, nil, nil

                local function classify(value)
                    if type(value) ~= "string" then return end
                    if value == "Attack" then if role == nil then role = "Attack" end return end
                    if value == "Defend" then if role == nil then role = "Defend" end return end
                    local alias = DAMAGE_TYPE_ALIAS[value]
                    if alias then if damageType == nil then damageType = alias end return end
                    local lv = value:lower()
                    if INTENT_DEF_WORDS[lv] and defKind == nil then
                        defKind = (lv == "evade" or lv == "dodge") and "Evade" or "Guard"
                    end
                end

                classify(intent["Intent Type"])
                classify(intent["Intent Damage"])
                for _, v in pairs(intent) do
                    if type(v) == "string" then classify(v)
                    elseif type(v) == "number" and bonus == 0 then bonus = v end
                end

                local isDef = (defKind ~= nil) or (role == "Defend")
                local isOff = (not isDef) and (role == "Attack" or damageType ~= nil)
                intentCount = intentCount + 1
                bonusSum = bonusSum + bonus
                if isDef then
                    isDefense = true
                    if defenseKind == nil then defenseKind = defKind end
                end
                table.insert(coins, {
                    Bonus = bonus, DamageType = damageType, Role = role,
                    Kind = defKind, IsDefensive = isDef, IsOffensive = isOff,
                })
            end
        end
    end

    local offensiveCoins = 0
    for _, c in ipairs(coins) do if c.IsOffensive then offensiveCoins = offensiveCoins + 1 end end

    if not isDefense and offensiveCoins == 0 then
        local lowerName = tostring(name):lower()
        for token in lowerName:gmatch("[%a']+") do
            if CARD_DEF_WORDS[token] then
                isDefense = true
                if defenseKind == nil then
                    defenseKind = (token == "evade" or token == "dodge") and "Evade" or "Guard"
                end
                break
            end
        end
        if not isDefense and #coins == 0 then offensiveCoins = 1 end
    end

    local isPureDefense = isDefense and (offensiveCoins == 0)
    local cardUID = (ownerId and slotIndex) and string.format("%s_s%d_%s", tostring(ownerId), slotIndex, tostring(id)) or tostring(id)

    return {
        AttackId = tostring(id),
        CardUID = cardUID,
        OwnerId = ownerId,
        SlotIndex = slotIndex or 1,
        Name = tostring(name),
        BasePower = basePower,
        MaxPower = basePower + bonusSum,
        BonusSum = bonusSum,
        Cost = cost,
        Rarity = rarity,
        IntentCount = intentCount,
        IsDefenseOrEvade = isDefense,
        IsPureDefense = isPureDefense,
        DefenseKind = defenseKind,
        Coins = coins,
        OffensiveCoinCount = offensiveCoins,
        AttackWeight = attackWeight,
        RawData = rawCard,
        Button = nil,
        Source = nil,
    }
end

function Combat.getEnemyCards(unitData, ownerId)
    if type(unitData) ~= "table" or type(unitData.Hand) ~= "table" then return {} end
    local list = {}
    for k, rawCard in pairs(unitData.Hand) do
        local slotIdx = (type(k) == "number") and k or (#list + 1)
        local parsed = Combat.parseCardData(rawCard, nil, ownerId, slotIdx)
        if parsed then
            parsed.SlotIndex = slotIdx
            table.insert(list, parsed)
        end
    end
    table.sort(list, function(a, b) return (a.SlotIndex or 0) < (b.SlotIndex or 0) end)
    return list
end

function Combat.getEnemyCardAt(unitData, slotIndex, ownerId)
    local cards = Combat.getEnemyCards(unitData, ownerId)
    if #cards == 0 then return nil end
    return cards[slotIndex or 1] 
end

function Combat.getEnemyFirstCard(unitData, ownerId)
    return Combat.getEnemyCardAt(unitData, 1, ownerId)
end

function Combat.calculateEnemyIncomingDamage(targetEnemy, slotIndex): number
    if not targetEnemy or not targetEnemy.UnitData then return 0 end
    local card = Combat.getEnemyCardAt(targetEnemy.UnitData, slotIndex, targetEnemy.Id)
        or Combat.getEnemyFirstCard(targetEnemy.UnitData, targetEnemy.Id)
    if not card then return 0 end
    if (card.OffensiveCoinCount or 0) == 0 then return 0 end

    local playerRes = Combat.getPlayerResistances() or {}
    local totalDamage = 0
    for _, coin in ipairs(card.Coins or {}) do
        if coin and coin.IsOffensive then
            local coinPower = (card.BasePower or 0) + (coin.Bonus or 0)
            local mult = 1.0
            if coin.DamageType and playerRes[coin.DamageType] then
                mult = ResistTable[playerRes[coin.DamageType]] or 1.0
            end
            totalDamage = totalDamage + (coinPower * mult)
        end
    end
    if totalDamage <= 0 and (card.MaxPower or 0) > 0 then
        totalDamage = card.MaxPower
    end
    return totalDamage
end

function Combat.expectedDamageRange(card, enemyRes, opts)
    if not card then return 0, 0, 0 end
    enemyRes = enemyRes or {}
    opts = opts or {}

    local pPosture = Combat.getPlayerPosture() or 0
    local defaultHeads = math.clamp(0.50 + (pPosture / 100), 0.05, 0.95)
    local headsChance = math.clamp(tonumber(opts.headsChance) or defaultHeads, 0.05, 0.95)

    local mods = opts.mods
    local base = card.BasePower or 0
    local isStaggered = opts.isStaggered == true
    local fatalMult = ResistTable["Fatal"] or 2.0

    local function coinMult(coin)
        local mult = 1
        local dt = coin and coin.DamageType

        if isStaggered then
            mult = fatalMult
        elseif dt and enemyRes[dt] then
            mult = ResistTable[enemyRes[dt]] or 1
        end

        if mods then
            local typeInPct = (dt and mods[dt .. "InPct"]) or 0
            mult = mult * (1 + ((mods.DamageInPct or 0) + typeInPct) / 100)
        end
        return mult
    end

    local coins = (type(card.Coins) == "table") and card.Coins or {}
    if #coins > 0 then
        local minD, avgD, maxD = 0, 0, 0
        local cumAvg, cumMax = 0, 0

        for _, coin in ipairs(coins) do
            if coin and coin.IsOffensive then
                local mult = coinMult(coin)
                local rawBonus = coin.Bonus or 0

                if opts.accumulate then
                    cumAvg = cumAvg + (rawBonus * headsChance)
                    cumMax = cumMax + rawBonus
                    minD = minD + (base * mult)
                    avgD = avgD + ((base + cumAvg) * mult)
                    maxD = maxD + ((base + cumMax) * mult)
                else
                    local hitBase = base * mult
                    local heads = hitBase + rawBonus * mult
                    minD = minD + math.min(hitBase, heads)
                    maxD = maxD + math.max(hitBase, heads)
                    avgD = avgD + (hitBase + rawBonus * headsChance * mult)
                end
            end
        end
        return minD, avgD, maxD
    end

    if card.IsDefenseOrEvade then return 0, 0, 0 end
    local generic = isStaggered and fatalMult or 1
    if mods then generic = generic * (1 + (mods.DamageInPct or 0) / 100) end
    local minD = base * generic
    local maxD = (card.MaxPower or base) * generic
    return minD, (minD + maxD) / 2, maxD
end

function Combat.isEnemyStaggered(unitData, model)
    local targetModel = model or (unitData and unitData.Model)
    if not targetModel then return false end

    local staggerFrames = Refs.CombatGui:FindFirstChild("StaggerFrames")
    if staggerFrames then
        local staggerTemplate = staggerFrames:FindFirstChild("StaggerTemplate")
        if staggerTemplate and staggerTemplate:IsA("BillboardGui") and staggerTemplate.Enabled and staggerTemplate.Adornee then
            local adornee = staggerTemplate.Adornee
            if adornee == targetModel or adornee:IsDescendantOf(targetModel) then
                return true
            end
        end

        for _, frame in ipairs(staggerFrames:GetChildren()) do
            if frame:IsA("BillboardGui") and frame.Enabled and frame.Adornee then
                local adornee = frame.Adornee
                if adornee == targetModel or adornee:IsDescendantOf(targetModel) then
                    return true
                end
            end
        end
    end

    return false
end

function Combat.getPlayerPosture()
    local ok, v = pcall(function() return Refs.PlayerStats.Posture end)
    if ok and type(v) == "number" then return v end
    local ok2, txt = pcall(function()
        local ally = Refs.CombatGui:FindFirstChild("AllyDataList")
        local post = ally and ally:FindFirstChild("Posture")
        local lbl = post and post:FindFirstChild("Label")
        return lbl and lbl.Text
    end)
    if ok2 and type(txt) == "string" then return tonumber(txt) end
    return nil
end

function Combat.getEGOCards()
    local egoCards = {}
    if not (Refs.PlayerStats and type(Refs.PlayerStats.EGOHand) == "table") then return egoCards end
    for k, raw in pairs(Refs.PlayerStats.EGOHand) do
        local attackId = tostring(raw[3] or k)
        local parsed = Combat.parseCardData(raw, attackId, "Player")
        if parsed then
            parsed.Source = "EGO"
            table.insert(egoCards, parsed)
        end
    end
    return egoCards
end

function Combat.getCardsInHand()
    local cards, seen = {}, {}
    local function resolveRaw(attackId)
        local src = Refs.PlayerStats.Hand and Refs.PlayerStats.Hand[attackId]
        if src then return src, "Hand" end
        if Config.AUTO_USE_EGO then
            local ego = Refs.PlayerStats.EGOHand and Refs.PlayerStats.EGOHand[attackId]
            if ego then return ego, "EGO" end
        end
        return nil
    end

    local function scanButtons(container)
        if not container then return end
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("TextButton") then
                local attackId = child:GetAttribute("AttackId")
                if attackId and not seen[tostring(attackId)] then
                    local raw, source = resolveRaw(attackId)
                    if raw then
                        local parsed = Combat.parseCardData(raw, tostring(attackId), "Player")
                        if parsed then
                            parsed.Button = child
                            parsed.Source = source
                            seen[parsed.AttackId] = true
                            table.insert(cards, parsed)
                        end
                    end
                end
            end
        end
    end

    scanButtons(Refs.HandContainer)
    scanButtons(Refs.CombatGui:FindFirstChild("GuardCardPosition"))

    if #cards == 0 and Refs.PlayerStats and type(Refs.PlayerStats.Hand) == "table" then
        for k, raw in pairs(Refs.PlayerStats.Hand) do
            local attackId = tostring(raw[3] or k)
            if not seen[attackId] then
                local parsed = Combat.parseCardData(raw, attackId, "Player")
                if parsed then
                    parsed.Source = "Hand"
                    seen[attackId] = true
                    table.insert(cards, parsed)
                end
            end
        end
    end
    return cards
end

Combat.IsTurnExecuting = false
local LastSeenHandCounts = {}

function Combat.resetTurnHandTracking()
    table.clear(LastSeenHandCounts)
    local initialEnemies = Combat.getAliveEnemies({}, false)
    for _, e in ipairs(initialEnemies) do
        LastSeenHandCounts[e.Id] = #e.Cards
    end
end

function Combat.getAliveEnemies(timesTargetedMap, notifyDraws)
    timesTargetedMap = timesTargetedMap or {}
    if notifyDraws == nil then
        notifyDraws = Combat.IsTurnExecuting
    end

    local enemies = {}
    local seenIds, seenModels = {}, {}
    local nameCounts = {}

    local entitiesFolder = Services.Workspace:FindFirstChild("Entities")
        or Services.Workspace:FindFirstChild("BattleEntities")
        or Services.Workspace:FindFirstChild("Units")

    local function isThreatCard(card)
        return card ~= nil and (card.OffensiveCoinCount or 0) > 0
    end

    local function scoreThreatCard(card, playerRes)
        local total = 0
        for _, coin in ipairs(card.Coins or {}) do
            if coin and coin.IsOffensive then
                local power = (card.BasePower or 0) + (coin.Bonus or 0)
                local mult = 1.0
                if coin.DamageType and playerRes[coin.DamageType] then
                    mult = ResistTable[playerRes[coin.DamageType]] or 1.0
                end
                total = total + power * mult
            end
        end
        if total <= 0 and (card.MaxPower or 0) > 0 then
            total = card.MaxPower
        end
        return total
    end

    local function addEnemy(id, unitData, model, frame)
        if not id or id == "" or seenIds[id] then return end

        if not (model and model.Parent) then
            if unitData and unitData.Model and unitData.Model.Parent then
                model = unitData.Model
            elseif entitiesFolder then
                for _, child in ipairs(entitiesFolder:GetChildren()) do
                    if child:IsA("Model") and (child:GetAttribute("id") == id or child.Name == id) then
                        model = child
                        break
                    end
                end
            end
        end

        if not (model and model.Parent) or seenModels[model] then return end
        if model == Refs.LocalPlayer.Character or Services.Players:GetPlayerFromCharacter(model) then return end
        if model:GetAttribute("Untargetable") or model:GetAttribute("Dead") or model:GetAttribute("IsDead") then return end

        local hum = model:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health <= 0 then return end
        if unitData and (not unitData.Model or unitData.Model ~= model) then unitData.Model = model end

        local health = Utils.toNumber(unitData and unitData.Health) or (hum and hum.Health) or 0
        if health <= 0 and (not hum or hum.Health <= 0) then return end

        local maxHealth = Utils.toNumber(unitData and unitData.MaxHealth) or (hum and hum.MaxHealth) or health
        local tempHealth = Utils.toNumber(unitData and unitData.TempHealth) or 0
        local speed = Utils.toNumber(unitData and unitData.Speed) or 0
        local posture = Utils.toNumber(unitData and unitData.Posture) or 0

        local allCards = Combat.getEnemyCards(unitData, id)
        local handCount, handKnown = #allCards, (unitData and type(unitData.Hand) == "table")
        if not handKnown and frame then
            local holder = frame:FindFirstChild("CardsInHand")
            local label = holder and holder:FindFirstChild("Label")
            local n = label and tonumber(label.Text)
            if n then handCount, handKnown = math.max(0, n), true end
        end

        local rawName = (unitData and unitData.DisplayName) or model:GetAttribute("DisplayName") or model.Name

        if notifyDraws and LastSeenHandCounts[id] and #allCards > LastSeenHandCounts[id] then
            local drawnCount = #allCards - LastSeenHandCounts[id]
            UI.Log("DRAW", string.format("%s drew %d card(s) mid-turn (Queue: %d). Re-evaluating threats!",
                rawName, drawnCount, #allCards), "#FFD54F")
        end
        LastSeenHandCounts[id] = #allCards

        local staggered = Combat.isEnemyStaggered(unitData, model)
        local targetedCount = timesTargetedMap[id] or 0

        local nextSlotIndex = 1
        local nextCard = allCards[nextSlotIndex]

        local unaddressedThreats = 0
        local nextSlotScore = 0
        local remainingThreatScore = 0

        if not staggered then
            local playerRes = Combat.getPlayerResistances() or {}
            for idx = 1, #allCards do
                local c = allCards[idx]
                if isThreatCard(c) then
                    unaddressedThreats = unaddressedThreats + 1
                    local score = scoreThreatCard(c, playerRes)
                    remainingThreatScore = remainingThreatScore + score
                    if idx == nextSlotIndex then
                        nextSlotScore = score
                    end
                end
            end
        end

        seenIds[id] = true
        seenModels[model] = true

        nameCounts[rawName] = (nameCounts[rawName] or 0) + 1
        local shortId = tostring(id):sub(1, 6)

        table.insert(enemies, {
            Id = id,
            Name = string.format("%s #%d [%s]", rawName, nameCounts[rawName], shortId),
            DisplayName = rawName,
            UnitData = unitData,
            Model = model,
            HandCount = handCount,
            HandKnown = handKnown,
            Health = health,
            MaxHealth = maxHealth,
            TempHealth = tempHealth,
            EffectiveHP = health + tempHealth,
            Speed = speed,
            Posture = posture,
            Mods = Combat.getUnitModifiers(unitData),
            IsStaggered = staggered,
            Cards = allCards,
            TargetedCount = targetedCount,
            NextSlotIndex = nextSlotIndex,
            NextCard = nextCard,
            IsNextSlotDefensive = (nextCard ~= nil) and not isThreatCard(nextCard),
            IsNextSlotPureDefense = (nextCard and nextCard.IsPureDefense or false),
            UnaddressedThreats = unaddressedThreats,
            NextThreatScore = nextSlotScore,
            RemainingThreatScore = remainingThreatScore,
        })
    end

    for uuid, uData in pairs(Refs.CachedBattleUnits) do
        if type(uData) == "table" then
            local frame = Refs.EnemyContainer:FindFirstChild(uuid)
            addEnemy(uuid, uData, uData.Model, frame)
        end
    end

    for _, frame in ipairs(Refs.EnemyContainer:GetChildren()) do
        if frame:IsA("Frame") and frame.Name ~= "" and not seenIds[frame.Name] then
            local uData = Refs.CachedBattleUnits[frame.Name]
            addEnemy(frame.Name, uData, uData and uData.Model, frame)
        end
    end

    if entitiesFolder then
        for _, ent in ipairs(entitiesFolder:GetChildren()) do
            if ent:IsA("Model") and ent ~= Refs.LocalPlayer.Character and not Services.Players:GetPlayerFromCharacter(ent) then
                if not seenModels[ent] then
                    local matchedId = ent:GetAttribute("id")
                    local matchedUData = nil

                    if not matchedId then
                        for uuid, uData in pairs(Refs.CachedBattleUnits) do
                            if uData and uData.Model == ent then
                                matchedId = uuid
                                matchedUData = uData
                                break
                            end
                        end
                    end

                    matchedId = matchedId or ent.Name
                    matchedUData = matchedUData or Refs.CachedBattleUnits[matchedId]
                    local frame = Refs.EnemyContainer:FindFirstChild(matchedId)
                    addEnemy(matchedId, matchedUData, ent, frame)
                end
            end
        end
    end

    return enemies
end

-- =====================================================================
-- EXACT MARKOV-STATE CLASH SIMULATOR
-- =====================================================================
function Combat.simulateClashProbability(playerCard, enemyCard, pM, eM, pPosture, ePosture)
    local pHeads = math.clamp(0.50 + ((pPosture or 0) / 100), 0.05, 0.95)
    local eHeads = math.clamp(0.50 + ((ePosture or 0) / 100), 0.05, 0.95)

    pM = pM or { ClashPower = 0, FinalPower = 0, IntentPower = 0 }
    eM = eM or { ClashPower = 0, FinalPower = 0, IntentPower = 0 }

    local pBase = (playerCard.BasePower or 0) + (pM.ClashPower or 0) + (pM.FinalPower or 0)
    local eBase = (enemyCard.BasePower or 0) + (eM.ClashPower or 0) + (eM.FinalPower or 0)

    local pCoins = (type(playerCard.Coins) == "table") and playerCard.Coins or {}
    local eCoins = (type(enemyCard.Coins) == "table") and enemyCard.Coins or {}

    local pCoinCount = math.max(1, #pCoins)
    local eCoinCount = math.max(1, #eCoins)

    if #pCoins == 0 then pCoins = { { Bonus = playerCard.BonusSum or 0 } } end
    if #eCoins == 0 then eCoins = { { Bonus = enemyCard.BonusSum or 0 } } end

    local function getDistribution(baseVal, coinsList, activeCount, intentBonus, headsRate)
        local count = math.min(activeCount, #coinsList)
        local totalCombinations = 2 ^ count
        local dist = {}

        for mask = 0, totalCombinations - 1 do
            local power = baseVal
            local prob = 1.0

            for i = 1, count do
                local coin = coinsList[i]
                local bonus = (coin and coin.Bonus or 0) + intentBonus
                local isHeads = (bit32.band(mask, bit32.lshift(1, i - 1)) ~= 0)

                if isHeads then
                    power = power + bonus
                    prob = prob * headsRate
                else
                    prob = prob * (1.0 - headsRate)
                end
            end

            dist[power] = (dist[power] or 0) + prob
        end
        return dist
    end

    local function getRoundWinChance(pCount, eCount)
        local pDist = getDistribution(pBase, pCoins, pCount, pM.IntentPower or 0, pHeads)
        local eDist = getDistribution(eBase, eCoins, eCount, eM.IntentPower or 0, eHeads)

        local pWin, eWin, draw = 0, 0, 0

        for pVal, pProb in pairs(pDist) do
            for eVal, eProb in pairs(eDist) do
                local joint = pProb * eProb
                if pVal > eVal then
                    pWin = pWin + joint
                elseif eVal > pVal then
                    eWin = eWin + joint
                else
                    draw = draw + joint
                end
            end
        end

        local nonDraw = pWin + eWin
        if nonDraw <= 0.0001 then return 0.50 end
        return pWin / nonDraw
    end

    local memo = {}
    local function solve(pRem, eRem)
        if pRem <= 0 then return 0.0 end
        if eRem <= 0 then return 1.0 end

        local key = (pRem * 10) + eRem
        if memo[key] ~= nil then return memo[key] end

        local pRoundWin = getRoundWinChance(pRem, eRem)
        local winOutcome  = pRoundWin * solve(pRem, eRem - 1)
        local loseOutcome = (1.0 - pRoundWin) * solve(pRem - 1, eRem)

        local total = winOutcome + loseOutcome
        memo[key] = total
        return total
    end

    return solve(pCoinCount, eCoinCount)
end

function Combat.evaluateClash(cardObj, enemy, enemyCard)
    if not enemy or enemy.IsStaggered or (enemy.HandKnown and enemy.HandCount == 0) then
        return 5, 1000 + (cardObj.MaxPower or 0), nil, "Unopposed"
    end

    if enemyCard then
        local eM = enemy.Mods or Combat.getUnitModifiers(enemy.UnitData)
        local pM = Combat.getUnitModifiers(Refs.PlayerStats)

        local pBase = cardObj.BasePower + (pM.ClashPower or 0) + (pM.FinalPower or 0)
        local eMax = enemyCard.MaxPower + (eM.ClashPower or 0) + (eM.FinalPower or 0) + (eM.IntentPower or 0)

        if pBase > eMax then
            return 5, 1000 + (pBase - eMax), nil, "Certain Victory"
        end

        local pPosture = Combat.getPlayerPosture() or 0
        local ePosture = enemy.Posture or Utils.toNumber(enemy.UnitData and enemy.UnitData.Posture) or 0

        local winChance = Combat.simulateClashProbability(cardObj, enemyCard, pM, eM, pPosture, ePosture)
        local winPct = math.floor(winChance * 100)

        if winChance >= 0.95 then
            return 5, 900 + winPct, nil, string.format("Certain Victory (%d%%)", winPct)
        elseif winChance >= 0.75 then
            return 4, 500 + winPct, nil, string.format("Overwhelming (%d%%)", winPct)
        elseif winChance >= 0.55 then
            return 3, 200 + winPct, nil, string.format("Advantaged (%d%%)", winPct)
        elseif winChance >= 0.35 then
            return 2, 50 + winPct,  nil, string.format("Risky (%d%%)", winPct)
        else
            return 1, winPct,       nil, string.format("Desperate (%d%%)", winPct)
        end
    end

    local prediction = nil
    if enemy.Model then
        pcall(function()
            prediction = Refs.clashPredictor:InvokeServer(cardObj.BasePower, cardObj.MaxPower, cardObj.RawData, enemy.Model)
        end)
    end

    if type(prediction) == "table" then
        local pBase = Utils.toNumber(prediction.PlayerBaseValue) or cardObj.BasePower
        local eBase = Utils.toNumber(prediction.EnemyBaseValue) or 0
        local eMax = Utils.toNumber(prediction.EnemyMaxValue) or 0
        local score = Utils.toNumber(prediction.Score) or 0

        if math.max(eBase, eMax) < pBase then 
            return 5, 1000 + score, prediction, "Certain Victory"
        elseif score > Config.ADVANCED.ClashOverwhelmScore then 
            return 4, 500 + score, prediction, "Overwhelming Advantage"
        elseif score > Config.ADVANCED.ClashAdvantageScore then 
            return 3, 200 + score, prediction, "Advantaged"
        elseif score >= Config.ADVANCED.ClashRiskyScore then 
            return 2, 50 + score, prediction, "Risky"
        else 
            return 1, score, prediction, "Desperate/Hopeless" 
        end
    end

    return 3, cardObj.MaxPower, nil, "No Prediction"
end

function Combat.selectCardForEnemy(cardsInHand, targetEnemy, isOpposed, targetSlotIndex)
    if not cardsInHand or #cardsInHand == 0 or not targetEnemy then return nil end
    targetSlotIndex = targetSlotIndex or 1

    local targetCard = Combat.getEnemyCardAt(targetEnemy.UnitData, targetSlotIndex, targetEnemy.Id)
    local isTargetSlotOffensive = targetCard and ((targetCard.OffensiveCoinCount or 0) > 0) or false
    local isTargetSlotPureDefense = targetCard and (not isTargetSlotOffensive) and (targetCard.IsDefenseOrEvade or false)
    local isTargetSlotDefensive = targetCard and not isTargetSlotOffensive

    local offensives, defenses = {}, {}
    for _, card in ipairs(cardsInHand) do
        if card then
            if card.IsDefenseOrEvade then 
                table.insert(defenses, card)
            else 
                table.insert(offensives, card) 
            end
        end
    end

    table.sort(offensives, function(a, b)
        if (a.MaxPower or 0) ~= (b.MaxPower or 0) then return (a.MaxPower or 0) > (b.MaxPower or 0) end
        return (a.Cost or 0) < (b.Cost or 0)
    end)
    table.sort(defenses, function(a, b) return (a.MaxPower or 0) > (b.MaxPower or 0) end)

    local bestDefense = defenses[1]
    local bestEvade = nil
    for _, d in ipairs(defenses) do
        if d.DefenseKind == "Evade" then bestEvade = d break end
    end

    local canDefend = (#defenses > (Config.KEEP_DEFENSE_RESERVE or 0))
    local safe = canDefend and ((Config.PREFER_EVADE and (bestEvade or bestDefense)) or (bestDefense or bestEvade)) or nil

    if targetEnemy.IsStaggered or (targetCard == nil) then
        if #offensives > 0 then
            local eRes = Combat.getUnitResistances(targetEnemy.UnitData) or {}
            local chosen = offensives[1]
            local chosenDmg = -1
            local chosenMin = 0
            local chosenMax = 0

            for _, c in ipairs(offensives) do
                if c then
                    local minD, avgD, maxD = Combat.expectedDamageRange(c, eRes, {
                        isStaggered = targetEnemy.IsStaggered,
                        mods = targetEnemy.Mods,
                    })
                    if avgD > chosenDmg then 
                        chosen = c
                        chosenDmg = avgD
                        chosenMin = minD
                        chosenMax = maxD
                    end
                end
            end

            if chosen then
                UI.Log("THINK", string.format("Target %s is %s on Slot #%d. Best damage: <font color='#B388FF'>%s</font> (~%d-%d Dmg).",
                    targetEnemy.Name or "Enemy", targetEnemy.IsStaggered and "STAGGERED" or "UNOPPOSED", targetSlotIndex, chosen.Name or "Action", math.floor(chosenMin), math.floor(chosenMax)), "#B0BEC5")
                return chosen
            end
        end
        if Config.PLAY_LEFTOVER_EVADES and bestEvade then return bestEvade end
        return bestDefense
    end

    if isTargetSlotPureDefense or isTargetSlotDefensive then
        UI.Log("THINK", string.format("Target %s Slot #%d is Pure Guard (<font color='#CE93D8'>%s</font>).",
            targetEnemy.Name or "Enemy", targetSlotIndex, targetCard and targetCard.Name or "Defense"), "#90A4AE")
        
        if canDefend and (bestEvade or bestDefense) then return (bestEvade or bestDefense) end
        if #offensives > 0 then return offensives[#offensives] end
        return safe or bestDefense
    end

    local scored = {}
    for _, card in ipairs(offensives) do
        if card then
            local rank, score, _, verdict = Combat.evaluateClash(card, targetEnemy, targetCard)
            table.insert(scored, { Card = card, Rank = rank, Score = score, Verdict = verdict })
        end
    end

    table.sort(scored, function(a, b)
        if (a.Rank or 0) ~= (b.Rank or 0) then return (a.Rank or 0) > (b.Rank or 0) end
        return (a.Score or 0) > (b.Score or 0)
    end)

    local bestNormal = scored[1]
    local normalIsGood = bestNormal and bestNormal.Rank and bestNormal.Rank > (Config.DEFENSE_SWAP_MAX_RANK or 2)

    -- Dynamic E.G.O Deployment Evaluation
    if Config.AUTO_USE_EGO and (Config.EGO_MODE == "Emergency" or Config.EGO_MODE == "Always") then
        local currentPosture = Combat.getPlayerPosture() or 0
        local currentHp = Utils.toNumber(Refs.PlayerStats.Health) or 100
        local maxHp = Utils.toNumber(Refs.PlayerStats.MaxHealth) or currentHp
        local minPostureLimit = Utils.resolveThreshold(Config.EGO_MIN_POSTURE, 100, 10)

        if currentPosture >= minPostureLimit then
            local incomingDamage = Combat.calculateEnemyIncomingDamage(targetEnemy, targetSlotIndex)
            local isLethalRisk = Config.EGO_ON_LETHAL and (incomingDamage >= currentHp)
            local isThreat = (incomingDamage > 0) and Utils.isAboveThreshold(incomingDamage, maxHp, Config.EGO_MIN_THREAT)
            local isDying = Utils.isBelowThreshold(currentHp, maxHp, Config.EGO_DYING_HP)
            local normalCardsBad = not normalIsGood
            local noGuardCard = not safe

            if (isThreat or isLethalRisk or Config.EGO_MODE == "Always") and ((normalCardsBad and noGuardCard) or isDying or isLethalRisk or Config.EGO_MODE == "Always") then
                local egoCards = Combat.getEGOCards()
                local egoScored = {}

                for _, egoCard in ipairs(egoCards) do
                    if egoCard then
                        local rank, score, _, verdict = Combat.evaluateClash(egoCard, targetEnemy, targetCard)
                        table.insert(egoScored, { Card = egoCard, Rank = rank, Score = score, Verdict = verdict })
                    end
                end

                table.sort(egoScored, function(a, b)
                    if (a.Rank or 0) ~= (b.Rank or 0) then return (a.Rank or 0) > (b.Rank or 0) end
                    return (a.Score or 0) > (b.Score or 0)
                end)

                local bestEGO = egoScored[1]
                if bestEGO and bestEGO.Rank and bestEGO.Rank > (Config.DEFENSE_SWAP_MAX_RANK or 2) then
                    local threatTag = isLethalRisk and "LETHAL RISK"
                        or (isDying and string.format("DYING: %d HP", math.floor(currentHp))
                        or string.format("%d Threat Dmg", math.floor(incomingDamage)))

                    UI.Log("EGO", string.format("Threat (%s from %s Slot #%d) -> Deployed E.G.O: <font color='#FFD54F'><b>%s</b></font> [<b>%s</b>]!",
                        threatTag, targetEnemy.Name or "Enemy", targetSlotIndex, bestEGO.Card.Name or "E.G.O", tostring(bestEGO.Verdict)), "#FFD54F")
                    return bestEGO.Card
                end
            end
        end
    end

    if normalIsGood then
        UI.Log("PREDICT", string.format("Clash vs %s (Slot #%d: %s) -> <font color='#B388FF'>%s</font> [<b>%s</b>, Score: %d].",
            targetEnemy.Name or "Enemy", targetSlotIndex, targetCard and targetCard.Name or "Attack", bestNormal.Card.Name or "Action", tostring(bestNormal.Verdict), math.floor(bestNormal.Score or 0)), "#2ECC71")
        return bestNormal.Card
    end

    if bestNormal then
        UI.Log("PREDICT", string.format("Clash vs %s (Slot #%d: %s) -> <font color='#B388FF'>%s</font> [<b>%s</b>, Score: %d].",
            targetEnemy.Name or "Enemy", targetSlotIndex, targetCard and targetCard.Name or "Attack", bestNormal.Card.Name or "Action", tostring(bestNormal.Verdict), math.floor(bestNormal.Score or 0)), "#EB4D4B")

        if safe then
            UI.Log("DEFENSE", string.format("Clash unsafe vs %s. Defensive: <font color='#CE93D8'>%s</font>.", targetEnemy.Name or "Enemy", safe.Name or "Defend"), "#BA68C8")
            return safe
        end
        return bestNormal.Card
    end

    return safe or bestDefense
end

