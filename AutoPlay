    local finishGui = Refs.LocalPlayer.PlayerGui:FindFirstChild("FinishGui")
    if not (finishGui and finishGui.Enabled) then return false end
    local finishContainer = finishGui:FindFirstChild("FinishContainer")
    if not finishContainer then return false end

    local retryBtn = finishContainer:FindFirstChild("Retry")
    if retryBtn and (retryBtn:IsA("GuiButton") or retryBtn:IsA("TextButton") or retryBtn:IsA("ImageButton")) and retryBtn.Visible then
        UI.Log("RUN", "Run complete detected (FinishGui). Clicking <font color='#FFD54F'><b>Retry</b></font>...", "#FFD54F")
        Utils.fireButtonClick(retryBtn)
        task.wait(Config.ADVANCED.RetryDelay)
        return true
    end
